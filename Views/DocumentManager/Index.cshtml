@model VerificationPortal.ViewModels.DocumentManagerViewModel

@{
    // Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";
    ViewData["Title"] = "Document Manager";
}


@section Styles {
    <link rel="stylesheet" href="~/css/document-manager.css" />
}


<div class="document-manager-page">

    <!-- ============================================================
     PAGE HEADER
     ============================================================ -->

    <div class="document-manager-header">

        <!-- Page Title -->

        <div class="document-manager-header-content">

            <div class="document-manager-header-icon">
                <i class="bi bi-file-earmark-text"></i>
            </div>

            <div>

                <h1 class="document-manager-title">
                    Document Manager
                </h1>

                <p class="document-manager-subtitle">
                    Add and manage documents required for verification.
                </p>

            </div>

        </div>


        <!-- Back to Admin Dashboard -->

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-secondary document-back-btn">

            <i class="bi bi-arrow-left"></i>

            <span>Back to Admin</span>

        </a>

    </div>


    <!-- ============================================================
         ADD DOCUMENT CARD
         ============================================================ -->

    <div class="document-manager-card">

        <div class="document-manager-card-header">

            <div class="document-manager-card-title-wrapper">

                <div class="document-manager-card-title-icon">
                    <i class="bi bi-file-earmark-plus"></i>
                </div>

                <div>
                    <h5 class="document-manager-card-title">
                        Add Verification Document
                    </h5>

                    <p class="document-manager-card-description">
                        Select the faculty, tab, and section to add a document.
                    </p>
                </div>

            </div>

        </div>


        <div class="document-manager-card-body">

            <form asp-controller="DocumentManager"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()


                <div class="document-form-grid">

                    <!-- ====================================================
                         FACULTY
                         ==================================================== -->

                    <div class="document-form-group">

                        <label asp-for="FacultyId"
                               class="document-form-label">

                            Faculty
                            <span class="document-required">*</span>

                        </label>

                        <select asp-for="FacultyId"
                                id="facultyId"
                                class="form-select">

                            <option value="">
                                -- Select Faculty --
                            </option>

                            @foreach (var faculty in Model.Faculties)
                            {
                                <option value="@faculty.FacultyId">
                                    @faculty.FacultyName
                                </option>
                            }

                        </select>

                    </div>


                    <!-- ====================================================
                         TAB
                         ==================================================== -->

                    <div class="document-form-group">

                        <label asp-for="TabId"
                               class="document-form-label">

                            Tab Name
                            <span class="document-required">*</span>

                        </label>

                        <select asp-for="TabId"
                                id="tabId"
                                class="form-select"
                                disabled>

                            <option value="">
                                -- Select Tab --
                            </option>

                        </select>

                    </div>


                    <!-- ====================================================
                         SECTION
                         ==================================================== -->

                    <div class="document-form-group">

                        <label asp-for="SectionId"
                               class="document-form-label">

                            Section Name

                        </label>

                        <select asp-for="SectionId"
                                id="sectionId"
                                class="form-select"
                                disabled>

                            <option value="">
                                -- Select Section --
                            </option>

                        </select>

                    </div>


                    <!-- ====================================================
                         DOCUMENT NAME
                         ==================================================== -->

                    <div class="document-form-group full-width">

                        <label asp-for="DocumentName"
                               class="document-form-label">

                            Document Name
                            <span class="document-required">*</span>

                        </label>

                        <input asp-for="DocumentName"
                               class="form-control"
                               placeholder="Enter document name" />

                    </div>

                </div>


                <!-- ========================================================
                     FORM FOOTER
                     ======================================================== -->

                <div class="document-form-footer">

                    <!-- Mandatory Checkbox -->

                    <div class="document-mandatory-wrapper">

                        <input asp-for="IsMandatory"
                               class="document-mandatory-checkbox"
                               id="isMandatory" />

                        <label for="isMandatory"
                               class="document-mandatory-label">

                            This is a mandatory document

                        </label>

                    </div>


                    <!-- Action Buttons -->

                    <div class="document-form-actions">

                        <button type="reset"
                                class="btn btn-outline-secondary document-reset-btn">

                            <i class="bi bi-arrow-counterclockwise"></i>
                            Reset

                        </button>


                        <button type="submit"
                                class="btn btn-primary document-save-btn">

                            <i class="bi bi-save"></i>
                            Save Document

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ============================================================
         ADDED DOCUMENTS LIST
         ============================================================ -->

    <div class="document-manager-card">

        <!-- CARD HEADER -->

        <div class="document-manager-card-header">

            <div class="document-manager-card-title-wrapper">

                <div class="document-manager-card-title-icon">
                    <i class="bi bi-list-check"></i>
                </div>

                <div>
                    <h5 class="document-manager-card-title">
                        Added Documents
                    </h5>

                    <p class="document-manager-card-description">
                        List of documents configured for verification.
                    </p>
                </div>

            </div>


            <!-- Document Count -->

            <span class="document-list-count">

                @Model.Documents.Count

            </span>

        </div>


        <!-- ========================================================
             DOCUMENT TABLE
             ======================================================== -->

        <div class="document-table-wrapper">

            @if (Model.Documents.Any())
            {
                <table class="document-table">

                    <thead>

                        <tr>

                            <th class="document-sl-no">
                                #
                            </th>

                            <th>
                                Faculty
                            </th>

                            <th>
                                Tab
                            </th>

                            <th>
                                Section
                            </th>

                            <th>
                                Document Name
                            </th>

                            <th>
                                Type
                            </th>

                            <th>
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @{
                            var serialNumber = 1;
                        }

                        @foreach (var document in Model.Documents)
                        {
                            <tr>

                                <!-- Serial Number -->

                                <td class="document-sl-no">

                                    @serialNumber

                                </td>


                                <!-- Faculty -->

                                <td>

                                    @document.FacultyName

                                </td>


                                <!-- Tab -->

                                <td>

                                    @document.TabName

                                </td>


                                <!-- Section -->

                                <td>

                                    @(string.IsNullOrWhiteSpace(document.SectionName)
                                                                    ? "-"
                                                                    : document.SectionName)

                                </td>


                                <!-- Document Name -->

                                <td>

                                    <div class="document-name-wrapper">

                                        <div class="document-name-icon">
                                            <i class="bi bi-file-earmark-text"></i>
                                        </div>

                                        <span class="document-name-text">

                                            @document.DocumentName

                                        </span>

                                    </div>

                                </td>


                                <!-- Mandatory / Optional -->

                                <td>

                                    @if (document.IsMandatory)
                                    {
                                        <span class="document-status-badge mandatory">

                                            <i class="bi bi-check-circle"></i>

                                            Mandatory

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="document-status-badge optional">

                                            <i class="bi bi-info-circle"></i>

                                            Optional

                                        </span>
                                    }

                                </td>


                                <!-- Actions -->

                                <td>

                                    <div class="document-actions">

                                        <!-- Edit -->

                                        <button 
                                            type="button"
                                            data-bs-toggle="modal"
                                            data-bs-target = "#editDocumentModal"
                                            data-document-id="@document.DocumentId"
                                            data-faculty-id ="@document.FacultyId"
                                            data-tab-id = "@document.TabId"
                                            data-section-id = "@document.SectionId"
                                            data-document-name = "@document.DocumentName"
                                            data-is-mandatory = "@document.IsMandatory"
                                            
                                            class="document-action-btn edit"
                                            title="Edit Document">

                                            <i class="bi bi-pencil"></i>

                                        </button>


                                        <!-- Delete -->

                                        <form asp-controller="DocumentManager"
                                              asp-action="Delete"
                                              asp-route-id="@document.DocumentId"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="button"
                                                    class="document-action-btn delete"
                                                    title="Delete Document"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteDocumentModal"
                                                    data-document-id = "@document.DocumentId"
                                                    data-document-name = "@document.DocumentName">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                            serialNumber++;
                        }

                    </tbody>

                </table>
            }
            else
            {
                <!-- ====================================================
                     EMPTY STATE
                     ==================================================== -->

                <div class="document-empty-state">

                    <div class="document-empty-icon">

                        <i class="bi bi-file-earmark-x"></i>

                    </div>

                    <h5 class="document-empty-title">
                        No Documents Added
                    </h5>

                    <p class="document-empty-text">

                        Start by selecting a faculty, tab, and section,
                        then add the required verification document.

                    </p>

                </div>
            }

        </div>

    </div>

</div>

@* EDIT DOCUMENT MODAL  *@

<div class="modal fade" 
     id="editDocumentModal"
     tabindex="-1"
     aria-labelledby="editDocumentModalLabel"
     aria-hidden = "true"
>
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="editDocumentModalLabel">
                        <i class="bi bi-pencil-square me-2"></i>
                        Edit Document
                    </h5>
                    <small class="text-muted">
                        Update the verification document details.
                    </small>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="close">
                    </button>
                </div>

            </div>
            @* EDIT FORM  *@
            <form asp-controller="DocumentManager" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

                @* DOCUMENT ID  *@

                <input type="hidden" id="editDocumentId" name="id"/>

                <div class="modal-body">

                    <div class="document-form-grid">

                        @* FACULTY  *@
                        <div class="document-form-group">
                            <label class="document-form-label">
                                Faculty
                                <span class="document-required">*</span>
                            </label>
                            <select class="form-select" name="FacultyId" id="editFacultyId">
                                <option value="">
                                    -- SELECT FACULTY --
                                </option>

                                @foreach(var faculty in Model.Faculties)
                                {
                                    <option value="@faculty.FacultyId">
                                        @faculty.FacultyName
                                    </option>
                                }
                            </select>
                        </div>

                        @* TAB NAME SELECT  *@
                        <div class="document-form-group">
                            <label class="document-form-label">
                                Tab Name
                                <span class="document-required">*</span>
                            </label>

                            <select class="form-select" name="TabId" id="editTabId">
                                <option value="">
                                    -- SELECT TAB --
                                </option>
                            </select>
                        </div>


                        @* SECTION  *@
                        <div class="document-form-group">
                            <label class="document-form-label">
                                Section Name
                            </label>

                            <select class="form-select" name="SectionId" id="editSectionId">
                                <option value="">
                                    -- SELECT SECTION --
                                </option>
                            </select>
                        </div>

                        @* DOCUMENT NAME  *@
                        <div class="document-form-group full-width">
                            <label class="document-form-label">
                                Document Name
                                <span class="document-required">*</span>
                            </label>

                            <input type="text" name="DocumentName" id="editDocumentName" class="form-control" placeholder="Enter Document name"/>
                        </div>

                        @* MANDATORY CHECK BOX  *@
                        <div class="form-check mt-3">
                            <input type="checkbox" name="IsMandatory" value="true" class="form-check-input" id="editIsMandatory" />
                               
                            <input type="hidden" name="IsMandatory" value="false"/>

                            <label class="form-check-label" for="editIsMandatory">
                                This is a Mandatory document
                            </label>

                        </div>
                    </div>
                </div>

                @* MODEL FOOTER  *@

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>
                        Update Document
                    </button>
                </div>
            </form>
            
        </div>
    </div>
</div>



@* DELETE DOCUMENT MODAL  *@

<div class="modal fade"
    id="deleteDocumentModal"
    tabindex="-1"
    aria-labelledby="deleteDocumentModalLabel"
    aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            @* MODAL HEADER  *@

            <div class="modal-header">
                <h5 class="modal-title" id="deleteDocumentModalLabel">
                    <i class="bi bi-exclamation-triangle me-2"></i>

                    Delete Document
                </h5>

                <button type="button" class="btn btn-close" data-bs-dismiss="modal" aria-label="Close">
                </button>

            </div>

            @* DELETE FORM  *@

            <form asp-action="Delete" asp-controller="DocumentManager" method="post">
                @Html.AntiForgeryToken()

                @* SELECTED DOCUMENT ID  *@

                <input type="hidden" name="id" id="deleteDocumentId"/>

                @* MODAL BODY  *@

                <div class="modal-body">
                    <div class="delete-confirmation-content">
                        <div class="delete-confirmation-icon">
                            <i class="bi bi-trash3"></i>
                        </div>

                        <div>
                            <p class="mb-2">
                                Are you sure you want to delete this document ?
                            </p>

                            <strong id="deleteDocumentName"></strong>

                            <p class="text-muted mb-0 mt-2">
                                This Action cannot be undone.
                            </p>
                        </div>

                    </div>
                </div>


                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>

                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>

                        Yes, Delete
                    </button>
                </div>
            </form>
        </div>

    </div>

</div>

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const facultyDropdown = document.getElementById("facultyId");
            const tabDropdown = document.getElementById("tabId");
            const sectionDropdown = document.getElementById("sectionId");


            // ============================================================
            // FACULTY CHANGE
            // Load Tabs based on selected Faculty
            // ============================================================

            facultyDropdown.addEventListener("change", async function () {

                const facultyId = this.value;


                // Reset Tab dropdown
                tabDropdown.innerHTML =
                    '<option value="">-- Select Tab --</option>';


                // Reset Section dropdown
                sectionDropdown.innerHTML =
                    '<option value="">-- Select Section --</option>';


                // Disable both dropdowns initially
                tabDropdown.disabled = true;
                sectionDropdown.disabled = true;


                // Stop if no Faculty is selected
                if (!facultyId) {
                    return;
                }


                try {

                    const response = await fetch(
                        '@Url.Action("GetTabs", "DocumentManager")'
                        + '?facultyId='
                        + facultyId
                    );


                    const tabs = await response.json();


                    tabs.forEach(tab => {

                        const option = document.createElement("option");

                        option.value = tab.tabId;

                        option.textContent = tab.tabName;

                        tabDropdown.appendChild(option);

                    });


                    // Enable Tab dropdown after loading data
                    tabDropdown.disabled = false;

                }
                catch (error) {

                    console.error(
                        "Error loading tabs:",
                        error
                    );

                }

            });


            // ============================================================
            // TAB CHANGE
            // Load Sections based on selected Tab
            // ============================================================

            tabDropdown.addEventListener("change", async function () {

                const tabId = this.value;


                // Reset Section dropdown
                sectionDropdown.innerHTML =
                    '<option value="">-- Select Section --</option>';


                // Disable Section dropdown initially
                sectionDropdown.disabled = true;


                // Stop if no Tab is selected
                if (!tabId) {
                    return;
                }


                try {

                    const response = await fetch(
                        '@Url.Action("GetSections", "DocumentManager")'
                        + '?tabId='
                        + tabId
                    );


                    const sections = await response.json();


                    sections.forEach(section => {

                        const option = document.createElement("option");

                        option.value = section.sectionId;

                        option.textContent = section.sectionName;

                        sectionDropdown.appendChild(option);

                    });


                    // Enable Section dropdown
                    sectionDropdown.disabled = false;

                }
                catch (error) {

                    console.error(
                        "Error loading sections:",
                        error
                    );

                }

            });


            // ============================================================
            // RESET BUTTON
            // Reset cascading dropdown states
            // ============================================================

            document.querySelector("form")
                .addEventListener("reset", function () {

                    setTimeout(function () {

                        tabDropdown.innerHTML =
                            '<option value="">-- Select Tab --</option>';

                        sectionDropdown.innerHTML =
                            '<option value="">-- Select Section --</option>';

                        tabDropdown.disabled = true;

                        sectionDropdown.disabled = true;

                    }, 0);

                });

            // ============================================================
            // EDIT DOCUMENT MODAL 
            // ============================================================

            const editDocumentModal = document.getElementById("editDocumentModal");
            const editDocumentId = document.getElementById("editDocumentId");
            const editFacultyId = document.getElementById("editFacultyId");
            const editTabId = document.getElementById("editTabId");
            const editSectionId = document.getElementById("editSectionId");
            const editDocumentName = document.getElementById("editDocumentName");
            const editIsMandatory = document.getElementById("editIsMandatory");

            // =============================================================
            // LOAD TABS FOR EDIT MODAL 
            // =============================================================

            async function loadEditTabs(facultyId, selectedTabId = null){
                editTabId.innerHTML = `<option value=""> -- SELECT TAB -- </option>`;
                editSectionId.innerHTML = `<option value = ""> -- SELECT SECTION -- </option>`;
                if(!facultyId) return;

                const response = await fetch(`@Url.Action("GetTabs", "DocumentManager")`+`?facultyId=`+facultyId);

                const tabs = await response.json();

                tabs.forEach(tab =>{
                    const option = document.createElement("option");
                    option.value = tab.tabId;
                    option.text = tab.tabName;

                    if(selectedTabId && Number(tab.tabId) == Number(selectedTabId)) option.selected = true;

                    editTabId.appendChild(option);
                });
            }

            // =============================================================
            // LOAD SECTIONS FOR EDIT MODAL 
            // =============================================================
            async function loadEditSections(tabId, selectedSectionId = null){
                console.log(selectedSectionId);
                editSectionId.innerHTML = `<option value="">-- SELECT SECTION -- </option>`;

                if(!tabId) return;

                const response = await fetch (`@Url.Action("GetSections", "DocumentManager")`+`?tabId=`+tabId);

                const sections = await response.json();

                sections.forEach(section => {

                    const option = document.createElement("option");
                    option.value = section.sectionId;
                    option.text = section.sectionName;

                    if(selectedSectionId && Number(section.sectionId) == Number(selectedSectionId)){
                        option.selected = true;
                    }

                    editSectionId.appendChild(option);
                })
            }

            // =============================================================
            // WHEN EDIT BUTTON IS CLICKED 
            // =============================================================

            document.querySelectorAll('.document-action-btn.edit').forEach(btn =>{
                btn.addEventListener("click", async function(){
                    const documentId = this.dataset.documentId;
                    const facultyId = this.dataset.facultyId;
                    const tabId = this.dataset.tabId;
                    console.log("tabId", tabId);
                    const sectionId = this.dataset.sectionId;
                    const documentName = this.dataset.documentName;
                    const isMandatory = this.dataset.isMandatory;

                    editDocumentId.value = documentId;
                    editFacultyId.value = facultyId;
                    editSectionId.value = sectionId;
                    editDocumentName.value = documentName;
                    editIsMandatory.checked = isMandatory;
                    editTabId.value = tabId;


                    // LOAD TABS AND SELECT CURRENT TAB
                    await loadEditTabs(facultyId, tabId);


                    // LOAD SECTIONS AND SELECT CURRENT SECTIONS
                    await loadEditSections(tabId, sectionId);

                });
            });

            // FACULTY CHANGE INSIDE THE MODAL

            editFacultyId.addEventListener("change", async function(){
                await loadEditTabs(this.value);
            })

            // TAB CHANGE INSIDE THE MODAL

            editTabId.addEventListener("change", async function(){
                await loadEditSections(this.value);
            })

            // ==============================================================
            // DELETE DOCUMENT MODAL
            // ==============================================================

            const deleteDocumentId = document.getElementById("deleteDocumentId");
            const deleteDocumentName = document.getElementById("deleteDocumentName");

            // --------------------------------------------------------------
            // POPULATE DELETE CONFIRMATION MODAL
            // --------------------------------------------------------------

            document.querySelectorAll(".document-action-btn.delete")
                .forEach(btn => {
                    btn.addEventListener("click", function(){
                        deleteDocumentId.value = this.dataset.documentId;
                        deleteDocumentName.value = this.dataset.documentName;
                    })
                });


        });

    </script>

}
@using System.Security.Claims
@model VerificationPortal.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}

<!-- ==================== HERO WELCOME ==================== -->
<section class="dashboard-hero">
    <div class="container">
        <div class="hero-content-box">
            <div class="hero-info">
                <div class="hero-avatar">
                    <i class="bi bi-person-circle"></i>
                </div>
                <div class="hero-text">
                    <span class="hero-greeting">@GetGreeting(),</span>
                    <h1 class="hero-name">@Model.User.UserName</h1>
                    <div class="hero-meta">
                        <span class="meta-item">
                            <i class="bi bi-award-fill"></i>
                            @Model.User.DesignationDescription
                        </span>
                        @if (Model.Faculty != null)
                        {
                            <span class="meta-item">
                                <i class="bi bi-mortarboard-fill"></i>
                                @Model.Faculty.FacultyName
                            </span>
                        }
                    </div>
                </div>
            </div>
            <div class="hero-role-badge">
                <i class="bi bi-shield-fill-check"></i>
                <span>@Model.Role</span>
            </div>
        </div>
    </div>
</section>

<!-- ==================== STATS GRID ==================== -->
<section class="dashboard-stats-section">
    <div class="container">
        <div class="stats-grid">
            <div class="stat-card-modern stat-blue">
                <div class="stat-icon-wrap">
                    <i class="bi bi-building-fill"></i>
                </div>
                <div class="stat-info">
                    <h3>@Model.TotalAssignedColleges</h3>
                    <p>Assigned Colleges</p>
                </div>
            </div>

            <div class="stat-card-modern stat-green">
                <div class="stat-icon-wrap">
                    <i class="bi bi-patch-check-fill"></i>
                </div>
                <div class="stat-info">
                    <h3>0</h3>
                    <p>Verified</p>
                </div>
            </div>

            <div class="stat-card-modern stat-orange">
                <div class="stat-icon-wrap">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div class="stat-info">
                    <h3>0</h3>
                    <p>Pending</p>
                </div>
            </div>

            <div class="stat-card-modern stat-purple">
                <div class="stat-icon-wrap">
                    <i class="bi bi-calendar-event-fill"></i>
                </div>
                <div class="stat-info">
                    <h3>@DateTime.Now.ToString("dd")</h3>
                    <p>@DateTime.Now.ToString("MMM yyyy")</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==================== MAIN CONTENT (TWO EQUAL SECTIONS) ==================== -->
<section class="dashboard-main">
    <div class="container">
        <div class="row g-4">
            <!-- Quick Actions - Left -->
            <div class="col-lg-6">
                <div class="content-card">
                    <div class="content-card-header">
                        <div>
                            <h5>Quick Actions</h5>
                            <small>Access your most-used tools</small>
                        </div>
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>
                    <div class="content-card-body">
                        <div class="actions-grid">
                            @if (Model.IsAdmin)
                            {
                                <a href="#" class="action-tile action-admin">
                                    <div class="action-tile-icon"><i class="bi bi-people-fill"></i></div>
                                    <div class="action-tile-text">
                                        <strong>Manage Users</strong>
                                        <small>Add, edit, or remove users</small>
                                    </div>
                                    <i class="bi bi-arrow-right action-tile-arrow"></i>
                                </a>
                                <a asp-controller="CollegeMapping" asp-action="Index" class="action-tile action-admin">
                                    <div class="action-tile-icon"><i class="bi bi-building-add"></i></div>
                                    <div class="action-tile-text">
                                        <strong>Assign Colleges</strong>
                                        <small>Map colleges to users</small>
                                    </div>
                                    <i class="bi bi-arrow-right action-tile-arrow"></i>
                                </a>
                            }
                            <a href="#" class="action-tile">
                                <div class="action-tile-icon"><i class="bi bi-search"></i></div>
                                <div class="action-tile-text">
                                    <strong>Search Colleges</strong>
                                    <small>Find any college quickly</small>
                                </div>
                                <i class="bi bi-arrow-right action-tile-arrow"></i>
                            </a>
                            <a href="#" class="action-tile">
                                <div class="action-tile-icon"><i class="bi bi-file-earmark-bar-graph"></i></div>
                                <div class="action-tile-text">
                                    <strong>View Reports</strong>
                                    <small>Analytics & insights</small>
                                </div>
                                <i class="bi bi-arrow-right action-tile-arrow"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Resources - Right -->
            <div class="col-lg-6">
                <div class="content-card">
                    <div class="content-card-header">
                        <div>
                            <h5>Resources</h5>
                            <small>Helpful documents & links</small>
                        </div>
                        <i class="bi bi-folder-fill"></i>
                    </div>
                    <div class="content-card-body p-0">
                        <div class="resource-list">
                            <a href="#" class="resource-item">
                                <div class="resource-icon">
                                    <i class="bi bi-file-earmark-text"></i>
                                </div>
                                <div class="resource-text">
                                    <strong>User Manual</strong>
                                    <small>Complete guide for using the portal</small>
                                </div>
                                <i class="bi bi-chevron-right"></i>
                            </a>
                            <a href="#" class="resource-item">
                                <div class="resource-icon">
                                    <i class="bi bi-file-earmark-pdf"></i>
                                </div>
                                <div class="resource-text">
                                    <strong>Guidelines 2024-25</strong>
                                    <small>Latest affiliation guidelines</small>
                                </div>
                                <i class="bi bi-chevron-right"></i>
                            </a>
                            <a href="#" class="resource-item">
                                <div class="resource-icon">
                                    <i class="bi bi-file-earmark-spreadsheet"></i>
                                </div>
                                <div class="resource-text">
                                    <strong>Data Templates</strong>
                                    <small>Download submission formats</small>
                                </div>
                                <i class="bi bi-chevron-right"></i>
                            </a>
                            <a href="#" class="resource-item">
                                <div class="resource-icon">
                                    <i class="bi bi-question-circle"></i>
                                </div>
                                <div class="resource-text">
                                    <strong>FAQs</strong>
                                    <small>Frequently asked questions</small>
                                </div>
                                <i class="bi bi-chevron-right"></i>
                            </a>
                            <a href="#" class="resource-item">
                                <div class="resource-icon">
                                    <i class="bi bi-headset"></i>
                                </div>
                                <div class="resource-text">
                                    <strong>Contact Support</strong>
                                    <small>Get help from our team</small>
                                </div>
                                <i class="bi bi-chevron-right"></i>
                            </a>
                            <a href="#" class="resource-item">
                                <div class="resource-icon">
                                    <i class="bi bi-megaphone"></i>
                                </div>
                                <div class="resource-text">
                                    <strong>Announcements</strong>
                                    <small>Latest updates & circulars</small>
                                </div>
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@functions {
    public string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        if (hour < 12) return "Good Morning";
        if (hour < 17) return "Good Afternoon";
        return "Good Evening";
    }
}

@* @using System.Security.Claims *@
@model VerificationPortal.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}

<!-- ==================== HERO WELCOME ==================== -->
<section class="dashboard-hero">
    <div class="container">
        <div class="hero-content-box">
            <div class="hero-info">
                <div class="hero-avatar">
                    <i class="bi bi-person-circle"></i>
                </div>
                <div class="hero-text">
                    <span class="hero-greeting">@Model.Greeting,</span>
                    <h1 class="hero-name">@Model.User.UserName</h1>
                    <div class="hero-meta">
                        <span class="meta-item">
                            <i class="bi bi-award-fill"></i>
                            @Model.User.DesignationDescription
                        </span>
                        @if (Model.Faculty != null)
                        {
                            <span class="meta-item">
                                <i class="bi bi-mortarboard-fill"></i>
                                @Model.Faculty.FacultyName
                            </span>
                        }
                    </div>
                </div>
            </div>
            <div class="hero-role-badge">
                <i class="bi bi-shield-fill-check"></i>
                <span>@Model.Role</span>
            </div>
        </div>
    </div>
</section>

<!-- ==================== STATS GRID ==================== -->
<section class="dashboard-stats-section">
    <div class="container">
        <div class="stats-grid">
            <div class="stat-card-modern stat-blue">
                <div class="stat-icon-wrap">
                    <i class="bi bi-building-fill"></i>
                </div>
                <div class="stat-info">
                    <h3>@Model.TotalAssignedColleges</h3>
                    <p>Assigned Colleges</p>
                </div>
            </div>

            <div class="stat-card-modern stat-green">
                <div class="stat-icon-wrap">
                    <i class="bi bi-patch-check-fill"></i>
                </div>
                <div class="stat-info">
                    <h3>@Model.TotalVerified</h3>
                    <p>Verified</p>
                </div>
            </div>

            <div class="stat-card-modern stat-orange">
                <div class="stat-icon-wrap">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div class="stat-info">
                    <h3>@Model.TotalPending</h3>
                    <p>Pending</p>
                </div>
            </div>

            <div class="stat-card-modern stat-purple">
                <div class="stat-icon-wrap">
                    <i class="bi bi-calendar-event-fill"></i>
                </div>
                <div class="stat-info">
                    <h3>@Model.CurrentDate.ToString("dd")</h3>
                    <p>@Model.CurrentDate.ToString("MMM yyyy")</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==================== MAIN CONTENT (TWO EQUAL SECTIONS - QUICK ACTIONS AND RESOURCES) ==================== -->

<!-- ==================== DASHBOARD ACTIONS ==================== -->
<section class="dashboard-actions-section">
    <div class="container">
        <div class="row g-4">

            <!-- My Colleges -->
            <div class="col-lg-6">
                <a asp-controller="MyColleges"
                   asp-action="Index"
                   class="dashboard-action-card">

                    <div class="dashboard-action-icon">
                        <i class="bi bi-building"></i>
                    </div>

                    <div class="dashboard-action-content">
                        <h5>My Colleges</h5>
                        <p>View and manage colleges assigned to you.</p>
                    </div>

                    <div class="dashboard-action-arrow">
                        <i class="bi bi-arrow-right"></i>
                    </div>

                </a>
            </div>

            <!-- Type of Affiliation -->
            <div class="col-lg-6">
                <button type="button"
                        class="dashboard-action-card affiliation-selector-link w-100 border-0 text-start"
                        id="openAffiliationSelector">

                    <div class="dashboard-action-icon">
                        <i class="bi bi-layers-fill"></i>
                    </div>

                    <div class="dashboard-action-content">
                        <h5>Type of Affiliation & Course Level</h5>
                        <p>Select the affiliation type and course level to continue.</p>
                    </div>

                    <div class="dashboard-action-arrow">
                        <i class="bi bi-arrow-right"></i>
                    </div>

                </button>
            </div>

        </div>
    </div>
</section>
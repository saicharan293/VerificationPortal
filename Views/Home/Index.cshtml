<!-- ==================== VERIFICATION PROCESS ==================== -->
<section id="process" class="process-section">
    <div class="container">
        <div class="section-header text-center" data-aos="fade-up">
            <span class="section-subtitle">How It Works</span>
            <h2 class="section-title">Verification Process</h2>
            <p class="section-description">
                Data submitted by colleges goes through a hierarchical verification workflow
            </p>
        </div>

        <div class="process-flow mt-5">
            <div class="process-step" data-aos="fade-up">
                <div class="step-circle">1</div>
                <div class="step-content">
                    <h6>Data Entry (DEO)</h6>
                    <p>Data Entry Operator submits affiliation data</p>
                </div>
            </div>
            <div class="process-arrow"><i class="bi bi-chevron-right"></i></div>

            <div class="process-step" data-aos="fade-up" data-aos-delay="100">
                <div class="step-circle">2</div>
                <div class="step-content">
                    <h6>Junior Review (JR)</h6>
                    <p>Junior Assistant validates submitted data</p>
                </div>
            </div>
            <div class="process-arrow"><i class="bi bi-chevron-right"></i></div>

            <div class="process-step" data-aos="fade-up" data-aos-delay="200">
                <div class="step-circle">3</div>
                <div class="step-content">
                    <h6>Section Processing (SO)</h6>
                    <p>Section Officer processes the application</p>
                </div>
            </div>
            <div class="process-arrow"><i class="bi bi-chevron-right"></i></div>

            <div class="process-step" data-aos="fade-up" data-aos-delay="300">
                <div class="step-circle">4</div>
                <div class="step-content">
                    <h6>Assistant Verification (AR)</h6>
                    <p>Assistant Registrar conducts verification</p>
                </div>
            </div>
            <div class="process-arrow"><i class="bi bi-chevron-right"></i></div>

            <div class="process-step" data-aos="fade-up" data-aos-delay="400">
                <div class="step-circle">5</div>
                <div class="step-content">
                    <h6>Registrar Approval (RG/RE)</h6>
                    <p>Registrar provides final approval</p>
                </div>
            </div>
            <div class="process-arrow"><i class="bi bi-chevron-right"></i></div>

            <div class="process-step" data-aos="fade-up" data-aos-delay="500">
                <div class="step-circle">6</div>
                <div class="step-content">
                    <h6>Final Sign-off (DR/VC)</h6>
                    <p>Director / Vice Chancellor final approval</p>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- ==================== NOTICES ==================== -->
<section id="notifications" class="notices-section">
    <div class="container">
        <div class="section-header text-center" data-aos="fade-up">
            <span class="section-subtitle">Latest Updates</span>
            <h2 class="section-title">Notices & Circulars</h2>
        </div>

        <div class="row mt-4">
            <div class="col-lg-8">
                <div class="notices-list">
                    @foreach (var notif in Model.Notifications)
                    {
                        <a href="#" class="notice-item">
                            <div class="notice-date">
                                <span class="notice-day">@notif.Date.Day</span>
                                <span class="notice-month">@notif.Date.ToString("MMM")</span>
                            </div>
                            <div class="notice-content">
                                <span class="notice-type type-@notif.Type.ToLower()">@notif.Type</span>
                                <h6>@notif.Title</h6>
                                <small><i class="bi bi-clock"></i> Posted on @notif.Date.ToString("dd MMMM yyyy")</small>
                            </div>
                            <i class="bi bi-chevron-right notice-arrow"></i>
                        </a>
                    }
                </div>
                <div class="text-center mt-4">
                    <a href="#" class="btn btn-outline-primary">
                        View All Notices <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="sidebar-card">
                    <h5><i class="bi bi-megaphone-fill"></i> Important</h5>
                    <ul class="quick-links">
                        <li><a href="#"><i class="bi bi-file-earmark-text"></i> Affiliation Guidelines 2024-25</a></li>
                        <li><a href="#"><i class="bi bi-file-earmark-pdf"></i> Required Documents List</a></li>
                        <li><a href="#"><i class="bi bi-file-earmark-spreadsheet"></i> Data Submission Format</a></li>
                        <li><a href="#"><i class="bi bi-file-earmark-zip"></i> Download Templates</a></li>
                        <li><a href="#"><i class="bi bi-question-circle"></i> Frequently Asked Questions</a></li>
                    </ul>
                </div>

                <div class="sidebar-card mt-4">
                    <h5><i class="bi bi-telephone-fill"></i> Helpline</h5>
                    <div class="helpline-info">
                        <p><strong>For Colleges:</strong></p>
                        <p><i class="bi bi-telephone"></i> 080-XXXXXXX</p>
                        <p><i class="bi bi-envelope"></i> colleges@kaheportal.gov.in</p>
                        <hr />
                        <p><strong>For Public/Students:</strong></p>
                        <p><i class="bi bi-telephone"></i> 080-YYYYYYY</p>
                        <p><i class="bi bi-envelope"></i> public@kaheportal.gov.in</p>

@* Authenticated User Navigation *@

<style>
    .affiliation-selector-link {
        background: none;
        border: none;
        padding: var(--bs-nav-link-padding-y) var(--bs-nav-link-padding-x);
    }

    .auth-navbar .navbar-toggler {
        border: 1px solid var(--border-color, rgba(255,255,255,0.3));
        padding: 0.45rem 0.65rem;
    }

    .auth-navbar .navbar-toggler:focus {
        box-shadow: none;
    }

    .auth-navbar .navbar-toggler-icon {
        filter: var(--navbar-toggler-filter, none);
    }

    @@media (max-width: 991.98px) {

        .auth-navbar .navbar-collapse {
            padding: 0.75rem 0;
        }

        .auth-navbar .navbar-nav {
            align-items: stretch !important;
            gap: 0.25rem !important;
        }

        .auth-navbar .nav-link,
        .auth-navbar .affiliation-selector-link {
            width: 100%;
            text-align: left;
            padding: 0.7rem 0.9rem;
        }

        .auth-navbar .navbar-nav .nav-item {
            width: 100%;
        }

    }
</style>

<nav class="navbar navbar-expand-lg sticky-top auth-navbar">

    <div class="container-fluid">

        <!-- Mobile Toggle -->
        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#authNavbar"
                aria-controls="authNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>

        </button>

        <!-- Navigation -->
        <div class="collapse navbar-collapse" id="authNavbar">

            <ul class="navbar-nav me-auto align-items-lg-center gap-1">

                <!-- Dashboard -->
                <li class="nav-item">

                    <a class="nav-link"
                       asp-controller="Dashboard"
                       asp-action="Index">

                        <i class="bi bi-speedometer2 me-1"></i>
                        Dashboard

                    </a>

                </li>

                <!-- Admin -->
                @if (User.IsInRole("Admin") ||
                     User.IsInRole("ViceChancellor") ||
                     User.IsInRole("Director"))
                {
                    <partial name="_AdminMenu" />
                }

                <!-- My Colleges -->
                <li class="nav-item">

                    <a class="nav-link"
                       asp-controller="MyColleges"
                       asp-action="Index">

                        <i class="bi bi-building me-1"></i>
                        My Colleges

                    </a>

                </li>

                <!-- Affiliation Selector -->
                <li class="nav-item">

                    <button type="button"
                            class="nav-link affiliation-selector-link"
                            id="openAffiliationSelector">

                        <i class="bi bi-layers-fill me-1"></i>
                        Type of Affiliation and Course Level

                    </button>

                </li>

            </ul>

        </div>

    </div>

</nav>
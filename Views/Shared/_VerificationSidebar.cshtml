@* Sidebar partial for Verification Dashboard *@
@{
    var activeTab = ViewData["ActiveTab"]?.ToString() ?? "";
    var collegeCode = ViewData["CollegeCode"]?.ToString() ?? "";
    var institutionName = ViewData["InstitutionName"]?.ToString() ?? "Unknown Institution";
    var facultyName = ViewData["FacultyName"]?.ToString() ?? "";
    var verificationStatus = ViewData["VerificationStatus"]?.ToString();
    var statusBadgeClass = ViewData["StatusBadgeClass"]?.ToString();
    var existingCourseLevel = Context.Session.GetString("CourseLevel");
}

<aside class="verification-sidebar" id="verificationSidebar" role="navigation" aria-label="Verification sections">
    @* <div class="sidebar-header">
        <div class="sidebar-brand">
            <i class="bi bi-shield-check"></i>
            <span>Verification Portal</span>
        </div>
        <button class="sidebar-close d-md-none" id="sidebarClose" aria-label="Close sidebar">
            <i class="bi bi-x"></i>
        </button>
    </div> *@
    <div class="sidebar-back">
        <a asp-controller="MyColleges"
           asp-action="Index"
           class="sidebar-back-link">

            <i class="bi bi-arrow-left"></i>

            <span>Back to My Colleges</span>
        </a>
    </div>
    <div class="sidebar-content">
        <!-- Institution Info Card -->
        <div class="institution-info-card">
            <div class="institution-name">@institutionName</div>
            <div class="institution-code">Code: @collegeCode</div>
            @if (!string.IsNullOrEmpty(facultyName))
            {
                <div class="institution-faculty">@facultyName</div>
            }
            @if (!string.IsNullOrEmpty(verificationStatus))
            {
                <span class="status-badge @statusBadgeClass">@verificationStatus</span>
            }
        </div>

        <!-- Navigation Tabs -->
        <nav class="sidebar-nav" aria-label="Verification sections">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "InstitutionDetails" ? "active" : "")"
                       asp-controller="VerificationDashboard" asp-action="InstitutionDetails" asp-route-collegeCode="@collegeCode">
                        <i class="bi bi-building"></i>
                        <span>Institution Details</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "TrustDetails" ? "active" : "")"
                       asp-controller="VerificationDashboard" asp-action="TrustDetails" asp-route-collegeCode="@collegeCode">
                        <i class="bi bi-building"></i>
                        <span>Trust Details</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "TrustMemberDetails" ? "active" : "")"
                       asp-controller="VerificationDashboard" asp-action="TrustMemberDetails" asp-route-collegeCode="@collegeCode">
                        <i class="bi bi-people"></i>
                        <span>Trust Member Details</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "DeanDirectorDetails" ? "active" : "")"
                       asp-controller="VerificationDashboard" asp-action="DeanDirectorDetails" asp-route-collegeCode="@collegeCode">
                        <i class="bi bi-person-badge"></i>
                        <span>Dean / Director Details</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "PrincipalDetails" ? "active" : "")"
                       asp-controller="VerificationDashboard" asp-action="PrincipalDetails" asp-route-collegeCode="@collegeCode">
                        <i class="bi bi-mortarboard"></i>
                        <span>Principal Details</span>
                    </a>
                </li>
                @if(existingCourseLevel == "UG")
                {
                    <li class="nav-item">
                        <a class="nav-link @(activeTab == "UGCourseDetails" ? "active" : "")"
                           asp-controller="VerificationDashboard" asp-action="UGCourseDetails" asp-route-collegeCode="@collegeCode">
                            <i class="bi bi-mortarboard"></i>
                            <span>Ug Course Details</span>
                        </a>
                    </li>
                }
                else if(existingCourseLevel == "PG")
                {
                    <li class="nav-item">
                        <a class="nav-link @(activeTab == "PgCourseDetails" ? "active" : "")"
                           asp-controller="VerificationDashboard" asp-action="PgCourseDetails" asp-route-collegeCode="@collegeCode">
                            <i class="bi bi-mortarboard"></i>
                            <span>Pg Course Details</span>
                        </a>
                    </li>
                }
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "Courses" ? "active" : "")"
                       asp-controller="VerificationDashboard" asp-action="Courses" asp-route-collegeCode="@collegeCode">
                        <i class="bi bi-book"></i>
                        <span>Courses & Intake</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "LandAndBuildingDetails" ? "active" : "")"
                       asp-controller="VerificationDashboard"
                       asp-action="LandAndBuildingDetails"
                       asp-route-collegeCode="@collegeCode">
                        <i class="bi bi-building"></i>
                        <span>Land & Building Details</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(activeTab == "ClassroomAndLaboratory" ? "active" : "")"
                       asp-controller="VerificationDashboard"
                       asp-action="ClassroomAndLaboratory"
                       asp-route-collegeCode="@collegeCode">
                        <i class="bi bi-houses"></i>
                        <span>Classroom & Laboratory</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="VerificationDashboard"
                       asp-action="ChairDistribution"
                       asp-route-collegeCode="@collegeCode"
                       class="nav-link @(activeTab == "ChairDistribution" ? "active" : "")">

                        <i class="bi bi-grid-3x3-gap"></i>
                        <span>Chair Distribution</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="VerificationDashboard"
                       asp-action="BedDistribution"
                       asp-route-collegeCode="@collegeCode"
                       class="nav-link @(activeTab == "BedDistribution" ? "active" : "")">

                        <i class="bi bi-hospital"></i>

                        <span>Bed Distribution</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="VerificationDashboard"
                       asp-action="HostelDetails"
                       asp-route-collegeCode="@collegeCode"
                       class="nav-link @(activeTab == "HostelDetails" ? "active" : "")">
                        <i class="bi bi-house-door"></i>
                        <span>Hostel Details</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="VerificationDashboard"
                       asp-action="DepartmentOfficesAndEducationalUnit"
                       asp-route-collegeCode="@collegeCode"
                       class="nav-link @(activeTab == "DepartmentOfficesAndEducationalUnit" ? "active" : "")">
                        <i class="bi bi-building"></i>
                        <span>Department Offices And Educational Unit</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="VerificationDashboard"
                       asp-action="EquipmentList"
                       asp-route-collegeCode="@collegeCode"
                       class="nav-link @(activeTab == "EquipmentList" ? "active" : "")">

                        <i class="bi bi-tools"></i>
                        <span>Equipment List</span>

                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="VerificationDashboard"
                       asp-action="WorkShopDetails"
                       asp-route-collegeCode="@collegeCode"
                       class="nav-link @(activeTab == "WorkShopDetails" ? "active" : "")">

                        <i class="bi bi-building-gear"></i>
                        <span>Workshop Details</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="VerificationDashboard"
                       asp-action="AnimalHouseDetails"
                       asp-route-collegeCode="@collegeCode"
                       class="nav-link @(activeTab == "AnimalHouseDetails" ? "active" : "")">

                        <i class="bi bi-house-heart"></i>
                        <span>Animal House Details</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="VerificationDashboard"
                       asp-action="DentalFieldPracticeArea"
                       asp-route-collegeCode="@collegeCode"
                       class="nav-link @(activeTab == "DentalFieldPracticeArea" ? "active" : "")">

                        <i class="bi bi-geo-alt"></i>
                        <span>Dental Field Practice Area</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="VerificationDashboard"
                       asp-action="CA_VehicleDetails"
                       asp-route-collegeCode="@collegeCode"
                       class="nav-link @(activeTab == "CAVehicleDetails" ? "active" : "")">

                        <i class="bi bi-car-front"></i>
                        <span>Vehicle Details</span>
                    </a>
                </li>
                @if (existingCourseLevel == "UG")
                {
                    <li class="nav-item">
                        <a asp-controller="VerificationDashboard"
                        asp-action="UgAcademicMatters"
                        asp-route-collegeCode="@collegeCode"
                        class="nav-link @(activeTab == "UgAcademicMatters" ? "active" : "")">

                            <i class="bi bi-mortarboard"></i>

                            <span>UG Academic Matters</span>
                        </a>
                    </li>
                }

                @if (existingCourseLevel == "PG")
                {
                    <li class="nav-item">
                        <a asp-controller="VerificationDashboard"
                        asp-action="PgAcademicMatters"
                        asp-route-collegeCode="@collegeCode"
                        class="nav-link @(activeTab == "PgAcademicMatters" ? "active" : "")">

                            <i class="bi bi-mortarboard"></i>
                            <span>PG Academic Matters</span>
                        </a>
                    </li>
                }
                <li class="nav-item">
                    <a href="@Url.Action("StaffPayScale", "VerificationDashboard", new { collegeCode = collegeCode })"
                       class="nav-link @(activeTab == "StaffPayScale" ? "active" : "")">

                        <i class="bi bi-cash-stack me-2"></i>
                        <span> Staff Pay Scale </span>

                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("StaffOtherDetails", "VerificationDashboard", new { collegeCode = collegeCode })"
                       class="nav-link @(activeTab == "StaffOtherDetails" ? "active" : "")">

                        <i class="bi bi-people me-2"></i>
                        <span> Staff Other Details </span>

                    </a>

                </li>
                <li class="nav-item">
                    <a href="@Url.Action( "FinanceDetails", "VerificationDashboard", new { collegeCode = collegeCode })"
                       class="nav-link @(activeTab == "FinanceDetails" ? "active" : "")">

                        <i class="bi bi-cash-stack"></i>
                        <span>Finance Details</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("LibraryServices", "VerificationDashboard", new { collegeCode = collegeCode })"
                       class="nav-link @(activeTab == "LibraryServices" ? "active" : "")">

                        <i class="bi bi-book"></i>
                        <span>Library Services</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="@Url.Action("ResearchPublications", "VerificationDashboard", new { collegeCode = collegeCode })"
                       class="nav-link @(activeTab == "ResearchPublications" ? "active" : "")">

                        <i class="bi bi-journal-text"></i>
                        <span>Research &amp; Publications</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("LibraryDetails", "VerificationDashboard", new { collegeCode = collegeCode })"
                       class="nav-link @(activeTab == "LibraryDetails" ? "active" : "")">

                        <i class="bi bi-book-half"></i>
                        <span>Library Details</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("LibraryExpenditure", "VerificationDashboard", new { collegeCode = collegeCode })"
                       class="nav-link @(activeTab == "LibraryExpenditure" ? "active" : "")">

                        <i class="bi bi-cash-coin"></i>
                        <span>Library Expenditure</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("FacultyDetails", "VerificationDashboard", new { collegeCode = collegeCode })"
                       class="nav-link @(activeTab == "FacultyDetails" ? "active" : "")">

                        <i class="bi bi-person-badge"></i>
                        <span>Faculty Details</span>

                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "TeachingExperience" ? "active" : "")"
                       asp-controller="VerificationDashboard"
                       asp-action="TeachingExperience"
                       asp-route-collegeCode="@collegeCode">

                        <i class="bi bi-clock-history me-2"></i>

                        <span>Teaching Experience</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "ClinicalFacilities" ? "active" : "")"
                       asp-controller="VerificationDashboard"
                       asp-action="ClinicalFacilities"
                       asp-route-collegeCode="@collegeCode">

                        <i class="bi bi-hospital me-2"></i>

                        <span>Clinical Facilities</span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</aside>

<!-- Sidebar Overlay for Mobile -->
<div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>


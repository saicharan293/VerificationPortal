<div class="modal fade"
     id="globalDocumentViewerModal"
     tabindex="-1"
     aria-labelledby="globalDocumentViewerTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered">

        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header">

                <h5 class="modal-title"
                    id="globalDocumentViewerTitle">

                    <i class="bi bi-file-earmark-text me-2"></i>
                    Document Viewer

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <!-- Body -->
            <div class="modal-body p-0"
                 style="height:75vh;">

                <div id="documentViewerLoading"
                     class="d-flex justify-content-center align-items-center h-100">

                    <div class="text-center">

                        <div class="spinner-border"
                             role="status">
                        </div>

                        <div class="mt-3">
                            Loading document...
                        </div>

                    </div>

                </div>

                <iframe id="globalDocumentViewerFrame"
                        title="Document Viewer"
                        style="
                    display:none;
                    width:100%;
                    height:100%;
                    border:0;
                    ">
                </iframe>

                <div id="globalDocumentViewerImageContainer"
                     class="d-none h-100 justify-content-center align-items-center">

                    <img id="globalDocumentViewerImage"
                         style="
                    max-width:100%;
                    max-height:100%;
                    object-fit:contain;
                    " />

                </div>

                <div id="globalDocumentViewerUnsupported"
                     class="d-none h-100 justify-content-center align-items-center">

                    <div class="text-center">

                        <i class="bi bi-file-earmark-x display-4"></i>

                        <h5 class="mt-3">
                            Preview not available
                        </h5>

                        <a id="globalDocumentViewerDownload"
                           href="#"
                           target="_blank"
                           class="btn btn-primary">

                            Open Document

                        </a>

                    </div>

                </div>

            </div>

            <!-- Footer -->
            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    <i class="bi bi-x-lg me-1"></i>
                    Close

                </button>

            </div>

        </div>

    </div>

</div>
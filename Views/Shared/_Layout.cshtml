@*
    Master Layout for Karnataka Affiliation Verification Portal
    - Handles both authenticated and unauthenticated states
    - Includes theme toggle and responsive navigation
*@

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Official Government of Karnataka portal for college affiliation data verification" />
    <meta name="theme-color" content="#1e40af" />
    <title>@ViewData["Title"] - Karnataka Affiliation Verification Portal</title>

    <script>
            (function() {
                const savedTheme =
                    localStorage.getItem('verification-portal-theme') || 'light';

                document.documentElement.setAttribute(
                    'data-theme',
                    savedTheme
                );
            })();
    </script>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Noto+Sans+Kannada:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- AOS Animation Library -->
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />

    <!-- Application Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout-header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/page-loader.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <header class="modern-header" role="banner">

        <div class="modern-header-inner">

            <!-- Brand -->
            <div class="brand-block">

                <img src="~/images/newLogo.jpeg"
                     id="signupLogo"
                     alt="University Logo" />

                <div>
                    <div class="brand-title">
                        @Localizer["UniversityTitle"]
                    </div>

                    <div class="brand-subtitle">
                        @Localizer["UniversityAddress"]
                    </div>
                </div>

            </div>

            <!-- Center -->
            <div class="header-center">

                <div class="page-title">
                    @(Context.Session.GetString("CollegeName") ?? "")
                </div>

                @* <span class="page-tab-name">
                    @ViewData["Title"]
                </span> *@

                @if(!String.IsNullOrEmpty(Context.Session.GetString("TypeOfAffiliation"))){
                    <div class="page-subtitle">
                        @(Context.Session.GetString("TypeOfAffiliation") ?? "Not available")
                    </div>
                }

            </div>

            <!-- Actions -->
            <div class="header-actions">

                <!-- Language -->
                <div class="language-switcher">

                    <select id="languageSelect"
                            onchange="changeLanguage()"
                            aria-label="@Localizer["SelectLanguage"]">

                        <option value="en"
                                selected="@(Thread.CurrentThread.CurrentUICulture.Name == "en")">
                            English
                        </option>

                        <option value="kn"
                                selected="@(Thread.CurrentThread.CurrentUICulture.Name == "kn")">
                            ಕನ್ನಡ (Kannada)
                        </option>

                    </select>

                </div>

                <!-- Logout -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="mb-0">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn logout-btn">

                            <i class="bi bi-box-arrow-right me-2"></i>
                            Logout

                        </button>

                    </form>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn logout-btn">

                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        Login

                    </a>
                }

              @*   <span class="chip">
                    University Portal
                </span> *@

            </div>

        </div>

    </header>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <partial name="_AuthenticatedNavbar" />
    }

    @* ==================== NAVBAR ==================== *@
    @* @if (User.Identity?.IsAuthenticated == true)
    {
        <partial name="_AuthenticatedNavbar" />
    }
    else
    {
       <partial name="_PublicNavbar" />
    } *@

    @* ==================== MAIN CONTENT ==================== *@
    <main role="main">
        @RenderBody()
    </main>

    <partial name="_PageLoader" />

    <script src="~/js/page-loader.js" asp-append-version="true"></script>

    @* ==================== SCRIPTS ==================== *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/language.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    @if (User.Identity?.IsAuthenticated == true)
    {
        @await Component.InvokeAsync("AffiliationSelector")

        <script src="~/js/affiliation-selector.js" asp-append-version="true"></script>
    }
</body>
</html>

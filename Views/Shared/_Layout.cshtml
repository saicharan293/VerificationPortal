@*
    Master Layout for Karnataka Affiliation Verification Portal
    - Handles both authenticated and unauthenticated states
    - Includes theme toggle and responsive navigation
*@

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Official Government of Karnataka portal for college affiliation data verification" />
    <meta name="theme-color" content="#1e40af" />
    <title>@ViewData["Title"] - Karnataka Affiliation Verification Portal</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Noto+Sans+Kannada:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- AOS Animation Library -->
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />

    <!-- Application Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @* ==================== NAVBAR ==================== *@
    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Authenticated User Navbar -->
        <nav class="navbar navbar-expand-lg sticky-top auth-navbar">
            <div class="container">
                <!-- Brand Logo -->
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <div class="brand-wrapper">
                        <div class="brand-logo">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div class="brand-text">
                            <span class="brand-title">Karnataka Affiliation</span>
                            <span class="brand-subtitle">Verification Portal</span>
                        </div>
                    </div>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#authNavbar" aria-controls="authNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navbar Links -->
                <div class="collapse navbar-collapse" id="authNavbar">
                    <ul class="navbar-nav me-auto align-items-lg-center gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                        </li>

                        @* ==================== ADMIN ONLY LINKS ==================== *@
                        @if (User.IsInRole("Admin") || User.IsInRole("ViceChancellor") || User.IsInRole("Director"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="adminDropdown"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-lock-fill"></i> Admin
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="CollegeMapping" asp-action="Index">
                                            <i class="bi bi-diagram-3"></i> College Mappings
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="CollegeMapping" asp-action="Create">
                                            <i class="bi bi-plus-circle"></i> New Assignment
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="CollegeMapping" asp-action="AssignByRange">
                                            <i class="bi bi-rulers"></i> Assign by Range
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <i class="bi bi-people-fill"></i> Manage Users
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <i class="bi bi-gear-fill"></i> System Settings
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        @* ==================== COMMON LINKS ==================== *@
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="MyColleges" asp-action="Index">
                                <i class="bi bi-building"></i> My Colleges
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="bi bi-file-earmark-text"></i> Reports
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2 mt-2 mt-lg-0">
                        <!-- Theme Toggle Button -->
                        <button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle theme" title="Toggle Light/Dark Mode">
                            <i class="bi bi-moon-fill moon-icon"></i>
                            <i class="bi bi-sun-fill sun-icon"></i>
                        </button>

                        <!-- User Dropdown -->
                        <div class="dropdown">
                            <button class="btn btn-user-dropdown dropdown-toggle d-flex align-items-center gap-2 p-0 border-0 bg-transparent" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle fs-4"></i>
                                <div class="user-info-text d-none d-md-block text-start">
                                    <strong class="id-name">@User.Identity.Name</strong>
                                    <small class="d-block">@User.FindFirst("Designation")?.Value</small>
                                </div>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-controller="MyColleges" asp-action="Index">
                                        <i class="bi bi-building me-2"></i> My Colleges
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Dashboard" asp-action="Profile">
                                        <i class="bi bi-person-lines-fill me-2 id-name"></i> Profile
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" asp-antiforgery="true" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item text-danger" style="width: 100%; text-align: left; background: none; border: none; padding: 0.5rem 1rem;">
                                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    }
    else
    {
        <!-- Public/Guest Navbar -->
        <nav class="navbar navbar-expand-lg sticky-top custom-navbar">
            <div class="container">
                <!-- Brand Logo -->
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <div class="brand-wrapper">
                        <div class="brand-logo">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div class="brand-text">
                            <span class="brand-title">Karnataka Affiliation</span>
                            <span class="brand-subtitle">Verification Portal</span>
                        </div>
                    </div>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNavbar" aria-controls="publicNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navbar Links -->
                <div class="collapse navbar-collapse" id="publicNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#verify">
                                <i class="bi bi-search"></i> Verify
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#faculties">
                                <i class="bi bi-mortarboard"></i> Faculties
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#stats">
                                <i class="bi bi-graph-up"></i> Statistics
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2 ms-lg-3 mt-2 mt-lg-0">
                        <!-- Theme Toggle Button -->
                        <button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle theme" title="Toggle Light/Dark Mode">
                            <i class="bi bi-moon-fill moon-icon"></i>
                            <i class="bi bi-sun-fill sun-icon"></i>
                        </button>

                        <!-- Login Button -->
                        <a class="btn btn-login" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    }

    @* ==================== MAIN CONTENT ==================== *@
    <main role="main">
        @RenderBody()
    </main>

    @* ==================== SCRIPTS ==================== *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


@* Sidebar partial for Verification Dashboard *@
@{
    var activeTab = ViewData["ActiveTab"]?.ToString() ?? "";
    var collegeCode = ViewData["CollegeCode"]?.ToString() ?? "";
    var institutionName = ViewData["InstitutionName"]?.ToString() ?? "Unknown Institution";
    var facultyName = ViewData["FacultyName"]?.ToString() ?? "";
    var verificationStatus = ViewData["VerificationStatus"]?.ToString();
    var statusBadgeClass = ViewData["StatusBadgeClass"]?.ToString();

    var existingCourseLevel = Context.Session.GetString("CourseLevel");

    bool isGovt = ViewData["TypeOfInstitution"]?.ToString() == "Government/Autonomous";

    var completedTabNames = ViewData["CompletedTabNames"] as HashSet<string>
        ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    
    var navTabs = new (string Action, string Label, string Icon, bool Show, string CompletedLabel)[]
    {
        ("InstitutionDetails", "Institution Details", "bi-building", true, "Institution Details"),

        ("TrustDetails", "Trust Details", "bi-building", !isGovt, "Trust Details"),
        ("TrustMemberDetails", "Trust Member Details", "bi-people", !isGovt, "Trust Member Details"),

        ("DeanDirectorDetails", "Dean or Director Details", "bi-person-badge", true, "Dean or Director Details"),
        ("PrincipalDetails", "Principal Details", "bi-mortarboard", true, "Principal Details"),

        ("Courses", "Courses-wise Intake", "bi-book", true, "Dental Increase Intake"),

        ("UGCourseDetails", "Ug Course Details", "bi-mortarboard", existingCourseLevel == "UG", "Ug Course Details"),
        ("PgCourseDetails", "Pg Course Details", "bi-mortarboard", existingCourseLevel == "PG", "Pg Course Details"),

        ("LandAndBuildingDetails", "Land And Building Details", "bi-building", true, "Land And Building Details"),
        ("ClassroomAndLaboratory", "Classroom And Laboratory", "bi-houses", true, "Classroom And Laboratory"),
        ("EquipmentList", "Equipment List", "bi-tools", true, "Equipment List"),
        ("ClinicalFacilities", "Clinical Facilities", "bi-hospital", true, "Clinical Facilities"),
        ("BedDistribution", "Bed Distribution", "bi-hospital", true, "Bed Distribution"),
        ("DepartmentOfficesAndEducationalUnit", "Department Offices And Educational Unit", "bi-building", true, "Department Offices And Educational Unit"),
        ("HostelDetails", "Hostel Details", "bi-house-door", true, "Hostel Details"),
        // ("AssociatedInstitution", "Associated Institution", "bi-building", true, "Associated Institution"),
        ("CA_VehicleDetails", "Vehicle Details", "bi-car-front", true, "Vehicle Details"),

        ("UgAcademicMatters", "UG Academic Matters", "bi-mortarboard", existingCourseLevel == "UG", "UG Academic Matters"),
        ("PgAcademicMatters", "PG Academic Matters", "bi-mortarboard", existingCourseLevel == "PG", "PG Academic Matters"),

        ("FinanceDetails", "Finance Details", "bi-cash-stack", true, "Finance Details"),
        ("StaffPayScale", "Staff Pay Scale", "bi-wallet2", true, "Staff Pay Scale"),
        ("StaffOtherDetails", "Staff Other Details", "bi-people", true, "Staff Other Details"),
        ("CollegeDesignation", "Faculty Repository", "bi-people-fill", true, "Faculty Repository"),

        ("LibraryServices", "Library Services", "bi-book", true, "Library Services"),
        ("ResearchPublications", "Research and Publications", "bi-journal-text", true, "Research and Publications"),
        ("LibraryDetails", "Library Details", "bi-book-half", true, "Library Details"),
        ("FacultyDetails", "Faculty Details", "bi-person-badge", true, "Faculty Details"),
        ("NonTeachingStaffDetails", "Non Teaching Staff Details", "bi-people", true, "Non Teaching Staff Details"),
        ("TeachingExperience", "Teaching Experience", "bi-clock-history", true, "Teaching Experience"),
        ("PaymentDetails", "Payment Details", "bi-credit-card", true, "Payment Details"),
        // ("GeoTaggedPhotos", "Geo Tagged Photos", "bi-camera", true, "Geo Tagged Photos")
    };
}

<!-- Navigation Tabs -->
<nav class="sidebar-nav" aria-label="Verification sections">
    <ul class="nav flex-column">

        @foreach (var tab in navTabs.Where(t => t.Show))
        {
            var isActive = activeTab == tab.Action;
            var isCompleted = completedTabNames.Contains(tab.CompletedLabel);

            <li class="nav-item">
                <a class="nav-link @(isActive ? "active" : "")"
                   asp-controller="VerificationDashboard"
                   asp-action="@tab.Action"
                   asp-route-collegeCode="@collegeCode">

                    <i class="bi @tab.Icon"></i>
                    <span>@tab.Label</span>

                    @if (isCompleted)
                    {
                        <i class="bi bi-check-circle-fill text-success ms-auto"
                           title="Verification Completed"></i>
                    }
                </a>
            </li>
        }
    </ul>
</nav>

@* Sidebar Overlay for Mobile *@
@* <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div> *@


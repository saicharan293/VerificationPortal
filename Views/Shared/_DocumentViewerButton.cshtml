@model DocumentViewerVm

<button type="button"
        class="btn btn-outline-primary w-100 document-viewer-btn"
        data-document-url="@Model.Url"
        data-document-title="@Model.Title"
        data-document-id="@Model.DocumentId"
        data-faculty-id="@Model.FacultyId"
        data-college-code="@Model.CollegeCode">

    <i class="bi bi-eye me-1"></i>
    View Document
</button>
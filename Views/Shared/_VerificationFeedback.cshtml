
<style>
    .status-options {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
    }

    .btn-status {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .65rem 1.4rem;
        border-radius: 999px;
        font-weight: 600;
        border: 2px solid var(--status-color);
        color: var(--status-color);
        background-color: transparent;
        cursor: pointer;
        transition: all .2s ease;
    }

    .btn-status:hover,
    .btn-check:checked + .btn-status {
        background-color: var(--status-color) !important;
        color: #fff !important;
        transform: translateY(-1px);
    }

    .btn-check:checked + .btn-status {
        box-shadow: 0 4px 12px color-mix(in srgb, var(--status-color) 35%, transparent);
    }

    .btn-check:focus-visible + .btn-status {
        outline: 3px solid color-mix(in srgb, var(--status-color) 40%, transparent);
        outline-offset: 2px;
    }

    .btn-status-accept  { --status-color: #198754; }
    .btn-status-reject  { --status-color: #bd434f; }
    .btn-status-pending { --status-color: #f59f00; }
    /* show the validation message when no option is picked */
    .was-validated .status-options:has(.btn-check:invalid) + .invalid-feedback {
        display: block;
    }

    .btn-status .icon-active {
        display: none;
    }

    .btn-check:checked + .btn-status .icon-idle {
        display: none;
    }

    .btn-check:checked + .btn-status .icon-active {
        display: inline-block;
    }
</style>

<section class="verification-feedback-section" data-aos-duration="600">
    <div class="container-fluid">
        <div class="feedback-card">
            <div class="feedback-header">
                <h2 class="feedback-title">
                    <i class="bi bi-clipboard-check"></i>
                    Over all Verification Feedback & Status
                </h2>
                @* @if (ViewData["CurrentVerifier"] != null)
                {
                    <div class="verifier-info">
                        <i class="bi bi-person-badge"></i>
                        <span>@ViewData["CurrentVerifier"]</span>
                    </div>
                } *@
            </div>
            <div class="feedback-body">
                @if (ViewData["ShowFeedbackForm"] != null && (bool)ViewData["ShowFeedbackForm"])
                {
                    <form asp-controller="VerificationDashboard" asp-action="SaveVerification" method="post" class="feedback-form needs-validation" novalidate>
                        <input type="hidden" name="collegeCode" value="@ViewData["CollegeCode"]" />
                        <input type="hidden" name="tabName" value="@ViewData["ActiveTab"]" />

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label d-block">Verification Status <span class="text-danger">*</span></label>

                                <div class="status-options" role="group" aria-label="Verification status">
                                    <input type="radio" class="btn-check" name="status" id="statusAccept" value="accept"
                                        autocomplete="off" required
                                        checked="@(ViewData["ExistingStatus"]?.ToString() == "Approved")" />
                                    <label class="btn btn-status btn-status-accept" for="statusAccept">
                                        <i class="bi bi-check-circle-fill icon-idle"></i>
                                        <i class="bi bi-check-lg icon-active"></i>
                                        Accept
                                    </label>

                                    <input type="radio" class="btn-check" name="status" id="statusReject" value="reject"
                                        autocomplete="off"
                                        checked="@(ViewData["ExistingStatus"]?.ToString() == "Rejected")" />
                                    <label class="btn btn-status btn-status-reject" for="statusReject">
                                        <i class="bi bi-x-circle-fill icon-idle"></i>
                                        <i class="bi bi-x-lg icon-active"></i>
                                        Reject
                                    </label>

                                    @* Pending option commented out
                                    <input type="radio" class="btn-check" name="status" id="statusPending" value="pending"
                                        autocomplete="off"
                                        checked="@(ViewData["ExistingStatus"]?.ToString() == "Pending")" />
                                    <label class="btn btn-status btn-status-pending" for="statusPending">
                                        <i class="bi bi-hourglass-split"></i> Pending Review
                                    </label>
                                    *@
                                </div>
                                <div class="invalid-feedback">Please select a verification status.</div>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label" for="remarks">Remarks <span class="remarks-marker"></span></label>
                                <div class="form-text">Please provide detailed remarks for your verification decision.</div>
                                <textarea class="form-control" id="remarks" name="remarks" rows="4"
                                            placeholder="Enter your verification remarks here... Describe any discrepancies, observations, or approval notes.">@ViewData["ExistingRemarks"]</textarea>
                                <div class="invalid-feedback">Remarks are required for verification.</div>
                            </div>
                        </div>

                        <div class="feedback-actions mt-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-save"></i> Save Verification
                            </button>
                            @if (ViewData["NextTabAction"] != null)
                            {
                                <a href="@ViewData["NextTabAction"]" class="btn btn-outline-primary btn-lg">
                                    <i class="bi bi-arrow-right"></i> @ViewData["NextTabLabel"]
                                </a>
                            }
                            @* @if (ViewData["PrevTabAction"] != null)
                            {
                                <a href="@ViewData["PrevTabAction"]" class="btn btn-outline-secondary btn-lg">
                                    <i class="bi bi-arrow-left"></i> @ViewData["PrevTabLabel"]
                                </a>
                            } *@
                            @* <a asp-controller="MyColleges" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Back to My Colleges
                            </a> *@
                        </div>
                    </form>
                }
                else
                {
                    @* Display-only feedback status *@
                    <div id="verificationDisplay">


                        @if (!string.IsNullOrWhiteSpace(ViewData["ExistingRemarks"]?.ToString()))
                        {
                            <div class="feedback-item">
                                <label class="feedback-label">Previous Remarks</label>
                                <div class="feedback-value">
                                    @ViewData["ExistingRemarks"]
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="feedback-item">
                                <label class="feedback-label">Previous Remarks</label>
                                <div class="feedback-value small">
                                    No previous remarks available.
                                </div>
                            </div>
                        }

                        @if (ViewData["ExistingStatus"] != null)
                        {
                            <div class="feedback-item">
                                <label class="feedback-label">Previous Status</label>
                                <div class="feedback-value">
                                    <span class="status-badge @ViewData["ExistingStatusClass"]">
                                        @ViewData["ExistingStatus"]
                                    </span>
                                </div>
                            </div>
                        }

                        @if (ViewData["VerifiedBy"] != null)
                        {
                            <div class="feedback-item">
                                <label class="feedback-label">Verified By</label>
                                <div class="feedback-value">@ViewData["VerifiedBy"]</div>
                            </div>
                        }

                        @if (ViewData["VerifiedDate"] != null)
                        {
                            <div class="feedback-item">
                                <label class="feedback-label">Verified Date</label>
                                <div class="feedback-value">@ViewData["VerifiedDate"]</div>
                            </div>
                        }

                        <div class="mt-4">
                            <button type="button"
                                    class="btn btn-warning"
                                    id="btnEditVerification">
                                <i class="bi bi-pencil-square"></i>
                                Edit Verification
                            </button>
                        </div>

                    </div>
                    <div id="verificationEditForm" style="display:none;">

                        <form asp-controller="VerificationDashboard" asp-action="SaveVerification" method="post" class="feedback-form">

                            <input type="hidden" name="collegeCode" value="@ViewData["CollegeCode"]" />

                            <input type="hidden" name="tabName" value="@ViewData["ActiveTab"]" />

                            <div class="row g-3">

                                <div class="col-12">
                                    <label class="form-label d-block">Verification Status <span class="text-danger">*</span></label>

                                    <div class="status-options" role="group" aria-label="Verification status">
                                        <input type="radio" class="btn-check" name="status" id="editStatusAccept" value="accept"
                                            autocomplete="off" required
                                            checked="@(ViewData["ExistingStatus"]?.ToString() == "Approved")" />
                                        <label class="btn btn-status btn-status-accept" for="editStatusAccept">
                                            <i class="bi bi-check-circle-fill icon-idle"></i>
                                            <i class="bi bi-check-lg icon-active"></i>
                                            Accept
                                        </label>

                                        <input type="radio" class="btn-check" name="status" id="editStatusReject" value="reject"
                                            autocomplete="off"
                                            checked="@(ViewData["ExistingStatus"]?.ToString() == "Rejected")" />
                                        <label class="btn btn-status btn-status-reject" for="editStatusReject">
                                            <i class="bi bi-x-circle-fill icon-idle"></i>
                                            <i class="bi bi-x-lg icon-active"></i>
                                            Reject
                                        </label>

                                        @* Pending option commented out
                                        <input type="radio" class="btn-check" name="status" id="editStatusPending" value="pending"
                                            autocomplete="off"
                                            checked="@(ViewData["ExistingStatus"]?.ToString() == "Pending")" />
                                        <label class="btn btn-status btn-status-pending" for="editStatusPending">
                                            <i class="bi bi-hourglass-split"></i> Pending Review
                                        </label>
                                        *@
                                    </div>
                                </div>

                                <div class="col-12">

                                    <label class="form-label" for="editRemarks">Remarks <span class="remarks-marker"></span></label>
                                    <textarea class="form-control" id="editRemarks" rows="4" name="remarks">@ViewData["ExistingRemarks"]</textarea>
                                </div>

                            </div>

                            <div class="feedback-actions mt-4">

                                <button class="btn btn-primary" type="submit">
                                    <i class="bi bi-save"></i>
                                    Update Verification
                                </button>

                                <button type="button" class="btn btn-secondary" id="btnCancelEdit">
                                    Cancel
                                </button>

                            </div>

                        </form>

                    </div>
                }
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function(){
        document.querySelectorAll("form.feedback-form").forEach(function(form){
            const radios = form.querySelectorAll('input[name = "status"]');
            const remarks = form.querySelector('textarea[name="remarks"]');
            const marker = form.querySelector('.remarks-marker');

            if(!radios.length || !remarks || !marker) return;

            function updateRemarksMarker(){
                const selected = form.querySelector('input[name="status"]:checked');
                const isAccept = selected && selected.value == 'accept';
                if(isAccept){
                    marker.className = 'remarks-marker text-muted small';
                    marker.textContent = '(optional)';
                    remarks.required = false;
                }
                else{
                    marker.className = 'remarks-marker text-danger';
                    marker.textContent = "*";
                    remarks.required = true;
                }
            }

            radios.forEach(r => r.addEventListener('change', updateRemarksMarker));
            updateRemarksMarker();
        })
    })
</script>
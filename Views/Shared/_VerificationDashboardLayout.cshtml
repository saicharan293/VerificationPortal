@{
    // Layout = "~/Views/Shared/_Layout.cshtml";

    var verificationHistory =
        ViewData["VerificationHistory"]
        as IEnumerable<VerificationPortal.Models.VerificationHistoryViewModel>
        ?? Enumerable.Empty<VerificationPortal.Models.VerificationHistoryViewModel>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Karnataka Affiliation Verification Portal - College Verification Dashboard" />
    <meta name="theme-color" content="#1e40af" />
    <title>@ViewData["Title"] - Karnataka Affiliation Verification Portal</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Noto+Sans+Kannada:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- AOS Animation Library -->
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />

    <!-- Application Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/report-card.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/verification-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout-header.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="verification-dashboard">
        <!-- Sidebar -->
        @await Html.PartialAsync("_VerificationSidebar")

        @await Html.PartialAsync("_VerificationSummaryModal")

        <!-- Main Content -->
        <main class="main-content" id="mainContent">

            <!-- Top Bar -->
            <partial name="_VerificationTopBar"/>


            <div class="main-scroll">
                <!-- Page Content -->
                <div class="page-content">
                    @RenderBody()
                    @if (ViewData["ShowFeedbackSection"] is true)
                    {
                        @await Html.PartialAsync("_VerificationFeedback")
                    }

                    @if ((ViewData["IsAdmin"] as bool?) == true)
                    {
                        @await Html.PartialAsync("_VerificationHistory", verificationHistory)
                    }

                </div>

                

                @* ==================== VERIFICATION FEEDBACK & STATUS SECTION ==================== *@

                <!-- Footer -->
                <partial name="_VerificationFooter"/>
            </div>

        </main>

        <button type="button" 
                id="scrollToTopBtn" 
                class="scroll-to-top" 
                aria-label="Scroll to top" 
                title="Scroll to top">
            <i class="bi bi-arrow-up"></i>
        </button>
        <!-- Overlay for mobile sidebar -->
        @* <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div> *@
    </div>
   

    <!-- Verification Summary Modal -->
    

    @await Html.PartialAsync("_DocumentViewer")

    <partial name="_PageLoader" />

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="~/js/page-loader.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/document-viewer.js" asp-append-version="true"></script>
    <script src="~/js/verification-dashboard.js" asp-append-version="true"></script>
    
    <script>
        window.documentViewerConfig = {
            feedbackUrl: '@Url.Action("GetDocumentFeedback", "VerificationDashboard")',
            saveFeedbackUrl: '@Url.Action("SaveDocumentFeedback", "VerificationDashboard")'
        };
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var verificationHistory =
        ViewData["VerificationHistory"]
        as IEnumerable<VerificationPortal.Models.VerificationHistoryViewModel>
        ?? Enumerable.Empty<VerificationPortal.Models.VerificationHistoryViewModel>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Karnataka Affiliation Verification Portal - College Verification Dashboard" />
    <meta name="theme-color" content="#1e40af" />
    <title>@ViewData["Title"] - Karnataka Affiliation Verification Portal</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Noto+Sans+Kannada:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- AOS Animation Library -->
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />

    <!-- Application Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/report-card.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/verification-dashboard.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="verification-dashboard">
        <!-- Sidebar -->
        @await Html.PartialAsync("_VerificationSidebar")
        <!-- Main Content -->
        <main class="main-content" id="mainContent">
            <!-- Top Bar -->
            <header class="top-bar">
                <div class="top-bar-left" >
                    <button class="sidebar-toggle d-md-none" id="mobileSidebarToggle" aria-label="Open sidebar">
                        <i class="bi bi-list"></i>
                    </button>
                    <h1 class="page-title">@ViewData["Title"]</h1>
                </div>
            </header>


            <div class="main-scroll">
                <!-- Page Content -->
                <div class="page-content">
                    @RenderBody()
                </div>

                @* ==================== VERIFICATION FEEDBACK & STATUS SECTION ==================== *@
                @if (ViewData["ShowFeedbackSection"] != null && (bool)ViewData["ShowFeedbackSection"])
                {
                    <section class="verification-feedback-section" data-aos-duration="600">
                        <div class="container-fluid">
                            <div class="feedback-card">
                                <div class="feedback-header">
                                    <h2 class="feedback-title">
                                        <i class="bi bi-clipboard-check"></i>
                                        Over all Verification Feedback & Status
                                    </h2>
                                    @* @if (ViewData["CurrentVerifier"] != null)
                                    {
                                        <div class="verifier-info">
                                            <i class="bi bi-person-badge"></i>
                                            <span>@ViewData["CurrentVerifier"]</span>
                                        </div>
                                    } *@
                                </div>
                                <div class="feedback-body">
                                    @if (ViewData["ShowFeedbackForm"] != null && (bool)ViewData["ShowFeedbackForm"])
                                    {
                                        <form asp-controller="VerificationDashboard" asp-action="SaveVerification" method="post" class="feedback-form needs-validation" novalidate>
                                            <input type="hidden" name="collegeCode" value="@ViewData["CollegeCode"]" />
                                            <input type="hidden" name="tabName" value="@ViewData["ActiveTab"]" />

                                            <div class="row g-3">
                                                <div class="col-12">
                                                    <label class="form-label" for="status">Verification Status <span class="text-danger">*</span></label>
                                                    <select class="form-select" id="status" name="status">
                                                        <option value="">-- Select Status --</option>

                                                        <option value="accept"
                                                                selected="@(ViewData["ExistingStatus"]?.ToString() == "Approved")">
                                                            Accept
                                                        </option>

                                                        <option value="reject"
                                                                selected="@(ViewData["ExistingStatus"]?.ToString() == "Rejected")">
                                                            Reject
                                                        </option>

                                                        <option value="pending"
                                                                selected="@(ViewData["ExistingStatus"]?.ToString() == "Pending")">
                                                            Pending Review
                                                        </option>
                                                    </select>
                                                    <div class="invalid-feedback">Please select a verification status.</div>
                                                </div>
                                                <div class="col-md-12">
                                                    <label class="form-label" for="remarks">Remarks <span class="text-danger">*</span></label>
                                                    <textarea class="form-control" id="remarks" name="remarks" rows="4"
                                                              placeholder="Enter your verification remarks here... Describe any discrepancies, observations, or approval notes.">@ViewData["ExistingRemarks"]</textarea>
                                                    <div class="form-text">Please provide detailed remarks for your verification decision.</div>
                                                    <div class="invalid-feedback">Remarks are required for verification.</div>
                                                </div>
                                            </div>

                                            <div class="feedback-actions">
                                                <button type="submit" class="btn btn-primary btn-lg">
                                                    <i class="bi bi-save"></i> Save Verification
                                                </button>
                                                @if (ViewData["NextTabAction"] != null)
                                                {
                                                    <a href="@ViewData["NextTabAction"]" class="btn btn-outline-primary btn-lg">
                                                        <i class="bi bi-arrow-right"></i> @ViewData["NextTabLabel"]
                                                    </a>
                                                }
                                                @* @if (ViewData["PrevTabAction"] != null)
                                                {
                                                    <a href="@ViewData["PrevTabAction"]" class="btn btn-outline-secondary btn-lg">
                                                        <i class="bi bi-arrow-left"></i> @ViewData["PrevTabLabel"]
                                                    </a>
                                                } *@
                                                @* <a asp-controller="MyColleges" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                                    <i class="bi bi-arrow-left"></i> Back to My Colleges
                                                </a> *@
                                            </div>
                                        </form>
                                    }
                                    else
                                    {
                                        @* Display-only feedback status *@
                                        <div id="verificationDisplay">


                                            @if (!string.IsNullOrWhiteSpace(ViewData["ExistingRemarks"]?.ToString()))
                                            {
                                                <div class="feedback-item">
                                                    <label class="feedback-label">Previous Remarks</label>
                                                    <div class="feedback-value">
                                                        @ViewData["ExistingRemarks"]
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="feedback-item">
                                                    <label class="feedback-label">Previous Remarks</label>
                                                    <div class="feedback-value small">
                                                        No previous remarks available.
                                                    </div>
                                                </div>
                                            }

                                            @if (ViewData["ExistingStatus"] != null)
                                            {
                                                <div class="feedback-item">
                                                    <label class="feedback-label">Previous Status</label>
                                                    <div class="feedback-value">
                                                        <span class="status-badge @ViewData["ExistingStatusClass"]">
                                                            @ViewData["ExistingStatus"]
                                                        </span>
                                                    </div>
                                                </div>
                                            }

                                            @if (ViewData["VerifiedBy"] != null)
                                            {
                                                <div class="feedback-item">
                                                    <label class="feedback-label">Verified By</label>
                                                    <div class="feedback-value">@ViewData["VerifiedBy"]</div>
                                                </div>
                                            }

                                            @if (ViewData["VerifiedDate"] != null)
                                            {
                                                <div class="feedback-item">
                                                    <label class="feedback-label">Verified Date</label>
                                                    <div class="feedback-value">@ViewData["VerifiedDate"]</div>
                                                </div>
                                            }

                                            <div class="mt-4">
                                                <button type="button"
                                                        class="btn btn-warning"
                                                        id="btnEditVerification">
                                                    <i class="bi bi-pencil-square"></i>
                                                    Edit Verification
                                                </button>
                                            </div>

                                        </div>
                                        <div id="verificationEditForm" style="display:none;">

                                            <form asp-controller="VerificationDashboard" asp-action="SaveVerification" method="post" class="feedback-form">

                                                <input type="hidden" name="collegeCode" value="@ViewData["CollegeCode"]" />

                                                <input type="hidden" name="tabName" value="@ViewData["ActiveTab"]" />

                                                <div class="row g-3">

                                                    <div class="col-12">

                                                        <label class="form-label">
                                                            Verification Status
                                                        </label>

                                                        <select class="form-select" name="status">

                                                            <option value="accept" selected="@(ViewData["ExistingStatus"]?.ToString() == "Approved")">
                                                                Accept
                                                            </option>

                                                            <option value="reject" selected="@(ViewData["ExistingStatus"]?.ToString() == "Rejected")">
                                                                Reject
                                                            </option>

                                                            <option value="pending" selected="@(ViewData["ExistingStatus"]?.ToString() == "Pending")">
                                                                Pending Review
                                                            </option>

                                                        </select>

                                                    </div>

                                                    <div class="col-12">

                                                        <label class="form-label">
                                                            Remarks
                                                        </label>

                                                        <textarea class="form-control" rows="4" name="remarks">@ViewData["ExistingRemarks"]</textarea>

                                                    </div>

                                                </div>

                                                <div class="feedback-actions mt-4">

                                                    <button class="btn btn-primary" type="submit">
                                                        <i class="bi bi-save"></i>
                                                        Update Verification
                                                    </button>

                                                    <button type="button" class="btn btn-secondary" id="btnCancelEdit">
                                                        Cancel
                                                    </button>

                                                </div>

                                            </form>

                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </section>
                }

                <!-- Footer -->
                <footer class="page-footer">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <span class="text-muted small">&copy; 2025 Karnataka Affiliation Verification Portal</span>
                        <div class="footer-links">
                            <a href="#" class="text-muted small me-3">Privacy Policy</a>
                            <a href="#" class="text-muted small me-3">Terms of Use</a>
                            <a href="#" class="text-muted small">Help</a>
                        </div>
                    </div>
                </footer>
            </div>

        </main>

        <!-- Overlay for mobile sidebar -->
        <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>
    </div>
    @* @await Html.PartialAsync("_VerificationHistory", verificationHistory) *@


    <!-- Verification Summary Modal -->
    <div class="modal fade" id="verificationSummaryModal" tabindex="-1" aria-labelledby="verificationSummaryModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="verificationSummaryModalLabel">
                        <i class="bi bi-clipboard-check me-2"></i>Verification Summary
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="verification-summary">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="summary-card">
                                    <div class="summary-card-header">
                                        <i class="bi bi-building text-primary"></i>
                                        <h6>Institution Details</h6>
                                    </div>
                                    <div class="summary-progress">
                                        <div class="progress" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100">
                                            <div class="progress-bar bg-primary" style="width: 75%"></div>
                                        </div>
                                        <small class="text-muted">75% Complete</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="summary-card">
                                    <div class="summary-card-header">
                                        <i class="bi bi-book text-success"></i>
                                        <h6>Courses & Intake</h6>
                                    </div>
                                    <div class="summary-progress">
                                        <div class="progress" role="progressbar" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100">
                                            <div class="progress-bar bg-success" style="width: 60%"></div>
                                        </div>
                                        <small class="text-muted">60% Complete</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="summary-card">
                                    <div class="summary-card-header">
                                        <i class="bi bi-houses text-info"></i>
                                        <h6>Infrastructure</h6>
                                    </div>
                                    <div class="summary-progress">
                                        <div class="progress" role="progressbar" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100">
                                            <div class="progress-bar bg-info" style="width: 80%"></div>
                                        </div>
                                        <small class="text-muted">80% Complete</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="summary-card">
                                    <div class="summary-card-header">
                                        <i class="bi bi-people text-warning"></i>
                                        <h6>Faculty Details</h6>
                                    </div>
                                    <div class="summary-progress">
                                        <div class="progress" role="progressbar" aria-valuenow="45" aria-valuemin="0" aria-valuemax="100">
                                            <div class="progress-bar bg-warning" style="width: 45%"></div>
                                        </div>
                                        <small class="text-muted">45% Complete</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="summary-card">
                                    <div class="summary-card-header">
                                        <i class="bi bi-hospital text-danger"></i>
                                        <h6>Clinical Material</h6>
                                    </div>
                                    <div class="summary-progress">
                                        <div class="progress" role="progressbar" aria-valuenow="55" aria-valuemin="0" aria-valuemax="100">
                                            <div class="progress-bar bg-danger" style="width: 55%"></div>
                                        </div>
                                        <small class="text-muted">55% Complete</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="summary-card">
                                    <div class="summary-card-header">
                                        <i class="bi bi-person-badge text-secondary"></i>
                                        <h6>Admin & Governance</h6>
                                    </div>
                                    <div class="summary-progress">
                                        <div class="progress" role="progressbar" aria-valuenow="90" aria-valuemin="0" aria-valuemax="100">
                                            <div class="progress-bar bg-secondary" style="width: 90%"></div>
                                        </div>
                                        <small class="text-muted">90% Complete</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="summary-card">
                                    <div class="summary-card-header">
                                        <i class="bi bi-cash-stack text-dark"></i>
                                        <h6>Finance & Fees</h6>
                                    </div>
                                    <div class="summary-progress">
                                        <div class="progress" role="progressbar" aria-valuenow="70" aria-valuemin="0" aria-valuemax="100">
                                            <div class="progress-bar" style="width: 70%"></div>
                                        </div>
                                        <small class="text-muted">70% Complete</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="summary-card">
                                    <div class="summary-card-header">
                                        <i class="bi bi-file-earmark-text text-primary"></i>
                                        <h6>Documents</h6>
                                    </div>
                                    <div class="summary-progress">
                                        <div class="progress" role="progressbar" aria-valuenow="40" aria-valuemin="0" aria-valuemax="100">
                                            <div class="progress-bar bg-primary" style="width: 40%"></div>
                                        </div>
                                        <small class="text-muted">40% Complete</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" id="exportSummaryBtn">
                        <i class="bi bi-download me-1"></i> Export Report
                    </button>
                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_DocumentViewer")

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/document-viewer.js" asp-append-version="true"></script>
    <script src="~/js/verification-dashboard.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
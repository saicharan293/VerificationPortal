@model SectionFeedbackViewModel

<div class="section-feedback my-4"
     data-section-id="@Model.SectionId"
     data-tab-id="@Model.TabId"
     data-faculty-id="@Model.FacultyId"
     data-college-code="@Model.CollegeCode">

    <div class="section-feedback-body">

        @* =========================================================
           NEW FEEDBACK
           ========================================================= *@

        @if (!Model.IsSaved)
        {
            <div id="verificationForm_@Model.SectionId">

                <form asp-controller="VerificationDashboard"
                      asp-action="SaveSectionFeedback"
                      method="post"
                      class="section-feedback-form">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="FacultyId" value="@Model.FacultyId" />
                    <input type="hidden" name="CollegeCode" value="@Model.CollegeCode" />
                    <input type="hidden" name="TabId" value="@Model.TabId" />
                    <input type="hidden" name="SectionId" value="@Model.SectionId" />
                    <input type="hidden" name="SectionName" value="@Model.SectionName" />
                    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

                    <div class="row g-4">

                        @* Verification Status *@
                        <div class="col-lg-5">

                            <label class="form-label">
                                Verification Status
                                <span class="text-danger">*</span>
                            </label>

                            <div class="verification-status-selector">

                                <input type="radio"
                                       class="btn-check"
                                       name="VerificationStatus"
                                       id="newStatusAccepted_@Model.SectionId"
                                       value="Accepted"
                                       autocomplete="off"
                                       required>

                                <label class="verification-status-btn status-accepted"
                                       for="newStatusAccepted_@Model.SectionId">
                                    <i class="bi bi-check-circle"></i>
                                    <span>Accept</span>
                                </label>


                                <input type="radio"
                                       class="btn-check"
                                       name="VerificationStatus"
                                       id="newStatusRejected_@Model.SectionId"
                                       value="Rejected"
                                       autocomplete="off">

                                <label class="verification-status-btn status-rejected"
                                       for="newStatusRejected_@Model.SectionId">
                                    <i class="bi bi-x-circle"></i>
                                    <span>Reject</span>
                                </label>


                                <input type="radio"
                                       class="btn-check"
                                       name="VerificationStatus"
                                       id="newStatusPending_@Model.SectionId"
                                       value="Pending"
                                       autocomplete="off">

                                <label class="verification-status-btn status-pending"
                                       for="newStatusPending_@Model.SectionId">
                                    <i class="bi bi-hourglass-split"></i>
                                    <span>Pending</span>
                                </label>

                            </div>

                            <div class="invalid-feedback">
                                Please select a verification status.
                            </div>

                        </div>


                        @* Remarks *@
                        <div class="col-lg-7">

                            <label class="form-label">
                                Remarks
                                <span class="text-danger">*</span>
                            </label>

                            <textarea class="form-control section-verification-remarks"
                                      name="Remarks"
                                      rows="3"
                                      placeholder="Enter your verification remarks here..."
                                      required></textarea>

                            <div class="form-text">
                                Please provide remarks for your verification decision.
                            </div>

                            <div class="invalid-feedback">
                                Remarks are required.
                            </div>

                        </div>

                    </div>


                    <div class="verification-form-actions mt-4">

                        <button type="submit"
                                class="btn btn-primary section-feedback-save">

                            <i class="bi bi-save me-1"></i>
                            Save Verification

                        </button>

                    </div>

                </form>

            </div>
        }


        @* =========================================================
           EXISTING FEEDBACK
           ========================================================= *@

        else
        {
            @* =====================================================
               DISPLAY MODE
               ===================================================== *@

            <div id="verificationDisplay_@Model.SectionId">

                <div class="row g-4">

                    @* Status *@
                    <div class="col-lg-5">

                        <div class="feedback-item">

                            <label class="feedback-label">
                                Verification Status
                            </label>

                            <div class="feedback-value">

                                @if (Model.VerificationStatus == "Accepted")
                                {
                                    <span class="verification-status-badge status-badge-accepted">
                                        <i class="bi bi-check-circle-fill"></i>
                                        Accepted
                                    </span>
                                }
                                else if (Model.VerificationStatus == "Rejected")
                                {
                                    <span class="verification-status-badge status-badge-rejected">
                                        <i class="bi bi-x-circle-fill"></i>
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="verification-status-badge status-badge-pending">
                                        <i class="bi bi-hourglass-split"></i>
                                        @(string.IsNullOrWhiteSpace(Model.VerificationStatus)
                                            ? "Pending"
                                            : Model.VerificationStatus)
                                    </span>
                                }

                            </div>

                        </div>

                    </div>


                    @* Remarks *@
                    <div class="col-lg-7">

                        <div class="feedback-item">

                            <label class="feedback-label">
                                Remarks
                            </label>

                            <div class="feedback-value feedback-remarks">

                                @if (!string.IsNullOrWhiteSpace(Model.Remarks))
                                {
                                    @Model.Remarks
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No remarks available.
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                </div>


                @* Verification History *@

                @if (!string.IsNullOrWhiteSpace(Model.VerifiedBy) ||
                     Model.VerifiedOn.HasValue)
                {
                    <div class="verification-meta mt-4">

                        @if (!string.IsNullOrWhiteSpace(Model.VerifiedBy))
                        {
                            <span>
                                <i class="bi bi-person-check"></i>
                                Verified By:
                                <strong>@Model.VerifiedBy</strong>
                            </span>
                        }

                        @if (Model.VerifiedOn.HasValue)
                        {
                            <span>
                                <i class="bi bi-clock"></i>
                                Verified On:
                                <strong>
                                    @Model.VerifiedOn.Value.ToString("dd MMM yyyy hh:mm tt")
                                </strong>
                            </span>
                        }

                    </div>
                }


                @* Edit Button *@

                <div class="verification-form-actions mt-4">

                    <button type="button"
                            class="btn btn-outline-warning btn-edit-section-verification"
                            data-section-id="@Model.SectionId">

                        <i class="bi bi-pencil-square me-1"></i>
                        Edit Verification

                    </button>

                </div>

            </div>


            @* =====================================================
               EDIT MODE
               ===================================================== *@

            <div id="verificationEditForm_@Model.SectionId"
                 class="verification-edit-form"
                 style="display:none;">

                <form asp-controller="VerificationDashboard"
                      asp-action="SaveSectionFeedback"
                      method="post"
                      class="section-feedback-form">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="FacultyId"
                           value="@Model.FacultyId" />

                    <input type="hidden"
                           name="CollegeCode"
                           value="@Model.CollegeCode" />

                    <input type="hidden"
                           name="TabId"
                           value="@Model.TabId" />

                    <input type="hidden"
                           name="SectionId"
                           value="@Model.SectionId" />

                    <input type="hidden"
                           name="SectionName"
                           value="@Model.SectionName" />

                    <input type="hidden"
                           name="ReturnUrl"
                           value="@Model.ReturnUrl" />


                    <div class="row g-4">

                        @* Verification Status *@
                        <div class="col-lg-5">

                            <label class="form-label">
                                Verification Status
                                <span class="text-danger">*</span>
                            </label>

                            <div class="verification-status-selector">

                                <input type="radio"
                                       class="btn-check"
                                       name="VerificationStatus"
                                       id="editStatusAccepted_@Model.SectionId"
                                       value="Accepted"
                                       autocomplete="off"
                                       checked="@(Model.VerificationStatus == "Accepted")"
                                       required>

                                <label class="verification-status-btn status-accepted"
                                       for="editStatusAccepted_@Model.SectionId">
                                    <i class="bi bi-check-circle"></i>
                                    <span>Accept</span>
                                </label>


                                <input type="radio"
                                       class="btn-check"
                                       name="VerificationStatus"
                                       id="editStatusRejected_@Model.SectionId"
                                       value="Rejected"
                                       autocomplete="off"
                                       checked="@(Model.VerificationStatus == "Rejected")">

                                <label class="verification-status-btn status-rejected"
                                       for="editStatusRejected_@Model.SectionId">
                                    <i class="bi bi-x-circle"></i>
                                    <span>Reject</span>
                                </label>


                                <input type="radio"
                                       class="btn-check"
                                       name="VerificationStatus"
                                       id="editStatusPending_@Model.SectionId"
                                       value="Pending"
                                       autocomplete="off"
                                       checked="@(Model.VerificationStatus == "Pending")">

                                <label class="verification-status-btn status-pending"
                                       for="editStatusPending_@Model.SectionId">
                                    <i class="bi bi-hourglass-split"></i>
                                    <span>Pending</span>
                                </label>

                            </div>

                            <div class="invalid-feedback">
                                Please select a verification status.
                            </div>

                        </div>


                        @* Remarks *@
                        <div class="col-lg-7">

                            <label class="form-label">
                                Remarks
                            </label>

                            <textarea class="form-control section-verification-remarks"
                                      name="Remarks"
                                      rows="3"
                                      placeholder="Enter your verification remarks...">@Model.Remarks</textarea>

                        </div>

                    </div>


                    <div class="verification-form-actions mt-4">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-save me-1"></i>
                            Update Verification

                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary btn-cancel-section-verification"
                                data-section-id="@Model.SectionId">

                            <i class="bi bi-x-circle me-1"></i>
                            Cancel

                        </button>

                    </div>

                </form>

            </div>
        }

    </div>

</div>


<script>

    // ============================================================
    // Section Verification - Edit / Cancel
    // ============================================================

    document.addEventListener("click", function(event) {

        // --------------------------------------------------------
        // Edit Verification
        // --------------------------------------------------------

        const editButton =
            event.target.closest(".btn-edit-section-verification");

        if (editButton) {

            const sectionId = editButton.dataset.sectionId;

            const display =
                document.getElementById(`verificationDisplay_${sectionId}`);

            const editForm =
                document.getElementById(`verificationEditForm_${sectionId}`);

            if (display && editForm) {

                display.style.display = "none";
                editForm.style.display = "block";

            }

            return;
        }


        // --------------------------------------------------------
        // Cancel Edit
        // --------------------------------------------------------

        const cancelButton =
            event.target.closest(".btn-cancel-section-verification");

        if (cancelButton) {

            const sectionId = cancelButton.dataset.sectionId;

            const display =
                document.getElementById(`verificationDisplay_${sectionId}`);

            const editForm =
                document.getElementById(`verificationEditForm_${sectionId}`);

            if (display && editForm) {

                editForm.style.display = "none";
                display.style.display = "block";

            }
        }

    });

</script>
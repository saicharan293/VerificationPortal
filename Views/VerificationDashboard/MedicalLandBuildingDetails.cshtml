@model VerificationPortal.Models.MedicalLandBuildingVerificationVm

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Land And Building Details - Verification Dashboard";
    ViewData["ActiveTab"] = "LandAndBuildingDetails";

    ViewData["InstitutionName"] =
        Model.PageContext.InstitutionName ?? "Unknown Institution";

    ViewData["CollegeCode"] = Model.PageContext.CollegeCode ?? "";
    ViewData["FacultyName"] = Model.PageContext.FacultyName ?? "";
    ViewData["ShowFeedbackSection"] = true;

    ViewData["CurrentVerifier"] = Model.PageContext.CurrentVerifier;

    ViewData["PrevTabAction"] = Model.PageContext.PrevTabAction;
    ViewData["PrevTabLabel"] = Model.PageContext.PrevTabLabel;

    ViewData["NextTabAction"] = Model.PageContext.NextTabAction;
    ViewData["NextTabLabel"] = Model.PageContext.NextTabLabel;
}

@section Scripts {
    <script src="~/js/verification-dashboard.js"
            asp-append-version="true"></script>
}

<div class="page-header mb-4">
    <h1 class="page-title">
        <i class="bi bi-building"></i>
        Land And Building Details
    </h1>

    <p class="text-muted mb-0">
        Review and verify the institution's land, buildings, facilities
        and supporting documents.
    </p>
</div>

<div class="note-box mb-4">
    <i class="bi bi-info-circle"></i>

    <div class="note-box-content">
        <h6>Verification Instructions</h6>
        <p>
            Review the submitted details and supporting documents carefully.
            Record your feedback for the relevant sections wherever required.
        </p>
    </div>
</div>

<div class="verification-card">

    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-building"></i>
            Medical Land And Building Details
        </h3>
    </div>

    <div class="verification-card-body">

        @await Html.PartialAsync( "~/Views/VerificationDashboard/Partials/LandAndBuildingDetails/Medical/_LandDetails.cshtml", Model)

        @await Html.PartialAsync( "~/Views/VerificationDashboard/Partials/LandAndBuildingDetails/Medical/_LandDocuments.cshtml", Model)

        @await Html.PartialAsync( "~/Views/VerificationDashboard/Partials/LandAndBuildingDetails/Medical/_BuildingDetails.cshtml", Model)

        @await Html.PartialAsync( "~/Views/VerificationDashboard/Partials/LandAndBuildingDetails/Medical/_BuildingDocuments.cshtml", Model)

        @await Html.PartialAsync( "~/Views/VerificationDashboard/Partials/LandAndBuildingDetails/Medical/_AreaDetails.cshtml", Model)

        @await Html.PartialAsync( "~/Views/VerificationDashboard/Partials/LandAndBuildingDetails/Medical/_FacilitiesAvailability.cshtml", Model)

        @await Html.PartialAsync( "~/Views/VerificationDashboard/Partials/LandAndBuildingDetails/Medical/_StaffQuarters.cshtml", Model)

        @await Html.PartialAsync(
            "~/Views/VerificationDashboard/Partials/LandAndBuildingDetails/Medical/_WorkshopDetails.cshtml",
            Model)

        @await Html.PartialAsync(
            "~/Views/VerificationDashboard/Partials/LandAndBuildingDetails/Medical/_AnimalHouseDetails.cshtml",
            Model)

        @await Html.PartialAsync(
            "~/Views/VerificationDashboard/Partials/LandAndBuildingDetails/Medical/_SmallGroupTeaching.cshtml",
            Model)

        @await Html.PartialAsync(
            "~/Views/VerificationDashboard/Partials/LandAndBuildingDetails/Medical/_TeachingRooms.cshtml",
            Model)

        @await Html.PartialAsync(
            "~/Views/VerificationDashboard/Partials/LandAndBuildingDetails/Medical/_LaboratoryAvailability.cshtml",
            Model)

        @await Html.PartialAsync(
            "~/Views/VerificationDashboard/Partials/LandAndBuildingDetails/Medical/_MuseumAvailability.cshtml",
            Model)

    </div>
</div>
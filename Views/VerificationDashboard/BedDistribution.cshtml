@model VerificationPortal.Models.MedicalUGBedDistributionVm

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Medical UG Bed Distribution";
    ViewData["ActiveTab"] = "BedDistribution";

    ViewData["InstitutionName"] = ViewBag.InstitutionName ?? "Unknown Institution";
    ViewData["CollegeCode"] = ViewBag.CollegeCode ?? "";
    ViewData["FacultyName"] = ViewBag.FacultyName ?? "";

    ViewData["ShowFeedbackSection"] = true;

    ViewData["CurrentVerifier"] =
        User.Identity?.Name + " - " + ViewBag.UserDesignation;

    ViewData["PrevTabAction"] = Url.Action(
        "ChairDistribution",
        "VerificationDashboard",
        new { collegeCode = ViewBag.CollegeCode });

    ViewData["PrevTabLabel"] = "Previous : Chair Distribution";

    ViewData["NextTabAction"] = Url.Action(
        "HospitalDetails",
        "VerificationDashboard",
        new { collegeCode = ViewBag.CollegeCode });

    ViewData["NextTabLabel"] = "Next : Hospital Details";
}

<style>/* Bed Distribution */

    .bed-section-card {
        @* background: #fff; *@
        border: 1px solid #e5eaf1;
        border-radius: 12px;
        margin-bottom: 22px;
        overflow: hidden;
        transition: box-shadow 0.2s ease;
    }

    .bed-section-card:hover {
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
    }

    .bed-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 17px 22px;
        @* background: #f8fafc; *@
        border-bottom: 1px solid #e9edf3;
        gap: 12px;
    }

    .bed-section-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        @* background: #e8efff; *@
        color: #3159a5;
        font-size: 12px;
        font-weight: 700;
        margin-right: 10px;
    }

    .bed-section-title {
        font-size: 15px;
        font-weight: 700;
        color: #263449;
    }

    .bed-section-subtitle {
        font-size: 11px;
        font-weight: 600;
        color: #64748b;
        @* background: #edf1f6; *@
        padding: 5px 10px;
        border-radius: 20px;
        white-space: nowrap;
    }

    .bed-details-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        padding: 22px;
    }

    .bed-detail-item {
        display: flex;
        flex-direction: column;
        gap: 9px;
        padding: 15px;
        @* background: #fafbfd; *@
        border: 1px solid #edf0f4;
        border-radius: 9px;
        min-width: 0;
    }

    .bed-label {
        color: #64748b;
        font-size: 15px;
        font-weight: 600;
    }

    .bed-value {
        color: #1e293b;
        font-size: 18px;
        font-weight: 700;
    }

    .bed-total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 22px;
        @* background: #f8fafc; *@
        border-top: 1px solid #e9edf3;
        color: #334155;
        font-size: 14px;
        font-weight: 600;
    }

    .bed-total-row strong {
        font-size: 1rem;
        color: #c1c8d2;
    }

    .bed-grand-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px 25px;
        margin-bottom: 25px;
        border-radius: 12px;
        @* background: #edf4ff; *@
        border: 1px solid #d8e6ff;
    }

    .bed-grand-label {
        display: block;
        font-size: 15px;
        font-weight: 700;
        color: #1e3a68;
    }

    .bed-grand-total small {
        display: block;
        margin-top: 5px;
        font-size: 11px;
        color: #64748b;
    }

    .bed-grand-total strong {
        font-size: 30px;
        color: #2457a7;
    }

    .bed-reported-total {
        padding: 12px 22px;
        border-top: 1px dashed #e2e8f0;
        color: #64748b;
        font-size: 13px;
    }

    .bed-reported-total strong {
        color: #334155;
        margin-left: 5px;
    }

    @@media (max-width: 768px) {
        .bed-details-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            padding: 15px;
        }

        .bed-section-header {
            padding: 14px;
        }

        .bed-section-title {
            font-size: 13px;
        }

        .bed-grand-total {
            padding: 17px;
        }
    }

    @@media (max-width: 420px) {
        .bed-details-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
@section Scripts {
    <script src="~/js/verification-dashboard.js" asp-append-version="true"></script>
}

<div class="page-header mb-4">
    <h1 class="page-title">
        <i class="bi bi-hospital"></i>
        Medical UG Bed Distribution
    </h1>

    <p class="text-muted mb-0">
        Review and verify the bed distribution details.
    </p>
</div>

<div class="note-box mb-4">
    <i class="bi bi-info-circle"></i>

    <div class="note-box-content">
        <h6>Verification Instructions</h6>

        <p>
            Verify the available bed distribution against the prescribed
            norms before approving this section.
        </p>
    </div>
</div>


@{
    var bedDistributionFeedback = Model.SectionFeedback
                                ?.FirstOrDefault(x => x.SectionName == "Beds Distribution");
}
<div class="verification-card" id="section_@bedDistributionFeedback?.SectionId">

    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-hospital"></i>
            Beds Distribution
        </h3>
    </div>

    <div class="verification-card-body">

        @if (Model.PageContext.FacultyId == 2)
        {
            <!-- DENTAL -->

            <div class="bed-section-card">

                <div class="bed-section-header">
                    <div>
                        <span class="bed-section-number">01</span>
                        <span class="bed-section-title">
                            Oral and Maxillofacial Surgery
                        </span>
                    </div>
                    <span class="bed-section-subtitle">Dental</span>
                </div>

                <div class="bed-details-grid">

                    <div class="bed-detail-item">
                        <span class="bed-label">
                            Oral and Maxillofacial Surgery Beds
                        </span>
                        <span class="bed-value">
                            @(Model.OralMaxillofacialSurgery?.ToString() ?? "—")
                        </span>
                    </div>

                </div>

                <div class="bed-total-row">
                    <span>Total Beds</span>
                    <strong>@Model.DentalTotal</strong>
                </div>

            </div>
        }
        else
        {
            <!-- MEDICAL -->

            <!-- 01. MEDICINE AND ALLIED -->

            <div class="bed-section-card">

                <div class="bed-section-header">
                    <div>
                        <span class="bed-section-number">01</span>
                        <span class="bed-section-title">Medicine and Allied</span>
                    </div>
                    <span class="bed-section-subtitle">Clinical Beds</span>
                </div>

                <div class="bed-details-grid">

                    <div class="bed-detail-item">
                        <span class="bed-label">General Medicine</span>
                        <span class="bed-value">@(Model.GenMedicine?.ToString() ?? "—")</span>
                    </div>

                    <div class="bed-detail-item">
                        <span class="bed-label">Paediatrics</span>
                        <span class="bed-value">@(Model.Paediatrics?.ToString() ?? "—")</span>
                    </div>

                    <div class="bed-detail-item">
                        <span class="bed-label">Skin and VD</span>
                        <span class="bed-value">@(Model.SkinVD?.ToString() ?? "—")</span>
                    </div>

                    <div class="bed-detail-item">
                        <span class="bed-label">Psychiatry</span>
                        <span class="bed-value">@(Model.Psychiatry?.ToString() ?? "—")</span>
                    </div>

                </div>

                <div class="bed-total-row">
                    <span>Total Beds</span>
                    <strong>@Model.MedicineTotal</strong>
                </div>

            </div>


            <!-- 02. SURGERY AND ALLIED -->

            <div class="bed-section-card">

                <div class="bed-section-header">
                    <div>
                        <span class="bed-section-number">02</span>
                        <span class="bed-section-title">Surgery and Allied</span>
                    </div>
                    <span class="bed-section-subtitle">Clinical Beds</span>
                </div>

                <div class="bed-details-grid">

                    <div class="bed-detail-item">
                        <span class="bed-label">General Surgery</span>
                        <span class="bed-value">@(Model.GenSurgery?.ToString() ?? "—")</span>
                    </div>

                    <div class="bed-detail-item">
                        <span class="bed-label">Orthopaedics</span>
                        <span class="bed-value">@(Model.Orthopaedics?.ToString() ?? "—")</span>
                    </div>

                    <div class="bed-detail-item">
                        <span class="bed-label">Ophthalmology</span>
                        <span class="bed-value">@(Model.Ophthalmology?.ToString() ?? "—")</span>
                    </div>

                    <div class="bed-detail-item">
                        <span class="bed-label">ENT</span>
                        <span class="bed-value">@(Model.ENT?.ToString() ?? "—")</span>
                    </div>

                </div>

                <div class="bed-total-row">
                    <span>Total Beds</span>
                    <strong>@Model.SurgeryTotal</strong>
                </div>

            </div>


            <!-- 03. OBSTETRICS AND GYNAECOLOGY -->

            <div class="bed-section-card">

                <div class="bed-section-header">
                    <div>
                        <span class="bed-section-number">03</span>
                        <span class="bed-section-title">
                            Obstetrics and Gynaecology
                        </span>
                    </div>
                    <span class="bed-section-subtitle">Clinical Beds</span>
                </div>

                <div class="bed-details-grid">

                    <div class="bed-detail-item">
                        <span class="bed-label">Obstetrics and ANC</span>
                        <span class="bed-value">@(Model.ObstetricsANC?.ToString() ?? "—")</span>
                    </div>

                    <div class="bed-detail-item">
                        <span class="bed-label">Gynaecology</span>
                        <span class="bed-value">@(Model.Gynaecology?.ToString() ?? "—")</span>
                    </div>

                    <div class="bed-detail-item">
                        <span class="bed-label">Postpartum</span>
                        <span class="bed-value">@(Model.Postpartum?.ToString() ?? "—")</span>
                    </div>

                </div>

                <div class="bed-total-row">
                    <span>Total</span>
                    <strong>@Model.ObstetricsGynaecologyTotal</strong>
                </div>

            </div>


            <!-- CLINICAL GRAND TOTAL -->

            @* <div class="bed-grand-total">

                <div>
                    <span class="bed-grand-label">Total Clinical Beds</span>
                    <small>Medicine + Surgery + Obstetrics and Gynaecology</small>
                </div>

                <strong>@Model.ClinicalTotal</strong>

            </div> *@


            <!-- 04. OPERATION THEATRES -->

            <div class="bed-section-card">

                <div class="bed-section-header">
                    <div>
                        <span class="bed-section-number">04</span>
                        <span class="bed-section-title">Operation Theatres</span>
                    </div>
                </div>

                <div class="bed-details-grid">

                    <div class="bed-detail-item">
                        <span class="bed-label">Major OT</span>
                        <span class="bed-value">@(Model.MajorOT?.ToString() ?? "—")</span>
                    </div>

                    <div class="bed-detail-item">
                        <span class="bed-label">Minor OT</span>
                        <span class="bed-value">@(Model.MinorOT?.ToString() ?? "—")</span>
                    </div>

                </div>

                <div class="bed-total-row">
                    <span>Total Beds</span>
                    <strong>@Model.OperationTheatreTotal</strong>
                </div>

            </div>


            <!-- 05. INTENSIVE CARE -->

            <div class="bed-section-card">

                <div class="bed-section-header">
                    <div>
                        <span class="bed-section-number">05</span>
                        <span class="bed-section-title">
                            Intensive Care Facilities
                        </span>
                    </div>
                </div>

                <div class="bed-details-grid">

                    <div class="bed-detail-item">
                        <span class="bed-label">ICCU</span>
                        <span class="bed-value">@(Model.ICCU?.ToString() ?? "—")</span>
                    </div>

                    <div class="bed-detail-item">
                        <span class="bed-label">ICU</span>
                        <span class="bed-value">@(Model.ICU?.ToString() ?? "—")</span>
                    </div>

                    <div class="bed-detail-item">
                        <span class="bed-label">PICU / NICU</span>
                        <span class="bed-value">@(Model.PICU_NICU?.ToString() ?? "—")</span>
                    </div>

                    <div class="bed-detail-item">
                        <span class="bed-label">SICU</span>
                        <span class="bed-value">@(Model.SICU?.ToString() ?? "—")</span>
                    </div>

                </div>

                <div class="bed-total-row">
                    <span>Total Beds</span>
                    <strong>@(Model.TotalICUBeds?.ToString() ?? "—")</strong>
                </div>
@* 
                <div class="bed-reported-total">
                    Reported Total ICU Beds:
                    <strong>@(Model.TotalICUBeds?.ToString() ?? "—")</strong>
                </div> *@

            </div>


            <!-- 06. CASUALTY -->

            <div class="bed-section-card">

                <div class="bed-section-header">
                    <div>
                        <span class="bed-section-number">06</span>
                        <span class="bed-section-title">Casualty</span>
                    </div>
                </div>

                <div class="bed-details-grid">

                    <div class="bed-detail-item">
                        <span class="bed-label">Casualty Beds</span>
                        <span class="bed-value">@(Model.CasualtyBeds?.ToString() ?? "—")</span>
                    </div>

                </div>

                <div class="bed-total-row">
                    <span>Total Beds</span>
                    <strong>@(Model.CasualtyBeds ?? 0)</strong>
                </div>

            </div>
        }

        @if (bedDistributionFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", bedDistributionFeedback)
        }

    </div>
</div>


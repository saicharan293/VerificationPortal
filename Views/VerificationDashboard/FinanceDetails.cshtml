@model VerificationPortal.Models.Med_CA_AccountAndFeeDetailsViewModel

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Finance Details";
    ViewData["ActiveTab"] = "FinanceDetails";

    ViewData["InstitutionName"] = Model.PageContext.InstitutionName ?? "Unknown Institution";
    ViewData["CollegeCode"] = Model.PageContext.CollegeCode ?? "";
    ViewData["FacultyCode"] = Model.PageContext.FacultyId;

    ViewData["ShowFeedbackSection"] = true;

    ViewData["CurrentVerifier"] =
        User.Identity?.Name + " - " + ViewBag.UserDesignation;

    ViewData["PrevTabAction"] = Url.Action(
        "PgAcademicMatters",
        "VerificationDashboard",
        new
        {
            collegeCode = Model.PageContext.CollegeCode
        });

    ViewData["PrevTabLabel"] = "Previous : PG Academic Matters";

    ViewData["NextTabAction"] = Url.Action(
        "NextTab",
        "VerificationDashboard",
        new
        {
            collegeCode = Model.PageContext.CollegeCode
        });

    ViewData["NextTabLabel"] = "Next : Next Section";

    var courseLevel = Model.CourseLevel?.ToLower();

    var authoritySectionName = courseLevel switch
    {
        "ug" => "Authority & Account Details - UG",
        "pg" => "Authority & Account Details - PG",
        _ => null
    };

    var annualSectionName = courseLevel switch
    {
        "ug" => "Annual Financial Details - UG",
        "pg" => "Annual Financial Details - PG",
        _ => null
    };

    var accountSectionName = courseLevel switch
    {
        "ug" => "Account & Audit Details - UG",
        "pg" => "Account & Audit Details - PG",
        _ => null
    };

    var authorityFeedback = Model.SectionFeedback?.FirstOrDefault(x => x.SectionName == authoritySectionName);

    var annualFeedback = Model.SectionFeedback?.FirstOrDefault(x => x.SectionName == annualSectionName);

    var accountFeedback = Model.SectionFeedback?.FirstOrDefault(x => x.SectionName == accountSectionName);
}


<!-- =========================================================
     PAGE HEADER
========================================================= -->

<div class="verification-page-header">

    <h1 class="verification-page-title">
        Finance Details
    </h1>

    <p class="verification-page-subtitle">
        Financial, fee and account-related details of the institution
    </p>

</div>


@if (Model != null )
{
    <!-- =========================================================
            AUTHORITY & ACCOUNT DETAILS
    ========================================================== -->

    <div class="verification-card mt-4">

        <div class="verification-card-header" style="justify-content: start;">

            <h3 class="verification-card-title">
                <i class="bi bi-building"></i>
                Authority & Account Details
            </h3>
        </div>

        <div class="verification-card-body" id="section_@authorityFeedback?.SectionId">
            <div class="row g-4">
                <!-- Authority Name & Address -->
                <div class="col-12 col-md-6">
                    <div class="verification-field">
                        <label class="verification-label">
                            Authority Name & Address
                        </label>
                        <div class="verification-value">
                            @(string.IsNullOrWhiteSpace(Model.AuthorityNameAddress) ? "-" : Model.AuthorityNameAddress)
                        </div>
                    </div>
                </div>


                <!-- Authority Contact -->
                <div class="col-12 col-md-6">
                    <div class="verification-field">
                        <label class="verification-label">
                            Authority Contact
                        </label>

                        <div class="verification-value">
                            @(string.IsNullOrWhiteSpace(Model.AuthorityContact)
                                ? "-"
                                : Model.AuthorityContact)
                        </div>
                    </div>
                </div>
            </div>

            @if (authorityFeedback != null)
            {
                @await Html.PartialAsync( "_SectionFeedback", authorityFeedback )
            }

        </div>

        
    </div>

    

    <!-- =========================================================
            ANNUAL FINANCIAL DETAILS
    ========================================================== -->

    <div class="verification-card mt-4">
        <div class="verification-card-header"  id="section_@annualFeedback?.SectionId">
            <h3 class="verification-card-title">
                <i class="bi bi-currency-rupee"></i>
                Annual Financial Details
            </h3>
        </div>

        <div class="verification-card-body">
            <div class="row g-4">
                <!-- Recurrent Annual -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="verification-field">
                        <label class="verification-label">
                            Recurrent Annual
                        </label>
                        <div class="verification-value">
                            @(Model.RecurrentAnnual.HasValue ? $"₹ {Model.RecurrentAnnual.Value:N2}" : "-")
                        </div>
                    </div>
                </div>


                <!-- Non-Recurrent Annual -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="verification-field">
                        <label class="verification-label">
                            Non-Recurrent Annual
                        </label>
                        <div class="verification-value">
                            @(Model.NonRecurrentAnnual.HasValue ? $"₹ {Model.NonRecurrentAnnual.Value:N2}" : "-")
                        </div>
                    </div>
                </div>


                <!-- Deposits -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="verification-field">
                        <label class="verification-label">
                            Deposits
                        </label>
                        <div class="verification-value">
                            @(Model.Deposits.HasValue ? $"₹ {Model.Deposits.Value:N2}" : "-")
                        </div>
                    </div>
                </div>


                <!-- Tuition Fee -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="verification-field">
                        <label class="verification-label">
                            Tuition Fee
                        </label>
                        <div class="verification-value">
                            @(Model.TuitionFee.HasValue ? $"₹ {Model.TuitionFee.Value:N2}" : "-")
                        </div>
                    </div>
                </div>


                <!-- Sports Fee -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="verification-field">
                        <label class="verification-label">
                            Sports Fee
                        </label>

                        <div class="verification-value">
                            @(Model.SportsFee.HasValue ? $"₹ {Model.SportsFee.Value:N2}" : "-")
                        </div>
                    </div>
                </div>


                <!-- Union Fee -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="verification-field">
                        <label class="verification-label">
                            Union Fee
                        </label>
                        <div class="verification-value">
                            @(Model.UnionFee.HasValue ? $"₹ {Model.UnionFee.Value:N2}"  : "-")
                        </div>

                    </div>

                </div>


                <!-- Library Fee -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="verification-field">
                        <label class="verification-label">
                            Library Fee
                        </label>
                        <div class="verification-value">
                            @(Model.LibraryFee.HasValue ? $"₹ {Model.LibraryFee.Value:N2}" : "-")
                        </div>
                    </div>
                </div>


                <!-- Other Fee -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="verification-field">
                        <label class="verification-label">
                            Other Fee
                        </label>
                        <div class="verification-value">
                            @(Model.OtherFee.HasValue ? $"₹ {Model.OtherFee.Value:N2}" : "-")
                        </div>
                    </div>
                </div>


                <!-- Total Fee -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="verification-field">
                        <label class="verification-label">
                            Total Fee
                        </label>
                        <div class="verification-value fw-bold">
                            ₹ @(Model.TotalFee.ToString("N2"))
                        </div>

                    </div>

                </div>

            </div>

            @if (annualFeedback != null)
            {
                @await Html.PartialAsync( "_SectionFeedback", annualFeedback )
            }

        </div>

    </div>

    
    <!-- =========================================================
            ACCOUNT & AUDIT DETAILS
    ========================================================== -->

    <div class="verification-card mt-4">
        <div class="verification-card-header" id="section_@accountFeedback?.SectionId">
            <h3 class="verification-card-title">
                <i class="bi bi-journal-check"></i>
                Account & Audit Details
            </h3>
        </div>

        <div class="verification-card-body">
            <div class="row g-4">
                <!-- Account Books -->
                <div class="col-12 col-md-6">
                    <div class="verification-field">
                        <label class="verification-label">
                            Account Books Maintained
                        </label>

                        <div class="verification-value">

                            @if (string.Equals(Model.AccountBooksMaintained?.Trim(), "Y", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-success"> Yes </span>
                            }
                            else if (string.Equals( Model.AccountBooksMaintained?.Trim(), "N", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-danger"> No </span>
                            }
                            else
                            {
                                <span>-</span>
                            }

                        </div>
                    </div>
                </div>


                <!-- Accounts Audited -->
                <div class="col-12 col-md-6">
                    <div class="verification-field">
                        <label class="verification-label">
                            Accounts Audited
                        </label>
                        <div class="verification-value">
                            @if (string.Equals( Model.AccountsAudited?.Trim(), "Y", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-success"> Yes </span>
                            }
                            else if (string.Equals( Model.AccountsAudited?.Trim(), "N", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-danger"> No </span>
                            }
                            else
                            {
                                <span>-</span>
                            }

                        </div>
                    </div>
                </div>


                <!-- Donation - PG only -->
                @if (Model.IsPG)
                {
                    <div class="col-12 col-md-6">
                        <div class="verification-field">
                            <label class="verification-label">
                                Donation Levied
                            </label>
                            <div class="verification-value">

                                @if (string.Equals( Model.DonationLevied?.Trim(),"Y", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-success"> Yes </span>
                                }
                                else if (string.Equals( Model.DonationLevied?.Trim(), "N", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-danger"> No </span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>


            <div class="row g-4 mt-1">
                <!-- Governing Council -->
                <div class="col-12 col-md-6">
                    <div class="verification-field">
                        <label class="verification-label">
                            Governing Council Document
                        </label>

                        <div class="verification-value">
                            @if (!string.IsNullOrWhiteSpace(Model.GoverningCouncilPdfName))
                            {
                                @await Html.PartialAsync(
                                    "_DocumentViewerButton",
                                    new DocumentViewerVm
                                    {
                                        Url = Url.Action(
                                            "ViewGoverningCouncilDocument",
                                            "VerificationDashboard",
                                            new
                                            {
                                                collegeCode = Model.CollegeCode,
                                                courseLevel = Model.CourseLevel,
                                                facultyCode = Model.FacultyCode
                                            })!,
                                        Title = "Governing Council Document"
                                    })
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Not Uploaded
                                </span>
                            }

                        </div>
                    </div>
                </div>


                <!-- Account Summary -->
                <div class="col-12 col-md-6">
                    <div class="verification-field">
                        <label class="verification-label">
                            Account Summary
                        </label>
                        <div class="verification-value">
                            @if (!string.IsNullOrWhiteSpace(Model.AccountSummaryPdfName))
                            {
                                @await Html.PartialAsync(
                                    "_DocumentViewerButton",
                                    new DocumentViewerVm
                                    {
                                        Url = Url.Action(
                                            "ViewAccountSummaryPdf",
                                            "VerificationDashboard",
                                            new
                                            {
                                                collegeCode = Model.CollegeCode,
                                                courseLevel = Model.CourseLevel,
                                                facultyCode = Model.FacultyCode
                                            })!,
                                        Title = "Account Summary"
                                    })
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Not Uploaded
                                </span>
                            }

                        </div>

                    </div>

                </div>


                <!-- Audited Statement -->
                <div class="col-12 col-md-6">
                    <div class="verification-field">
                        <label class="verification-label">
                            Audited Statement
                        </label>

                        <div class="verification-value">

                            @if (!string.IsNullOrWhiteSpace(Model.AuditedStatementPdfName))
                            {
                                @await Html.PartialAsync(
                                    "_DocumentViewerButton",
                                    new DocumentViewerVm
                                    {
                                        Url = Url.Action(
                                            "ViewAuditedStatementPdf",
                                            "VerificationDashboard",
                                            new
                                            {
                                                collegeCode = Model.CollegeCode,
                                                courseLevel = Model.CourseLevel,
                                                facultyCode = Model.FacultyCode
                                            })!,
                                        Title = "Audited Statement"
                                    })
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Not Uploaded
                                </span>
                            }

                        </div>
                    </div>
                </div>


                <!-- Donation - PG Only -->
                @if (Model.IsPG)
                {
                    <div class="col-12 col-md-6">

                        <div class="verification-field">

                            <label class="verification-label">
                                Donation Document
                            </label>

                            <div class="verification-value">

                                @if (!string.IsNullOrWhiteSpace(Model.DonationPdfName))
                                {
                                    @await Html.PartialAsync(
                                        "_DocumentViewerButton",
                                        new DocumentViewerVm
                                        {
                                            Url = Url.Action(
                                                "ViewDonationPdf",
                                                "VerificationDashboard",
                                                new
                                                {
                                                    collegeCode = Model.CollegeCode,
                                                    courseLevel = Model.CourseLevel,
                                                    facultyCode = Model.FacultyCode
                                                })!,
                                            Title = "Donation Document"
                                        })
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Not Uploaded
                                    </span>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>

            @if (accountFeedback != null)
            {
                @await Html.PartialAsync( "_SectionFeedback", accountFeedback )
            }

        </div>

    </div>


    <!-- =========================================================
            SUPPORTING DOCUMENTS
    ========================================================== -->

}
else
{
    <!-- =========================================================
         NO DATA
    ========================================================== -->

    <div class="verification-card mt-4">
        <div class="verification-card-body">
            <div class="alert alert-warning mb-0">
                <i class="bi bi-exclamation-triangle me-2"></i>
                No finance details available for this institution.
            </div>
        </div>
    </div>
}


@section Scripts {
    <script src="~/js/verification-dashboard.js"
            asp-append-version="true"></script>
}
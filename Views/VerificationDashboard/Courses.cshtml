
@model VerificationPortal.Models.Verification.AcademicIntakeVerificationVm

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Courses and Intake";
    ViewData["ActiveTab"] = "Courses";
    ViewData["ShowFeedbackSection"] = true;

    var page = Model?.PageContext;

    ViewData["InstitutionName"] = page?.InstitutionName ?? "Unknown Institution";
    ViewData["CollegeCode"] = page?.CollegeCode ?? "";
    ViewData["FacultyCode"] = page?.FacultyId.ToString() ?? "";
    ViewData["FacultyName"] = page?.FacultyName ?? "";
    ViewData["CurrentVerifier"] = page?.CurrentVerifier ?? "";

    ViewData["PrevTabAction"] = page?.PrevTabAction;
    ViewData["PrevTabLabel"] = page?.PrevTabLabel;
    ViewData["NextTabAction"] = page?.NextTabAction;
    ViewData["NextTabLabel"] = page?.NextTabLabel;

    ViewData["CompletedTabNames"] = page?.CompletedTabNames;
    ViewData["TabwiseVerification"] = Model?.TabwiseVerification;

    var courseFeedback = Model?.SectionFeedback?
        .FirstOrDefault(x => string.Equals(
            x.SectionName,
            "Courses and Intake",
            StringComparison.OrdinalIgnoreCase));

    var totalCourses = (Model?.UgCourses?.Count ?? 0)
                     + (Model?.PgCourses?.Count ?? 0)
                     + (Model?.SsCourses?.Count ?? 0);

    var totalSaved = Model?.SavedIntakes?.Count ?? 0;

    var courseGroups = new[]
    {
        new { Name = "Undergraduate Courses", Code = "UG", Courses = Model?.UgCourses },
        new { Name = "Postgraduate Courses", Code = "PG", Courses = Model?.PgCourses },
        new { Name = "Super Speciality Courses", Code = "SS", Courses = Model?.SsCourses }
    };
}

<div class="container-fluid px-3 px-md-4 py-3">

    <!-- PAGE HEADER -->
    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="rounded-3 bg-primary bg-opacity-10 p-3">
            <i class="bi bi-journal-bookmark-fill text-primary fs-3"></i>
        </div>

        <div>
            <h4 class="fw-bold mb-1">Courses and Intake</h4>
            <p class="text-muted mb-0">
                Review submitted courses, academic intake and supporting documents.
            </p>
        </div>
    </div>

    <!-- INSTITUTION SUMMARY -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3">
            <h5 class="fw-bold mb-0 text-primary">
                <i class="bi bi-building me-2"></i>
                Institution Summary
            </h5>
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="text-muted small mb-1">Institution Name</div>
                    <div class="fw-semibold">@(page?.InstitutionName ?? "—")</div>
                </div>

                <div class="col-md-4">
                    <div class="text-muted small mb-1">College Code</div>
                    <div class="fw-semibold">@(page?.CollegeCode ?? "—")</div>
                </div>

                <div class="col-md-4">
                    <div class="text-muted small mb-1">Faculty</div>
                    <div class="fw-semibold">@(page?.FacultyName ?? "—")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary bg-opacity-10 p-3">
                        <i class="bi bi-book text-primary fs-4"></i>
                    </div>
                    <div>
                        <div class="small text-muted">Total Courses</div>
                        <h4 class="fw-bold mb-0">@totalCourses</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-success bg-opacity-10 p-3">
                        <i class="bi bi-database-check text-success fs-4"></i>
                    </div>
                    <div>
                        <div class="small text-muted">Saved Intake Records</div>
                        <h4 class="fw-bold mb-0">@totalSaved</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-info bg-opacity-10 p-3">
                        <i class="bi bi-layers text-info fs-4"></i>
                    </div>
                    <div>
                        <div class="small text-muted">Course Levels</div>
                        <h4 class="fw-bold mb-0">
                            @courseGroups.Count(g => g.Courses?.Any() == true)
                        </h4>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- COURSE DETAILS -->
    @foreach (var group in courseGroups)
    {
        var courses = group.Courses ?? new();

        if (!courses.Any())
        {
            continue;
        }

        <div class="card border-0 shadow-sm mb-4">

            <div class="card-header bg-transparent border-bottom py-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h5 class="fw-bold text-primary mb-1">
                            <i class="bi bi-book-half me-2"></i>
                            @group.Name
                        </h5>
                        <small class="text-muted">
                            Academic year-wise intake and supporting documents
                        </small>
                    </div>

                    <span class="badge text-primary px-3 py-2">
                        @courses.Count Courses
                    </span>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">

                        <thead class="table-light text-center">
                            <tr>
                                <th rowspan="2">Sl.No</th>
                                <th rowspan="2">Course Name</th>

                                <th colspan="6">AY 2025-26</th>
                                <th colspan="4">AY 2026-27</th>
                            </tr>

                            <tr>
                                <!-- AY 2025-26 -->
                                <th>Existing</th>
                                <th>LoP/NMC</th>
                                <th>Total</th>
                                <th>LoP Date</th>
                                <th>LoP Doc</th>
                                <th>DCI</th>
                                @* <th>KSDC</th> *@

                                <!-- AY 2026-27 -->
                                <th>Existing</th>
                                <th>Total</th>
                                <th>DCI</th>
                            </tr>
                        </thead>

                        <tbody>
                            @for (int i = 0; i < courses.Count; i++)
                            {
                                var course = courses[i];

                                <tr>
                                    <td class="text-center">@(i + 1)</td>

                                    <td class="fw-semibold">
                                        @course.CourseName
                                    </td>

                                    <!-- AY 2025-26 -->
                                    <td class="text-center">
                                        @(course.AY2025_ExistingIntake?.ToString() ?? "—")
                                    </td>
                                    <td class="text-center">
                                        @(course.AY2025_LopNmcIntake?.ToString() ?? "—")
                                    </td>
                                    <td class="text-center fw-bold text-primary">
                                        @(course.AY2025_TotalIntake?.ToString() ?? "—")
                                    </td>
                                    <td class="text-center">
                                        @(course.AY2025_LopDate?.ToString("dd-MMM-yyyy") ?? "—")
                                    </td>
                                    <td class="text-center">
                                        @if (course.HasLopDocument)
                                        {
                                            @await Html.PartialAsync(
                                                "_DocumentViewerButton",
                                                new DocumentViewerVm
                                                {
                                                    Url = Url.Action(
                                                        "ViewAcademicIntakeDocument",
                                                        "VerificationDashboard",
                                                        new
                                                        {
                                                            id = course.Id,
                                                            docType = "LOPDENTAL2025"
                                                        })!,
                                                    Title = "LoP Document - AY 2025-26",
                                                    DocumentId = course.Id,
                                                    FacultyId = Convert.ToInt32(Model.FacultyCode),
                                                    CollegeCode = Model.PageContext.CollegeCode
                                                })
                                        }
                                        else
                                        {
                                            <span class="badge text-danger">Missing</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (course.HasAY2025DciDocument)
                                        {
                                            @await Html.PartialAsync(
                                                "_DocumentViewerButton",
                                                new DocumentViewerVm
                                                {
                                                    Url = Url.Action(
                                                        "ViewAcademicIntakeDocument",
                                                        "VerificationDashboard",
                                                        new
                                                        {
                                                            id = course.Id,
                                                            docType = "DCI2025"
                                                        })!,
                                                    Title = "DCI Document - AY 2025-26",
                                                    DocumentId = course.Id,
                                                    FacultyId = Convert.ToInt32(Model.FacultyCode),
                                                    CollegeCode = Model.CollegeCode
                                                })
                                        }
                                        else
                                        {
                                            <span class="badge text-danger">Missing</span>
                                        }
                                    </td>
                                    @* <td class="text-center">
                                        <span class="badge @(course.HasAY2025KsdcDocument ? " text-success" : "text-danger")">
                                            @(course.HasAY2025KsdcDocument ? "Available" : "Missing")
                                        </span>
                                    </td> *@

                                    <!-- AY 2026-27 -->
                                    <td class="text-center">
                                        @(course.AY2026_ExistingIntake?.ToString() ?? "—")
                                    </td>
                                    <td class="text-center fw-bold text-primary">
                                        @(course.AY2026_TotalIntake?.ToString() ?? "—")
                                    </td>
                                    <td class="text-center">
                                        @if (course.HasAY2026DciDocument)
                                        {
                                            @await Html.PartialAsync(
                                                "_DocumentViewerButton",
                                                new DocumentViewerVm
                                                {
                                                    Url = Url.Action(
                                                        "ViewAcademicIntakeDocument",
                                                        "VerificationDashboard",
                                                        new
                                                        {
                                                            id = course.Id,
                                                            docType = "DCI2026"
                                                        })!,
                                                    Title = "DCI Document - AY 2026-27",
                                                    DocumentId = course.Id,
                                                    FacultyId = Convert.ToInt32(Model.FacultyCode),
                                                    CollegeCode = Model.PageContext.CollegeCode
                                                })
                                        }
                                        else
                                        {
                                            <span class="badge text-danger">Missing</span>
                                        }
                                    </td>

                                    <!-- Hidden (no header): 2026 Requested, NMC, AY 2027-28 -->
                                    @*
                                    <td class="text-center">
                                        @(course.AY2026_AddRequestedIntake?.ToString() ?? "—")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(course.HasNmcDocument ? " text-success" : "text-danger")">
                                            @(course.HasNmcDocument ? "Available" : "Missing")
                                        </span>
                                    </td>
                                    *@
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        </div>
    }

    <!-- EMPTY STATE -->
    @if (totalCourses == 0 && totalSaved == 0)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body text-center py-5">
                <i class="bi bi-journal-x text-secondary fs-1"></i>
                <h5 class="fw-bold mt-3">No Course Details Available</h5>
                <p class="text-muted mb-0">
                    No academic intake records have been submitted by this institution.
                </p>
            </div>
        </div>
    }

    <!-- SECTION VERIFICATION FEEDBACK -->
    @if (courseFeedback != null)
    {
        <div class="card border-0 shadow-sm mb-4">

            <div class="card-header bg-transparent border-bottom py-3">
                <h5 class="fw-bold mb-0 text-primary">
                    <i class="bi bi-chat-left-text me-2"></i>
                    Verification Feedback
                </h5>
            </div>

            <div class="card-body">
                <p class="text-muted small mb-3">
                    Review the course and intake information and provide your verification remarks.
                </p>

                @await Html.PartialAsync("_SectionFeedback", courseFeedback)
            </div>

        </div>
    }

</div>

@section Scripts {
    <script src="~/js/verification-dashboard.js" asp-append-version="true"></script>
}

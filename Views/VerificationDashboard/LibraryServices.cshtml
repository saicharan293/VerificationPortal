
@model VerificationPortal.Models.MedicalLibraryVerificationViewModel

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Library Services";
    ViewData["ActiveTab"] = "LibraryServices";

    ViewData["InstitutionName"] = Model.PageContext.InstitutionName ?? "Unknown Institution";

    ViewData["CollegeCode"] = Model.PageContext.CollegeCode ?? "";

    ViewData["FacultyCode"] = Model.PageContext.FacultyId;

    ViewData["ShowFeedbackSection"] = true;

    ViewData["CurrentVerifier"] = User.Identity?.Name + " - " + Model.PageContext.CurrentVerifier;

    ViewData["PrevTabAction"] = Url.Action( "StaffOtherDetails", "VerificationDashboard", new { collegeCode = ViewBag.CollegeCode });

    ViewData["PrevTabLabel"] = "Previous : Staff Other Details";

    ViewData["NextTabAction"] = Url.Action( "NextTab", "VerificationDashboard", new { collegeCode = ViewBag.CollegeCode } );

    ViewData["NextTabLabel"] = "Next : Next Section";

    bool isDentalFaculty = ViewBag.IsDentalFaculty == true;
    bool isMedicalFaculty = ViewBag.IsMedicalFaculty == true;

    var departmentMasters =
        ViewBag.DepartmentMasters
        as List<VerificationPortal.Models.DepartmentMaster>
        ?? new List<VerificationPortal.Models.DepartmentMaster>();
}
<style>
    .department-library-scroll {
        max-height: 450px;
        overflow-y: auto;
        overflow-x: auto;
        position: relative;
    }

    /* Keep table headers visible while scrolling */
    .department-library-scroll thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background-color: #f8f9fa;
    }

    /* Optional scrollbar styling */
    .department-library-scroll::-webkit-scrollbar {
        width: 7px;
        height: 7px;
    }

    .department-library-scroll::-webkit-scrollbar-thumb {
        background-color: #b8c1cc;
        border-radius: 10px;
    }

    .department-library-scroll::-webkit-scrollbar-track {
        background-color: #f1f3f5;
    }
</style>


<div class="verification-page-header">

    <h2 class="verification-page-title">
        Library Services
    </h2>

    <p class="verification-page-subtitle">
        Library and departmental library details
    </p>

</div>


@{
    var libraryServicesFeedback = Model.SectionFeedback?
        .FirstOrDefault(x => x.SectionName == "Library Services");
}

@if (isMedicalFaculty)
{    
    <div class="verification-card mt-4" id="section_@libraryServicesFeedback?.SectionId">

        <div class="verification-card-header">
            <h3 class="verification-card-title">
                <i class="bi bi-journal-bookmark me-2"></i>
                Library Services
            </h3>

            <span class="badge bg-primary">
                Common
            </span>
        </div>

        <div class="verification-card-body">

            @if (Model.LibraryServices.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">

                        <thead>
                            <tr>
                                <th style="width:70px">Sl. No</th>
                                <th>Library Service</th>
                                <th style="width:150px">Availability</th>
                                <th>Uploaded Document</th>
                            </tr>
                        </thead>

                        <tbody>
                            @for (int i = 0; i < Model.LibraryServices.Count; i++)
                            {
                                var service = Model.LibraryServices[i];

                                <tr>
                                    <td>@(i + 1)</td>

                                    <td>
                                        <strong>@service.ServiceName</strong>
                                    </td>

                                    <td>
                                        @if (service.IsAvailable == "Yes")
                                        {
                                            <span class="badge bg-success">Available</span>
                                        }
                                        else if (service.IsAvailable == "No")
                                        {
                                            <span class="badge bg-danger">Not Available</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Specified</span>
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(service.UploadedFileName))
                                        {
                                            @await Html.PartialAsync(
                                                "_DocumentViewerButton",
                                                new DocumentViewerVm
                                                {
                                                    Url = Url.Action(
                                                        "ViewLibraryServiceDocument",
                                                        "VerificationDashboard",
                                                        new
                                                        {
                                                            collegeCode = Model.CollegeCode,
                                                            serviceId = service.ServiceId
                                                        })!,
                                                    Title = service.ServiceName
                                                })
                                        }
                                        else
                                        {
                                            <span class="text-muted">No document uploaded</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    No library services available.
                </div>
            }

            @if (libraryServicesFeedback != null)
            {
                @await Html.PartialAsync( "_SectionFeedback", libraryServicesFeedback)
            }

        </div>
    </div>
}

@{
    var usageReportFeedback = Model.SectionFeedback?
        .FirstOrDefault(x => x.SectionName == "Usage Report");
}
@if (isMedicalFaculty)
{
    <div class="verification-card mt-4" id="section_@usageReportFeedback?.SectionId">

        <div class="verification-card-header">
            <h3 class="verification-card-title">
                <i class="bi bi-file-earmark-pdf me-2"></i>
                Library Usage Report
            </h3>
        </div>

        <div class="verification-card-body">

            @if (!string.IsNullOrWhiteSpace(Model.UsageReportFileName))
            {
                @await Html.PartialAsync(
                    "_DocumentViewerButton",
                    new DocumentViewerVm
                    {
                        Url = Url.Action(
                            "ViewLibraryUsageReport",
                            "VerificationDashboard",
                            new
                            {
                                collegeCode = Model.CollegeCode
                            })!,
                        Title = "Library Usage Report"
                    })
            }
            else
            {
                <div class="text-center text-muted py-3">
                    No usage report uploaded.
                </div>
            }
        </div>
    </div>
}
@{
    var libraryStaffFeedback = Model.SectionFeedback?
        .FirstOrDefault(x => x.SectionName == "Library Staff Details");
}
@if (isMedicalFaculty)
{
<div class="verification-card mt-4" id="section_@libraryStaffFeedback?.SectionId">

    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-people me-2"></i>
            Library Staff Details
        </h3>
    </div>

    <div class="verification-card-body">

        @if (Model.LibraryStaff.Any())
        {
            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Sl. No</th>
                            <th>Staff Name</th>
                            <th>Designation</th>
                            <th>Qualification</th>
                            <th>Experience</th>
                            <th>Category</th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = 0; i < Model.LibraryStaff.Count; i++)
                        {
                            var staff = Model.LibraryStaff[i];

                            <tr>
                                <td>@(i + 1)</td>
                                <td><strong>@staff.StaffName</strong></td>
                                <td>@staff.Designation</td>
                                <td>@staff.Qualification</td>
                                <td>@staff.Experience Years</td>
                                <td>@staff.Category</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">
                No library staff details available.
            </div>
        }

        @if (libraryStaffFeedback != null)
        {
            @await Html.PartialAsync( "_SectionFeedback", libraryStaffFeedback)
        }

    </div>
</div>
}
@if (isMedicalFaculty && Model.OtherDetails != null)
{
    var other = Model.OtherDetails;

    var otherDetailsFeedback = Model.SectionFeedback?
        .FirstOrDefault(x => x.SectionName == "Digital Valuation Centre");

    <div class="verification-card mt-4" id="section_@otherDetailsFeedback.SectionId">

        <div class="verification-card-header">
            <h3 class="verification-card-title">
                <i class="bi bi-pc-display me-2"></i>
                Digital Valuation Centre
            </h3>
        </div>

        <div class="verification-card-body">

            <div class="table-responsive">

                <table class="table table-bordered align-middle">

                    <tbody>

                        <tr>
                            <th style="width:50%">
                                Digital Valuation Centre
                            </th>
                            <td>
                                @if (other.HasDigitalValuationCentre == "Yes")
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @(other.HasDigitalValuationCentre ?? "Not Specified")
                                    </span>
                                }
                            </td>
                        </tr>

                        @if (other.HasDigitalValuationCentre == "Yes")
                        {
                            <tr>
                                <th>Number of Systems</th>
                                <td>@(other.NoOfSystems?.ToString() ?? "-")</td>
                            </tr>

                            <tr>
                                <th>Stable Internet Connection</th>
                                <td>@(other.HasStableInternet ?? "-")</td>
                            </tr>

                            <tr>
                                <th>CCTV Camera System</th>
                                <td>@(other.HasCccameraSystem ?? "-")</td>
                            </tr>
                        }

                        <tr>
                            <th>Special Features / Achievements</th>
                            <td>
                                @if (other.SpecialFeaturesQuestion == "Yes")
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                        </tr>

                        @if (!string.IsNullOrWhiteSpace(other.UploadedFileName))
                        {
                            <tr>
                                <th>Uploaded Document</th>
                                <td>
                                    <i class="bi bi-file-pdf text-danger me-2"></i>
                                    @other.UploadedFileName
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (otherDetailsFeedback != null)
            {
                @await Html.PartialAsync(
                    "_SectionFeedback",
                    otherDetailsFeedback)
            }

        </div>
    </div>
}

@* ============================================================
   DEPARTMENT LIBRARY DETAILS
   ============================================================ *@

@{
    var deptLibraryDetailsFeedback = Model.SectionFeedback
                                ?.FirstOrDefault(x => x.SectionName == "Department Library Details");
}

<div class="verification-card mt-4" id="section_@deptLibraryDetailsFeedback?.SectionId">

    <div class="verification-card-header">

        <h3 class="verification-card-title">
            <i class="bi bi-book me-2"></i>
            Department Library Details
        </h3>

        <span class="badge bg-primary">
            @(isDentalFaculty ? "Dental" : "Medical")
        </span>

    </div>


    <div class="verification-card-body">

        @if (Model.DepartmentLibraries != null && Model.DepartmentLibraries.Any())
        {
            <div class="table-responsive department-library-scroll">

                <table class="table table-bordered table-hover align-middle">

                    <thead>
                        <tr>

                            <th> Sl. No </th>
                            <th> Department </th>
                            <th> Total Books </th>
                            <th> Books Added This Year </th>
                            <th> Current Journals </th>

                            @if (isDentalFaculty)
                            {
                                <th> Titles </th>
                                <th> International Journals </th>
                                <th> Back Volumes </th>
                                <th> Print Journal % </th>
                            }

                            <th> Library Staff </th>

                        </tr>
                    </thead>


                    <tbody>

                        @for (int i = 0;  i < Model.DepartmentLibraries.Count; i++)
                        {
                            var row = Model.DepartmentLibraries[i];

                            var departmentName =
                                departmentMasters
                                    .FirstOrDefault(x =>
                                        x.DepartmentCode ==
                                        row.DepartmentCode)
                                    ?.DepartmentName
                                ?? row.DepartmentCode
                                ?? "-";


                            <tr>

                                <td>
                                    @(i + 1)
                                </td>


                                <td>
                                    <strong>
                                        @departmentName
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace( row.DepartmentCode))
                                    {
                                        <div class="small text-muted">
                                            @row.DepartmentCode
                                        </div>
                                    }
                                </td>


                                <td> @row.TotalBooks </td>


                                <td> @row.BooksAddedInYear </td>


                                <td> @row.CurrentJournals </td>


                                @if (isDentalFaculty)
                                {
                                    <td> @(row.Titles?.ToString() ?? "-")</td>
                                    <td> @(row.InternationalJournals?.ToString() ?? "-")</td>
                                    <td> @(row.BackVolumes?.ToString() ?? "-") </td>
                                    <td> @(row.PrintJournalPercentage?.ToString() ?? "-") </td>
                                }


                                <td>

                                    @if (!string.IsNullOrWhiteSpace( row.LibraryStaff1))
                                    {
                                        <div>
                                            <strong>Staff 1:</strong>
                                            @row.LibraryStaff1
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(row.LibraryStaff2))
                                    {
                                        <div class="mt-1">
                                            <strong>Staff 2:</strong>
                                            @row.LibraryStaff2
                                        </div>
                                    }

                                    @if (string.IsNullOrWhiteSpace(row.LibraryStaff1) &&
                                        string.IsNullOrWhiteSpace(row.LibraryStaff2))
                                    {
                                        <span>-</span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-muted text-center py-4">

                <i class="bi bi-info-circle me-2"></i>

                No departmental library details available.

            </div>
        }



        
        @if (deptLibraryDetailsFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", deptLibraryDetailsFeedback)
        }

    </div>

</div>



@* ============================================================
   DENTAL LIBRARY RECORDS
   ============================================================ *@

@if (isDentalFaculty)
{
    <div class="verification-card mt-4"  id="section_@deptLibraryDetailsFeedback?.SectionId">

        <div class="verification-card-header">

            <h3 class="verification-card-title">
                <i class="bi bi-folder-check me-2"></i>
                Library Records
            </h3>

            <span class="badge bg-primary">
                Dental Library
            </span>

        </div>


        <div class="verification-card-body">

            @if (Model.DentalLibraryRecords != null && Model.DentalLibraryRecords.Any())
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Sl. No</th>
                                <th>Record</th>
                                <th>Uploaded File</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @for (int i = 0; i < Model.DentalLibraryRecords.Count; i++)
                            {
                                var record = Model.DentalLibraryRecords[i];

                                <tr>

                                    <td> @(i + 1) </td>

                                    <td>
                                        <strong> @record.RecordName </strong>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(record.ExistingFileName))
                                        {
                                            <span> @record.ExistingFileName </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted"> No file uploaded </span>
                                        }
                                    </td>

                                    <td class="text-center">

                                        @if (!string.IsNullOrWhiteSpace(record.ExistingFileName))
                                        {
                                            @await Html.PartialAsync(
                                                "_DocumentViewerButton",
                                                new DocumentViewerVm
                                                {
                                                    Url = Url.Action(
                                                        "ViewDentalLibraryRecord",
                                                        "VerificationDashboard",
                                                        new
                                                        {
                                                            collegeCode = Model.CollegeCode,
                                                            recordId = record.RecordId
                                                        })!,
                                                    Title = record.RecordName
                                                })
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-muted text-center py-4">

                    <i class="bi bi-info-circle me-2"></i>

                    No library records available.

                </div>
            }

        </div>

    </div>
}

@{
    var specialFeaturesFeedback = Model.SectionFeedback
                                ?.FirstOrDefault(x => x.SectionName == "Special Features");
}

@if (ViewBag.IsMedicalFaculty && Model.OtherDetails != null)
{
    
    <div class="verification-card mb-4" id="section_@specialFeaturesFeedback?.SectionId">

        <div class="verification-card-header">
            <h5>Special Features</h5>
        </div>

        <div class="verification-card-body">
            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Special Features / Achievements
                    </label>

                    <div>
                        @(Model.OtherDetails.SpecialFeaturesQuestion ?? "Not Available")
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Supporting Document
                    </label>

                    @if (!string.IsNullOrWhiteSpace(Model.OtherDetails.UploadedFileName))
                    {
                        @await Html.PartialAsync(
                            "_DocumentViewerButton",
                            new DocumentViewerVm
                            {
                                Url = Url.Action(
                                    "ViewLibrarySpecialFeaturesDocument",
                                    "VerificationDashboard",
                                    new
                                    {
                                        collegeCode = Model.CollegeCode
                                    })!,
                                Title = "Special Features / Achievements"
                            })
                    }
                    else
                    {
                        <span class="text-muted">No document uploaded</span>
                    }
                </div>

            </div>

            @if (specialFeaturesFeedback != null)
            {
                @await Html.PartialAsync("_SectionFeedback", specialFeaturesFeedback)
            }
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/verification-dashboard.js" asp-append-version="true"></script>
}

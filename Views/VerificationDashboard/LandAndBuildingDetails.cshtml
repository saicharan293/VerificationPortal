@model VerificationPortal.Models.DentalLandBuildingVerificationVm

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Land And Building Details - Verification Dashboard";
    ViewData["ActiveTab"] = "LandAndBuildingDetails";

    ViewData["InstitutionName"] = Model.PageContext.InstitutionName ?? "Unknown Institution";
    ViewData["CollegeCode"] = Model.PageContext.CollegeCode ?? "";
    ViewData["FacultyName"] = Model.PageContext.FacultyName ?? "";

    ViewData["ShowFeedbackSection"] = true;
    ViewData["CurrentVerifier"] = Model.PageContext.CurrentVerifier ?? User.Identity?.Name;

    ViewData["PrevTabAction"] = Model.PageContext.PrevTabAction;
    ViewData["PrevTabLabel"] = Model.PageContext.PrevTabLabel ?? "Previous: PG Course Details";

    ViewData["NextTabAction"] = Model.PageContext.NextTabAction;
    ViewData["NextTabLabel"] = Model.PageContext.NextTabLabel ?? "Next: Classroom And Laboratory";

    var landBuilding = Model.LandBuilding;
}

@section Scripts {
    <script src="~/js/verification-dashboard.js" asp-append-version="true"></script>
}

<!-- Page Header -->
<div class="page-header mb-4">
    <h1 class="page-title">
        <i class="bi bi-building"></i>
        Land And Building Details
    </h1>
    <p class="text-muted mb-0">
        Review and verify the institution's land and building information.
    </p>
</div>

<!-- Note -->
<div class="note-box mb-4">
    <i class="bi bi-info-circle"></i>
    <div class="note-box-content">
        <h6>Verification Instructions</h6>
        <p>
            Verify the land ownership, building approvals, statutory certificates,
            teaching areas and supporting documents before accepting or rejecting
            this section.
        </p>
    </div>
</div>

<div class="verification-card">

    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-building"></i>
            Land And Building Details
        </h3>
    </div>

    <div class="verification-card-body">

        <!-- Land Details -->

        @await Html.PartialAsync("~/Views/VerificationDashboard/Partials/LandAndBuildingDetails/Dental/_LandDetails.cshtml", Model)


        @if (Model.LandFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", Model.LandFeedback)
        }

        <!-- Documents -->

        @await Html.PartialAsync( "~/Views/VerificationDashboard/Partials/LandAndBuildingDetails/Dental/_LandDocuments.cshtml", Model)

        <!-- Building -->

        @await Html.PartialAsync( "~/Views/VerificationDashboard/Partials/LandAndBuildingDetails/Dental/_BuildingDetails.cshtml", Model)

        @if (Model.BuildingFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", Model.BuildingFeedback)
        }

        @await Html.PartialAsync( "~/Views/VerificationDashboard/Partials/LandAndBuildingDetails/Dental/_BuildingDocuments.cshtml", Model)
    </div>

    

</div>
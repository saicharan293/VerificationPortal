@model VerificationPortal.Models.DentalCollegeLandBuildingDetail


@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Land & Building Details - Verification Dashboard";
    ViewData["ActiveTab"] = "LandAndBuildingDetails";
    ViewData["InstitutionName"] = ViewBag.InstitutionName ?? "Unknown Institution";
    ViewData["CollegeCode"] = ViewBag.CollegeCode ?? "";
    ViewData["FacultyName"] = ViewBag.FacultyName ?? "";

    ViewData["ShowFeedbackSection"] = true;
    ViewData["CurrentVerifier"] = User.Identity?.Name + " - " + ViewBag.UserDesignation;

    ViewData["PrevTabAction"] = Url.Action(
        "PgCourseDetails",
        "VerificationDashboard",
        new { collegeCode = ViewBag.CollegeCode });

    ViewData["PrevTabLabel"] = "Previous: PG Course Details";

    ViewData["NextTabAction"] = Url.Action(
        "ClassroomAndLaboratory",
        "VerificationDashboard",
        new { collegeCode = ViewBag.CollegeCode });

    ViewData["NextTabLabel"] = "Next: Classroom & Laboratory";

    var sectionFeedback =
        ViewBag.SectionFeedback
        as List<VerificationPortal.Models.SectionFeedbackViewModel>
        ?? new List<VerificationPortal.Models.SectionFeedbackViewModel>();

    var landFeedback =
        sectionFeedback.FirstOrDefault(x => x.SectionId == 25);

    var buildingFeedback =
        sectionFeedback.FirstOrDefault(x => x.SectionId == 26);

    var landDocuments = new[]
    {
        new
        {
            Label = "Sale Deed",
            Path = Model.SaleDeedDocumentPath,
            DocumentType = "SaleDeed",
            Action = "ViewSaleDeedDocument",
        },
        new
        {
            Label = "Encumbrance Certificate",
            Path = Model.EncumbranceCertificateDocumentPath,
            DocumentType = "EncumbranceCertificate",
            Action = "ViewEncumbranceCertificate",
        },
        new
        {
            Label = "Land Use Certificate",
            Path = Model.LandUseCertificateDocumentPath,
            DocumentType = "LandUseCertificate",
            Action = "ViewLandBuildingDocument",
        },
        new
        {
            Label = "Approved Layout Plan",
            Path = Model.ApprovedLayoutPlanDocumentPath,
            DocumentType = "ApprovedLayoutPlan",
            Action = "ViewLandBuildingDocument",
        },
        new
        {
            Label = "Land Sketch",
            Path = Model.LandSketchDocumentPath,
            DocumentType = "LandSketch",
            Action = "ViewLandBuildingDocument",
        },
        new
        {
            Label = "Distance Certificate",
            Path = Model.DistanceCertificateDocumentPath,
            DocumentType = "DistanceCertificate",
            Action = "ViewLandBuildingDocument",
        }
    };

    var buildingDocuments = new[]
    {
        new
        {
            Label = "Completion Certificate",
            Path = Model.CompletionCertificateDocumentPath,
            DocumentType = "CompletionCertificate"
        },
        new
        {
            Label = "Structural Stability Certificate",
            Path = Model.StructuralStabilityCertificateDocumentPath,
            DocumentType = "StructuralStabilityCertificate"
        },
        new
        {
            Label = "Fire Safety NOC",
            Path = Model.FireSafetyNocDocumentPath,
            DocumentType = "FireSafetyNoc"
        },
        new
        {
            Label = "Lift License",
            Path = Model.LiftLicenseDocumentPath,
            DocumentType = "LiftLicense"
        },
        new
        {
            Label = "Electrical Safety Certificate",
            Path = Model.ElectricalSafetyCertificateDocumentPath,
            DocumentType = "ElectricalSafetyCertificate"
        },
        new
        {
            Label = "Water Supply Certificate",
            Path = Model.WaterSupplyCertificateDocumentPath,
            DocumentType = "WaterSupplyCertificate"
        },
        new
        {
            Label = "Sewage / Sanitation Approval",
            Path = Model.SewageSanitationApprovalDocumentPath,
            DocumentType = "SewageSanitationApproval"
        }
    };
}

@section Scripts {
    <script src="~/js/verification-dashboard.js" asp-append-version="true"></script>
}

<!-- Page Header -->
<div class="page-header mb-4">
    <h1 class="page-title">
        <i class="bi bi-building"></i>
        Land & Building Details
    </h1>
    <p class="text-muted mb-0">
        Review and verify the institution's land and building information.
    </p>
</div>

<!-- Note -->
<div class="note-box mb-4">
    <i class="bi bi-info-circle"></i>
    <div class="note-box-content">
        <h6>Verification Instructions</h6>
        <p>
            Verify the land ownership, building approvals, statutory certificates,
            teaching areas and supporting documents before accepting or rejecting
            this section.
        </p>
    </div>
</div>

<div class="verification-card">

    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-building"></i>
            Land & Building Details
        </h3>
    </div>

    <div class="verification-card-body">

        <!-- Land Details -->

        <h5 class="fw-bold mb-3 border-bottom pb-2">
            <i class="bi bi-geo-alt"></i>
            Land Details
        </h5>

        <div class="row g-3 mb-4">

            <div class="col-md-6">
                <label class="form-label fw-bold">Total Land Area (Acres)</label>
                <input class="form-control"
                       value="@(Model.TotalLandAreaAcres?.ToString("N2") ?? "N/A")"
                       disabled />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Land Ownership Type</label>
                <input class="form-control"
                       value="@(Model.LandOwnershipType ?? "N/A")"
                       disabled />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Land Category</label>
                <input class="form-control"
                       value="@(Model.LandCategory ?? "N/A")"
                       disabled />
            </div>


            <div class="col-md-6">
                <label class="form-label fw-bold">Future Expansion Space</label>
                <input class="form-control"
                       value="@(Model.HasFutureExpansionSpace == true ? "Yes" : (Model.HasFutureExpansionSpace == false ? "No" : "N/A"))"
                       disabled />
            </div>

        </div>

        <!-- Documents -->

        <h5 class="fw-bold mb-3 border-bottom pb-2">
            <i class="bi bi-file-earmark-text"></i>
            Land Documents
        </h5>

        <div class="row g-3 mb-4">
            @foreach (var document in landDocuments)
            {
                <div class="col-md-4">

                    <label class="form-label fw-bold">
                        @document.Label
                    </label>

                    @if (!string.IsNullOrWhiteSpace(document.Path))
                    {
                        @await Html.PartialAsync(
                            "_DocumentViewerButton",
                            new DocumentViewerVm
                            {
                                Url = Url.Action(
                                    document.Action,
                                    "VerificationDashboard",
                                    new
                                    {
                                        id = Model.Id,
                                        documentType = document.DocumentType
                                    })!,

                                Title = document.Label
                            })
                    }
                    else
                    {
                        <div class="form-control text-muted">
                            Not Uploaded
                        </div>
                    }

                </div>
            }

        </div>

        
        @if (landFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", landFeedback)
        }


        <!-- Building -->

        <h5 class="fw-bold mb-3 border-bottom pb-2">
            <i class="bi bi-house"></i>
            Building Details
        </h5>

        <div class="row g-3 mb-4">

            <!-- Total Built-up Area -->
            <div class="col-md-6">
                <label class="form-label fw-bold">
                    Total Built-up Area (Sq.m)
                </label>

                <input class="form-control"
                       value="@(Model.TotalBuiltupAreaSqm?.ToString("N2") ?? "N/A")"
                       disabled />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">
                    Area Per Lecture Hall (in Sq.m)
                </label>

                <input class="form-control"
                       value="@(Model.LectureHallAreaSqm?.ToString("N2") ?? "N/A")"
                       disabled />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">
                    Number of students / one lecture hall
                </label>

                <input class="form-control"
                       value="@(Model.LectureHallSeatingCapacity?.ToString("N2") ?? "N/A")"
                       disabled />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">
                    Number of lecture halls
                </label>

                <input class="form-control"
                       value="@(Model.LectureHallCount?.ToString("N2") ?? "N/A")"
                       disabled />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">
                    Area of Museum & Demonstration Rooms (in Sq.m)
                </label>

                <input class="form-control"
                       value="@(Model.MuseumDemoRoomsAreaSqm?.ToString("N2") ?? "N/A")"
                       disabled />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">
                    Area of Departmental Areas (in Sq.m)
                </label>

                <input class="form-control"
                       value="@(Model.DepartmentWiseAreaSqm?.ToString("N2") ?? "N/A")"
                       disabled />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">
                    Area of Preclinical Labs & Skill Labs (in Sq.m)
                </label>

                <input class="form-control"
                       value="@(Model.PreclinicalSkillLabAreaSqm?.ToString("N2") ?? "N/A")"
                       disabled />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">
                    Area of Examination Hall (in Sq.m)
                </label>

                <input class="form-control"
                       value="@(Model.ExaminationHallAreaSqm?.ToString("N2") ?? "N/A")"
                       disabled />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">
                    Area of Library Including Reading Room (in Sq.m)
                </label>

                <input class="form-control"
                       value="@(Model.LibraryAreaSqm?.ToString("N2") ?? "N/A")"
                       disabled />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">
                    Area of Dental Hospital (in Sq.m)
                </label>

                <input class="form-control"
                       value="@(Model.HospitalAreaSqm?.ToString("N2") ?? "N/A")"
                       disabled />
            </div>


            <div class="row g-3 mb-4">

                @foreach (var document in buildingDocuments)
                {
                    <div class="col-md-4">

                        <label class="form-label fw-bold">
                            @document.Label
                        </label>

                        @if (!string.IsNullOrWhiteSpace(document.Path))
                        {
                            @await Html.PartialAsync(
                                "_DocumentViewerButton",
                                new DocumentViewerVm
                                {
                                    Url = Url.Action(
                                        "ViewLandBuildingDocument",
                                        "VerificationDashboard",
                                        new
                                        {
                                            id = Model.Id,
                                            documentType = document.DocumentType
                                        })!,

                                    Title = document.Label
                                })
                        }
                        else
                        {
                            <div class="form-control text-muted">
                                Not Uploaded
                            </div>
                        }

                    </div>
                }

            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Remarks))
        {
            <hr />

            <h5 class="fw-bold">
                <i class="bi bi-chat-left-text"></i>
                Remarks
            </h5>

            <div class="alert alert-secondary">
                @Model.Remarks
            </div>
        }


        @if (buildingFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", buildingFeedback)
        }

    </div>

    

</div>
@model VerificationPortal.Models.MedicalCollegeCourseIntakeVerificationVm

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Medical Course Intake";

    ViewData["ActiveTab"] = "MedicalCourseIntake";

    ViewData["InstitutionName"] = Model.PageContext.InstitutionName;

    ViewData["CollegeCode"] = Model.PageContext.CollegeCode;

    ViewData["FacultyName"] = Model.PageContext.FacultyName;

    ViewData["VerificationStatus"] = Model.PageContext.VerificationStatus;

    ViewData["StatusBadgeClass"] = Model.PageContext.StatusBadgeClass;

    ViewData["ShowFeedbackSection"] = true;

    ViewData["CurrentVerifier"] = Model.PageContext.CurrentVerifier;

    ViewData["NextTabAction"] = Model.PageContext.NextTabAction;

    ViewData["NextTabLabel"] = Model.PageContext.NextTabLabel;

    ViewData["PrevTabAction"] = Model.PageContext.PrevTabAction;

    ViewData["PrevTabLabel"] = Model.PageContext.PrevTabLabel;

    ViewData["TabwiseVerification"] = Model.TabwiseVerification;

    string levelName = Model.CourseLevel?.ToUpperInvariant() switch
    {
        "UG" => "Undergraduate",
        "PG" => "Postgraduate",
        "SS" => "Super Speciality",
        _ => Model.CourseLevel
    };
}

<!-- PAGE HEADER -->
<div class="page-header mb-4">

    <h1 class="page-title">
        <i class="bi bi-mortarboard"></i>
        Medical Course Intake
    </h1>

    <p class="text-muted mb-0">
        Review and verify @levelName course intake details,
        sanctioned intake, increased intake and previous NMC
        Letter of Permission (LOP) information.
    </p>

</div>


<!-- VERIFICATION INSTRUCTIONS -->
<div class="note-box mb-4">

    <i class="bi bi-info-circle"></i>

    <div class="note-box-content">

        <h6>Verification Instructions</h6>

        <p class="mb-0">
            Review the submitted course-wise intake details carefully.
            Verify the approved intake, increased intake (where applicable),
            academic year and previous NMC Letter of Permission documents.
            Provide your remarks and update the verification status
            before proceeding to the next tab.
        </p>

    </div>

</div>


<!-- COLLEGE INFORMATION -->
@* <div class="verification-card mb-4">

    <div class="verification-card-body">

        <div class="row g-3">

            <div class="col-md-6">
                <small class="text-muted d-block">College Name</small>
                <strong>@Model.CollegeName</strong>
            </div>

            <div class="col-md-3">
                <small class="text-muted d-block">College Code</small>
                <strong>@Model.CollegeCode</strong>
            </div>

            <div class="col-md-3">
                <small class="text-muted d-block">Course Level</small>
                <strong>@levelName (@Model.CourseLevel)</strong>
            </div>

        </div>

    </div>

</div> *@


<!-- COURSE INTAKE DETAILS -->
@if (Model.Courses != null && Model.Courses.Any())
{
    <div class="verification-card mb-4">

        <div class="verification-card-header">
            <h5 class="mb-0">
                <i class="bi bi-journal-medical me-2"></i>
                Course-wise Intake Details
            </h5>
        </div>

        <div class="verification-card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th style="width:60px;">Sl. No.</th>
                            <th>Course Name</th>
                            @* <th>Course Code</th> *@
                            <th>Approved Intake (2026-27)</th>

                            @if (Model.ShowIncreasedIntakeFields)
                            {
                                <th>Increased Intake</th>
                                <th>Academic Year</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var course in Model.Courses)
                        {
                            <tr>
                                <td>@course.Slno</td>

                                <td>
                                    <strong>@course.CourseName</strong>
                                </td>

                                @* <td>@course.CourseCode</td> *@

                                <td>
                                    <span class="badge bg-primary">
                                        @course.Intake2627
                                    </span>
                                </td>

                                @if (Model.ShowIncreasedIntakeFields)
                                {
                                    <td>
                                        @(string.IsNullOrWhiteSpace(course.IncreasedIntake)
                                            ? "-"
                                            : course.IncreasedIntake)
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(course.AcademicYear)
                                            ? "-"
                                            : course.AcademicYear)
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>

    </div>
}
else
{
    <div class="verification-card mb-4">

        <div class="verification-card-body">

            <div class="alert alert-info text-center py-5 mb-0">

                <i class="bi bi-database fs-1 d-block mb-3 opacity-50"></i>

                <h5>No Course Intake Data Found</h5>

                <p class="mb-0 text-muted">
                    @levelName course intake details are not available
                    for this college.
                </p>

            </div>

        </div>

    </div>
}


<!-- PREVIOUS INTAKE DETAILS - UG ONLY -->
@if (Model.CourseLevel == "UG")
{
    <div class="verification-card mb-4">

        <div class="verification-card-header">
            <h5 class="mb-0">
                <i class="bi bi-file-earmark-medical me-2"></i>
                Previous Intake & NMC LOP Details
            </h5>
        </div>

        <div class="verification-card-body">

            @if (Model.PreviousDetails != null && Model.PreviousDetails.Any())
            {
                @foreach (var course in Model.PreviousDetails)
                {
                    <div class="mb-4">

                        <h6 class="fw-bold mb-3">
                            <i class="bi bi-book me-2"></i>
                            @course.CourseName
                            @* <small class="text-muted">
                                (Course Code: @course.CourseCode)
                            </small> *@
                        </h6>

                        <div class="table-responsive">

                            <table class="table table-bordered table-hover align-middle">

                                <thead class="table-light">
                                    <tr>
                                        <th>Intake Slab</th>
                                        <th>Year of Obtaining LOP</th>
                                        <th>NMC Document</th>
                                        <th>Document Status</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var slab in course.Slabs)
                                    {
                                        <tr>

                                            <td>
                                                <strong>@slab.IntakeSlab</strong>
                                            </td>

                                            <td>
                                                @(slab.LopYear?.ToString() ?? "-")
                                            </td>

                                            <td>
                                                @if (slab.HasDocument)
                                                {
                                                    @if (!string.IsNullOrWhiteSpace(slab.DocumentUrl))
                                                    {
                                                        <a href="@slab.DocumentUrl"
                                                           target="_blank"
                                                           class="btn btn-sm btn-outline-primary">
                                                            <i class="bi bi-file-earmark-pdf"></i>
                                                            View Document
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span>
                                                            <i class="bi bi-file-earmark-pdf text-danger"></i>
                                                            @(slab.DocumentName ?? "Document uploaded")
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>

                                            <td>
                                                @if (slab.HasDocument)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="bi bi-check-circle me-1"></i>
                                                        Available
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        Not Available
                                                    </span>
                                                }
                                            </td>

                                        </tr>
                                    }
                                </tbody>

                            </table>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="alert alert-info mb-0">
                    Previous intake details are not available.
                </div>
            }

        </div>

    </div>
}


<!-- SECTION FEEDBACK -->
@if (Model.SectionFeedback != null && Model.SectionFeedback.Any())
{
    @await Html.PartialAsync("_SectionFeedback", Model.SectionFeedback)
}

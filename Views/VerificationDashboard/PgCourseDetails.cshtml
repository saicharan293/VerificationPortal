@model VerificationPortal.ViewModels.PgCourseDetailsViewModel

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";
    ViewData["Title"] = "PG Course Details - Verification Dashboard";
    ViewData["ActiveTab"] = Model.PageContext.ActiveTab ?? "PgCourseDetails";
    ViewData["InstitutionName"] = Model.PageContext.InstitutionName ?? "Unknown Institution";
    ViewData["CollegeCode"] = Model.PageContext.CollegeCode ?? "";
    ViewData["FacultyName"] = Model.PageContext.FacultyName ?? "";
    ViewData["VerificationStatus"] = Model.PageContext.VerificationStatus;
    ViewData["StatusBadgeClass"] = Model.PageContext.StatusBadgeClass;
    ViewData["ShowFeedbackSection"] = true;
    ViewData["CurrentVerifier"] = $"{Model.PageContext.CurrentVerifier} - {Model.PageContext.UserDesignation}";
    ViewData["NextTabAction"] = Model.PageContext.NextTabAction;
    ViewData["NextTabLabel"] = Model.PageContext.NextTabLabel;
    ViewData["PrevTabAction"] = Model.PageContext.PrevTabAction;
    ViewData["PrevTabLabel"] = Model.PageContext.PrevTabLabel;
    ViewData["TabId"] = Model.PageContext.TabId;
    ViewData["CompletedTabNames"] = Model.PageContext.CompletedTabNames;
    ViewData["TabVerificationDetails"] = Model.PageContext.TabVerificationDetails;
    ViewData["TabwiseVerification"] = Model.TabwiseVerification;
}

@section Styles {
}

<!-- Note Box -->
<div class="note-box mb-4">
    <i class="bi bi-info-circle"></i>
    <div class="note-box-content">
        <h6>Verification Instructions</h6>
        <p>Review the PG / Super Specialty course details below including intake, LOP, recognition by NMC/DCI, and course codes. Provide your remarks and select verification status. Once completed, proceed to the next tab: <strong>Infrastructure</strong>.</p>
    </div>
</div>

@{
    var pgFeedback = Model.SectionFeedback?.FirstOrDefault(x => x.SectionName == "PG Course Details");
}

<!-- PG/SS Courses Table Card -->
<div class="verification-card mb-4">
    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-mortarboard"></i>
            PG Course Details
        </h3>
        <span class="badge bg-primary ms-2">@(Model.Courses?.Count ?? 0) Courses</span>
    </div>
    <div class="verification-card-body">
        @if (Model.Courses != null && Model.Courses.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Course Name</th>
                            <th>Course Level</th>
                            <th>LOP Intake</th>
                            <th>LOP Date</th>
                            <th>Recognition by NMC</th>
                            <th>Recognition by DCI</th>
                            <th>Created At</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Courses.Count; i++)
                        {
                            var course = Model.Courses[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td><strong>@course.CourseName</strong></td>
                                <td>
                                    @{
                                        var levelBadge = course.CourseLevel switch
                                        {
                                            "SS" => "bg-danger",
                                            "PG" => "bg-warning text-dark",
                                            _ => "bg-info text-dark"
                                        };
                                    }
                                    <span class="">@course.CourseLevel</span>
                                </td>
                                <td>@course.PresentIntake</td>
                                <td>@(course.Lopdate?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td>@(course.DateofRecognitionByNmc?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td>@(course.DateofRecognitionByDci?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td>@course.CreatedAt.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center py-4 flex-box">
                <i class="bi bi-database fs-1 d-block mb-2 opacity-50"></i>
                <strong>No PG/SS course data found</strong> for this college.
                <p class="mb-0 text-muted">PG / Super Specialty courses will appear here when available in the AffiliationPgSsCourseDetails table.</p>
            </div>
        }

        
        @if (pgFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", pgFeedback)
        }
    </div>
</div>



<!-- Verification Remarks & Status (rendered by layout) -->
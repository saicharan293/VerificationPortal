@model VerificationPortal.Models.UgCourseVerificationVm

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "UG Course Details";

    ViewData["ActiveTab"] = "UgCourseDetails";

    ViewData["InstitutionName"] =  Model.PageContext.InstitutionName ;

    ViewData["CollegeCode"] = Model.PageContext.CollegeCode;

    ViewData["FacultyName"] = Model.PageContext.FacultyName;

    ViewData["VerificationStatus"] = Model.PageContext.VerificationStatus;

    ViewData["StatusBadgeClass"] = Model.PageContext.StatusBadgeClass;

    ViewData["ShowFeedbackSection"] = true;

    ViewData["CurrentVerifier"] = Model.PageContext.CurrentVerifier;

    ViewData["NextTabAction"] = Model.PageContext.NextTabAction;

    ViewData["NextTabLabel"] = Model.PageContext.NextTabLabel;

    ViewData["PrevTabAction"] = Model.PageContext.PrevTabAction;

    ViewData["PrevTabLabel"] =  Model.PageContext.PrevTabLabel;

}


<!-- ========================================================= -->
<!-- PAGE HEADER -->
<!-- ========================================================= -->

<div class="page-header mb-4">

    <h1 class="page-title">
        <i class="bi bi-book"></i>
        UG Course Details
    </h1>

    <p class="text-muted mb-0">
        Review and verify undergraduate course details, intake,
        permissions, affiliations and inspection information.
    </p>

</div>


<!-- ========================================================= -->
<!-- NOTE BOX -->
<!-- ========================================================= -->

<div class="note-box mb-4">

    <i class="bi bi-info-circle"></i>

    <div class="note-box-content">

        <h6>
            Verification Instructions
        </h6>

        <p>
            Review the UG course details section by section.
            Verify the present intake, previous details, permissions,
            EC/FC, RGUHS affiliation and previous LIC inspection
            information. Provide your remarks and select the
            verification status before proceeding to the next tab.
        </p>

    </div>

</div>


@if (Model.Courses != null && Model.Courses.Count > 0)
{
    foreach (var courseVm in Model.Courses)
    {
         @await Html.PartialAsync("_UgCourseCard", courseVm)
    }
}
else
{
    <div class="verification-card mb-4">

        <div class="verification-card-body">

            <div class="alert alert-info text-center py-5 mb-0">

                <i class="bi bi-database fs-1 d-block mb-3 opacity-50"></i>

                <h5>
                    No UG Course Data Found
                </h5>

                <p class="mb-0 text-muted">
                    UG course details are not available for this college.
                </p>

            </div>

        </div>

    </div>
}
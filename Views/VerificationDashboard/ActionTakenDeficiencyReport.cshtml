@model VerificationPortal.Models.ActionTakenDeficiencyVerificationVm

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";
    ViewData["Title"] = "Action Taken on Deficiency Report";
    ViewData["ActiveTab"] = "ActionTakenDeficiencyReport";
    ViewData["ShowFeedbackSection"] = true;

    ViewData["InstitutionName"] =
        Model.PageContext.InstitutionName ?? "Unknown Institution";

    ViewData["CollegeCode"] =
        Model.PageContext.CollegeCode ?? "";

    ViewData["FacultyCode"] =
        Model.PageContext.FacultyId;

    ViewData["CurrentVerifier"] =
        Model.PageContext.CurrentVerifier;

    ViewData["PrevTabAction"] =
        Model.PageContext.PrevTabAction;

    ViewData["PrevTabLabel"] =
        Model.PageContext.PrevTabLabel;

    ViewData["NextTabAction"] =
        Model.PageContext.NextTabAction;

    ViewData["NextTabLabel"] =
        Model.PageContext.NextTabLabel;

    var sectionFeedback =
        Model.SectionFeedback?.FirstOrDefault(x => x.SectionId == 75);

}


<div class="container-fluid px-3 px-md-4 py-3">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body py-3">

            <div class="d-flex flex-wrap
                        justify-content-between
                        align-items-center gap-3">

                <div>

                    <h4 class="fw-bold mb-1 text-primary">

                        <i class="bi bi-clipboard-check me-2"></i>

                        Action Taken on Deficiency Report

                    </h4>

                    <div class="form-label small">

                        Review the deficiencies pointed out by the
                        University and the action taken by the institution.

                    </div>

                </div>


                <div class="text-end">

                    <div class="small form-label">
                        College Code
                    </div>

                    <div class="fw-bold">
                        @Model.PageContext.CollegeCode
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         DEFICIENCY DETAILS
    ====================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header  border-bottom py-3">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                <div>

                    <h5 class="fw-bold mb-1 text-primary">

                        <i class="bi bi-exclamation-diamond me-2"></i>

                        Deficiency Details

                    </h5>

                    <small class="form-label">

                        Details of deficiencies and action taken by the institution.

                    </small>

                </div>


                @if (Model.Deficiencies?.Any() == true)
                {
                    <span class="badge bg-primary">

                        @Model.Deficiencies.Count
                        Record@(Model.Deficiencies.Count == 1 ? "" : "s")

                    </span>
                }

            </div>

        </div>


        <div class="card-body p-3">

            @if (Model.Deficiencies?.Any() == true)
            {
                var rowNumber = 1;

                foreach (var item in Model.Deficiencies)
                {
                    <div class="border rounded-3 mb-4 overflow-hidden">

                        <!-- =================================================
                             RECORD HEADER
                        ================================================== -->

                        <div class=" border-bottom px-3 py-2">

                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                                <div class="d-flex align-items-center">

                                    <span class="badge bg-primary me-2">
                                        @rowNumber
                                    </span>

                                    <span class="fw-semibold">
                                        Deficiency Record
                                    </span>

                                </div>


                                @if (!string.IsNullOrWhiteSpace(item.CourseLevel))
                                {
                                    <span class="badge bg-secondary">

                                        @item.CourseLevel

                                    </span>
                                }

                            </div>

                        </div>


                        <!-- =================================================
                             RECORD CONTENT
                        ================================================== -->

                        <div class="p-3">

                            <div class="row g-3">

                                <!-- COURSE LEVEL -->

                                <div class="col-md-3">

                                    <div class="small form-label mb-1">
                                        Course Level
                                    </div>

                                    <div>

                                        @if (!string.IsNullOrWhiteSpace(
                                            item.CourseLevel))
                                        {
                                            <span class="badge bg-secondary fs-6">

                                                @item.CourseLevel

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="form-label">
                                                Not Available
                                            </span>
                                        }

                                    </div>

                                </div>


                            </div>


                            <!-- =================================================
                                 DEFICIENCY POINTED OUT
                            ================================================== -->

                            <div class="mt-4">

                                <label class="form-label fw-semibold">

                                    <i class="bi bi-exclamation-circle
                                              text-danger me-1"></i>

                                    Deficiency Pointed Out

                                </label>

                                <div class="border rounded-3
                                             p-3">

                                    @if (!string.IsNullOrWhiteSpace(
                                        item.DeficiencyPointedOut))
                                    {
                                        <div class="text-break"
                                             style="white-space: pre-line;">

                                            @item.DeficiencyPointedOut

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="form-label">
                                            No deficiency details available.
                                        </span>
                                    }

                                </div>

                            </div>


                            <!-- =================================================
                                 EXTENT REMEDIED
                            ================================================== -->

                            <div class="mt-4">

                                <label class="form-label fw-semibold">

                                    <i class="bi bi-check2-circle
                                              text-success me-1"></i>

                                    Extent Remedied

                                </label>

                                <div class="border rounded-3
                                             p-3">

                                    @if (!string.IsNullOrWhiteSpace(
                                        item.ExtentRemedied))
                                    {
                                        <div class="text-break"
                                             style="white-space: pre-line;">

                                            @item.ExtentRemedied

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="form-label">
                                            No remedial action details available.
                                        </span>
                                    }

                                </div>

                            </div>


                            <!-- =================================================
                                 RELEVANT REPORT
                            ================================================== -->

                            <div class="mt-4 pt-3 border-top">

                                <div class="d-flex flex-wrap
                                            justify-content-between
                                            align-items-center gap-3">

                                    <div>

                                        <label class="form-label
                                                      fw-semibold mb-1">

                                            <i class="bi bi-file-earmark-pdf
                                                      text-danger me-1"></i>

                                            Relevant Report

                                        </label>

                                        <div class="small form-label">

                                            Supporting document submitted
                                            for this deficiency.

                                        </div>

                                    </div>


                                    <div>

                                        @if (item.HasRelevantReport)
                                        {
                                            @await Html.PartialAsync(
                                                "_DocumentViewerButton",
                                                new DocumentViewerVm
                                                {
                                                    Url = Url.Action(
                                                        "ViewReport",
                                                        "VerificationDashboard",
                                                        new
                                                        {
                                                            reportId = item.ActionTakenDeficiencyReportId,
                                                            collegeCode =
                                                                Model.PageContext.CollegeCode
                                                        })!,

                                                    Title =
                                                        "Relevant Report",

                                                    FacultyId =
                                                        Model.PageContext.FacultyId,

                                                    DocumentId =
                                                        Model.RelevantReportDocId,

                                                    CollegeCode =
                                                        Model.PageContext.CollegeCode,

                                                    CanVerify = true
                                                })
                                        }
                                        else
                                        {
                                            <span class="badge
                                                         bg-warning
                                                         text-dark">

                                                <i class="bi bi-exclamation-triangle
                                                          me-1"></i>

                                                Document Not Available

                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    rowNumber++;
                }
            }
            else
            {
                <div class="alert alert-warning mb-0">

                    <i class="bi bi-exclamation-triangle me-2"></i>

                    No action taken / deficiency records have been
                    submitted by the institution.

                </div>
            }


            <!-- =================================================
                 SECTION FEEDBACK
            ================================================== -->

            @* @if (sectionFeedback != null)
            { *@
                <div class="mt-4 pt-3 border-top">

                    <h6 class="fw-bold mb-1">

                        <i class="bi bi-chat-left-text me-2"></i>

                        Section Feedback

                    </h6>

                    <small class="form-label d-block mb-3">

                        Verification feedback for the action taken
                        on deficiency report.

                    </small>


                    @await Html.PartialAsync(
                        "_SectionFeedback",
                        sectionFeedback)

                </div>
            @* } *@

        </div>

    </div>


    <!-- =====================================================
         PAGE INFORMATION
    ====================================================== -->

    @if (Model.Deficiencies?.Any() == true)
    {
        <div class="card border-0 shadow-sm mb-4">

            <div class="card-body">

                <div class="d-flex align-items-center">

                    <i class="bi bi-info-circle text-primary
                              fs-5 me-2"></i>

                    <div class="small form-label">

                        Total deficiency records:
                        <strong>
                            @Model.Deficiencies.Count
                        </strong>

                    </div>

                </div>

            </div>

        </div>
    }

</div>


@section Scripts
{
    <script src="~/js/verification-dashboard.js"></script>
}
 @model VerificationPortal.Models.EquipmentPageVM

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Equipment List";
    ViewData["ActiveTab"] = "EquipmentList";

    ViewData["InstitutionName"] =
        Model.PageContext.InstitutionName ?? "Unknown Institution";

    ViewData["CollegeCode"] =
        Model.PageContext.CollegeCode ?? Model.CollegeCode;

    ViewData["FacultyCode"] = Model.PageContext.FacultyId;

    ViewData["ShowFeedbackSection"] = true;

    ViewData["CurrentVerifier"] =
        Model.PageContext.CurrentVerifier ?? "";

    ViewData["PrevTabAction"] = Model.PageContext.PrevTabAction;

    ViewData["PrevTabLabel"] =
        Model.PageContext.PrevTabLabel ?? "Previous";

    ViewData["NextTabAction"] = Model.PageContext.NextTabAction;

    ViewData["NextTabLabel"] =
        Model.PageContext.NextTabLabel ?? "Next";

    bool isMedical = Model.FacultyCode == 1;
    bool isDental = Model.FacultyCode == 2;

    var equipmentListFeedback = Model.SectionFeedback?.FirstOrDefault(e=>e.SectionName == "Equipment Details");
}

<link rel="stylesheet"
      href="~/css/equipment-list.css"
      asp-append-version="true" />

<div class="page-header mb-4">

    <h1 class="page-title">
        <i class="bi bi-tools"></i>
        Equipment List
    </h1>

    <p class="text-muted mb-0">
        Review the equipment requirements and equipment available in the institution.
    </p>

</div>

<div class="note-box mb-4">

    <i class="bi bi-info-circle"></i>

    <div class="note-box-content">

        <h6>Verification Instructions</h6>

        <p>
            Review the prescribed equipment requirements against the
            equipment available in the institution. Verify the
            quantities and availability reported by the college
            before approving this section.
        </p>

    </div>

</div>

<div class="verification-card">

    <div class="verification-card-header">

        <h3 class="verification-card-title">
            <i class="bi bi-tools"></i>
            Equipment Details
        </h3>

        @if (isMedical && !string.IsNullOrWhiteSpace(Model.AcademicYear))
        {
            <span class="badge bg-primary">
                Academic Year: @Model.AcademicYear
            </span>
        }

    </div>

    <div class="verification-card-body">

        @if (Model.Equipments != null && Model.Equipments.Any())
        {
            <div class="table-responsive equipment-table-wrapper">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:60px;">Sl No.</th>
                            <th>Department</th>
                            <th>Equipment</th>
                            @if (isDental)
                            {
                                <th>Specification</th>

                                <th class="text-center" style="min-width:120px;">
                                    1 Unit<br />Requirement
                                </th>

                                <th class="text-center" style="min-width:120px;">
                                    2 Unit<br />Requirement
                                </th>

                                <th class="text-center" style="min-width:120px;">
                                    1 Unit<br />Existing
                                </th>

                                <th class="text-center" style="min-width:120px;">
                                    2 Unit<br />Existing
                                </th>
                            }

                            @if (isMedical)
                            {
                                <th class="text-center" style="min-width:140px;">
                                    Availability
                                </th>

                                <th class="text-center" style="min-width:120px;">
                                    Available Quantity
                                </th>
                            }

                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int serialNo = 1;
                        }

                        @if (isMedical)
                        {
                            var departmentGroups = Model.Equipments
                                .GroupBy(x => new
                                {
                                    x.DepartmentCode,
                                    x.DepartmentName
                                })
                                .OrderBy(g => g.Key.DepartmentName);

                            foreach (var department in departmentGroups)
                            {
                                var items = department.ToList();
                                var firstItem = true;

                                foreach (var item in department)
                                {
                                    <tr>
                                        <td class="text-center"> @serialNo </td>

                                        @if (firstItem)
                                        {
                                            <td rowspan="@items.Count()" class="align-top"> @item.DepartmentName </td>
                                            firstItem = false;
                                        }
                                        <td class="fw-semibold"> @item.EquipmentName </td>
                                        <td class="text-center">
                                            @if (item.IsAvailable)
                                            {
                                                <span class="badge bg-success"> Available </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger"> Not Available </span>
                                            }
                                        </td>
                                        <td class="text-center"> @(item.AvailableQuantity?.ToString() ?? "-") </td>
                                    </tr>

                                    serialNo++;
                                }
                            }
                        }

                        @if (isDental)
                        {

                            var departmentGroups = Model.Equipments
                                .GroupBy(e => new 
                                {
                                    e.DepartmentCode, 
                                    e.DepartmentName
                                })
                                .OrderBy(e => e.Key.DepartmentName);

                            foreach(var department in departmentGroups)
                            {
                                var items = department.ToList();
                                var firstItem = true;

                                foreach (var item in items)
                                {
                                    <tr>
                                        <td class="text-center"> @serialNo </td>
                                        @if (firstItem)
                                        {
                                            <td rowspan="@items.Count()" class="align-top"> @item.DepartmentName </td>
                                            firstItem = false;
                                        }
                                        <td class="fw-semibold"> @item.EquipmentName </td>
                                        <td> @(string.IsNullOrWhiteSpace(item.Specification) ? "N/A" : item.Specification) </td>
                                        <td class="text-center"> @(item.OneUnitReq?.ToString() ?? "-") </td>
                                        <td class="text-center"> @(item.TwoUnitReq?.ToString() ?? "-") </td>
                                        <td class="text-center"> @(item.OneUnitExisting?.ToString() ?? "-") </td>
                                        <td class="text-center"> @(item.TwoUnitExisting?.ToString() ?? "-") </td>
                                    </tr>
                                    serialNo++;
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-warning mb-0">
                <i class="bi bi-exclamation-triangle me-2"></i>
                No equipment details are available for this institution.
            </div>
        }

        @if (equipmentListFeedback != null)
        {
            @await Html.PartialAsync(  "_SectionFeedback", equipmentListFeedback)
        }

    </div>

</div>

@section Scripts {
    <script src="~/js/verification-dashboard.js" asp-append-version="true"></script>
}
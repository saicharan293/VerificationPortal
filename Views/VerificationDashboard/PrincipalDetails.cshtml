@model VerificationPortal.Models.AffInstitutionsDetail

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Principal Details - Verification Dashboard";
    ViewData["ActiveTab"] = "PrincipalDetails";

    ViewData["InstitutionName"] =
        Model?.NameOfInstitution ?? "Unknown Institution";

    ViewData["CollegeCode"] =
        Model?.CollegeCode ?? "";

    ViewData["FacultyName"] =
        Model?.FacultyCode ?? "";

    ViewData["VerificationStatus"] =
        Model?.IsDeoVerified == true
            ? "Verified"
            : Model?.IsDeoVerified == false
                ? "Rejected"
                : "Pending";

    ViewData["StatusBadgeClass"] =
        Model?.IsDeoVerified == true
            ? "verified"
            : Model?.IsDeoVerified == false
                ? "rejected"
                : "pending";

    ViewData["ShowFeedbackSection"] = true;

    ViewData["CurrentVerifier"] =
        User.Identity?.Name + " - " + ViewBag.UserDesignation;

    ViewData["NextTabAction"] =
        Url.Action(
            "Courses",
            "VerificationDashboard",
            new
            {
                collegeCode = Model?.CollegeCode
            });

    ViewData["NextTabLabel"] =
        "Next: Courses & Intake";

    ViewData["PrevTabAction"] =
        Url.Action(
            "DeanDirectorDetails",
            "VerificationDashboard",
            new
            {
                collegeCode = Model?.CollegeCode
            });

    ViewData["PrevTabLabel"] =
        "Previous: Dean / Director Details";


    // Experience college lookup
    var experienceColleges =
        ViewBag.ExperienceColleges
        as List<SelectListItem>
        ?? new List<SelectListItem>();
}

@{
    ViewBag.ActiveTab = "PrincipalDetails";
}


<!-- ========================================================= -->
<!-- PAGE HEADER -->
<!-- ========================================================= -->

<div class="page-header mb-4">

    <h1 class="page-title">
        <i class="bi bi-mortarboard"></i>
        Principal Details
    </h1>

    <p class="text-muted mb-0">
        Review and verify Principal information for this institution
    </p>

</div>


<!-- ========================================================= -->
<!-- NOTE -->
<!-- ========================================================= -->

<div class="note-box mb-4">

    <i class="bi bi-info-circle"></i>

    <div class="note-box-content">

        <h6>
            Verification Instructions
        </h6>

        <p>
            Review the Principal details and experience information
            below. Provide your remarks in the remarks field and
            select the verification status.
        </p>

    </div>

</div>


<!-- ========================================================= -->
<!-- PRINCIPAL INFORMATION -->
<!-- ========================================================= -->

<div class="verification-card mb-4">

    <div class="verification-card-header">

        <h3 class="verification-card-title">
            <i class="bi bi-person-badge"></i>
            Principal Information
        </h3>

    </div>

    <div class="verification-card-body">

        <div class="row g-3">

            <!-- Principal Name -->

            <div class="col-md-6">

                <label class="form-label">
                    Principal Name
                </label>

                <input type="text"
                       class="form-control"
                       value="@(ViewBag.PrincipalName ?? "-")"
                       disabled />

            </div>


            <!-- Qualification -->

            <div class="col-md-6">

                <label class="form-label">
                    Qualification
                </label>

                <input type="text"
                       class="form-control"
                       value="@(ViewBag.PrincipalQualification ?? "-")"
                       disabled />

            </div>


            <!-- Qualification Date -->

            <div class="col-md-6">

                <label class="form-label">
                    Qualification Date
                </label>

                <input type="text"
                       class="form-control"
                       value="@(ViewBag.PrincipalQualificationDate ?? "-")"
                       disabled />

            </div>


            <!-- University -->

            <div class="col-md-6">

                <label class="form-label">
                    University
                </label>

                <input type="text"
                       class="form-control"
                       value="@(ViewBag.PrincipalUniversity ?? "-")"
                       disabled />

            </div>


            <!-- State Council Number -->

            <div class="col-md-6">

                <label class="form-label">
                    State Council Number
                </label>

                <input type="text"
                       class="form-control"
                       value="@(ViewBag.PrincipalStateCouncilNumber ?? "-")"
                       disabled />

            </div>


            <!-- Recognition -->

            <div class="col-md-6">

                <label class="form-label">
                    @ViewBag.RecognitionLabel
                </label>

                <input type="text"
                       class="form-control"
                       value="@(ViewBag.RecognitionStatus ?? "-")"
                       disabled />

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- TEACHING EXPERIENCE -->
<!-- ========================================================= -->

<div class="verification-card mb-4">

    <div class="verification-card-header">

        <h3 class="verification-card-title">
            <i class="bi bi-book"></i>
            Teaching Experience
        </h3>

    </div>

    <div class="verification-card-body">

        @if (ViewBag.TeachingExperiences != null &&
             ((IEnumerable<dynamic>)ViewBag.TeachingExperiences).Any())
        {
            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-light">

                        <tr>
                            <th style="width:70px;">
                                Sl. No
                            </th>

                            <th>
                                Designation
                            </th>

                            <th>
                                College
                            </th>

                            <th>
                                Other College
                            </th>

                            <th>
                                From Date
                            </th>

                            <th>
                                To Date
                            </th>

                            <th>
                                Total Experience
                            </th>
                        </tr>

                    </thead>

                    <tbody>

                        @{
                            var serialNo = 1;
                        }

                        @foreach (var experience
                            in (IEnumerable<dynamic>)ViewBag.TeachingExperiences)
                        {
                            var collegeName = "-";

                            if (!string.IsNullOrWhiteSpace(experience.ExpCollegeCode))
                            {
                                collegeName = experienceColleges
                                    .FirstOrDefault(x =>
                                        x.Value == experience.ExpCollegeCode)
                                    ?.Text
                                    ?? experience.ExpCollegeCode;
                            }

                            <tr>

                                <td class="text-center">
                                    @serialNo
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(
                                        experience.Designation)
                                        ? "-"
                                        : experience.Designation)
                                </td>

                                <td>
                                    @collegeName
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(
                                        experience.OtherCollege)
                                        ? "-"
                                        : experience.OtherCollege)
                                </td>

                                <td>
                                    @(experience.FromDate != null
                                        ? experience.FromDate.ToString("dd-MM-yyyy")
                                        : "-")
                                </td>

                                <td>
                                    @(experience.ToDate != null
                                        ? experience.ToDate.ToString("dd-MM-yyyy")
                                        : "-")
                                </td>

                                <td>
                                    @(experience.TotalExperienceYears?.ToString() ?? "-")
                                </td>

                            </tr>

                            serialNo++;
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">

                <i class="bi bi-info-circle me-2"></i>

                No teaching experience details available.

            </div>
        }

    </div>

</div>



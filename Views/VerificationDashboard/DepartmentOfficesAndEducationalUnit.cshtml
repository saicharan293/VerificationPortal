@model VerificationPortal.Models.DepartmentOfficesMeuViewModel

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Department Offices & Educational Unit";
    ViewData["ActiveTab"] = "DepartmentOfficesAndEducationalUnit";

    ViewData["InstitutionName"] = ViewBag.InstitutionName ?? "Unknown Institution";
    ViewData["CollegeCode"] = ViewBag.CollegeCode ?? "";
    ViewData["FacultyName"] = ViewBag.FacultyName ?? "";

    ViewData["ShowFeedbackSection"] = true;

    ViewData["CurrentVerifier"] =
        User.Identity?.Name + " - " + ViewBag.UserDesignation;

    ViewData["PrevTabAction"] = Url.Action(
        "HostelDetails",
        "VerificationDashboard",
        new { collegeCode = ViewBag.CollegeCode });

    ViewData["PrevTabLabel"] = "Previous : Hostel Details";

    ViewData["NextTabAction"] = Url.Action(
        "HospitalDetails",
        "VerificationDashboard",
        new { collegeCode = ViewBag.CollegeCode });

    ViewData["NextTabLabel"] = "Next : Hospital Details";
}

@section Scripts {
    <script src="~/js/verification-dashboard.js" asp-append-version="true"></script>
}


<div class="page-header mb-4">
    <h1 class="page-title">
        <i class="bi bi-building"></i>
        Department Offices & Education Unit
    </h1>

    <p class="text-muted mb-0">
        Review and verify the department office infrastructure and Medical/Dental Education Unit details.
    </p>
</div>

<div class="note-box mb-4">
    <i class="bi bi-info-circle"></i>

    <div class="note-box-content">
        <h6>Verification Instructions</h6>

        <p>
            Verify the department office facilities, education unit infrastructure,
            coordinator details, supporting documents, and activities before approving this section.
        </p>
    </div>
</div>


@{
    var deptInfraFeedback = (ViewBag.SectionFeedback as List<VerificationPortal.Models.SectionFeedbackViewModel>)
                                ?.FirstOrDefault(x => x.SectionId == 34);
}

<div class="verification-card">

    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-building"></i>
            Department Office Infrastructure
        </h3>
    </div>

    <div class="verification-card-body">

        <div class="row g-4">

            <div class="col-md-6">
                <label class="form-label fw-semibold">
                    HOD Room with Office & Records
                </label>

                <input class="form-control"
                       value="@(Model.HasHodRoomWithOfficeAndRecords == true ? "Yes" : "No")"
                       disabled />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">
                    Rooms for Faculty & Residents
                </label>

                <input class="form-control"
                       value="@(Model.HasRoomsForFacultyAndResidents == true ? "Yes" : "No")"
                       disabled />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">
                    Faculty Rooms have Communication, Computer & Internet
                </label>

                <input class="form-control"
                       value="@(Model.FacultyRoomsHaveCommunicationComputerInternet == true ? "Yes" : "No")"
                       disabled />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">
                    Rooms for Non-Teaching Staff
                </label>

                <input class="form-control"
                       value="@(Model.HasRoomsForNonTeachingStaff == true ? "Yes" : "No")"
                       disabled />
            </div>

        </div>


        @if (deptInfraFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", deptInfraFeedback)
        }

    </div>

</div>




@{
    var deuFeedback = (ViewBag.SectionFeedback as List<VerificationPortal.Models.SectionFeedbackViewModel>)
                        ?.FirstOrDefault(x => x.SectionId == 35);
}

@if ((ViewBag.FacultyCode?.ToString() ?? "") == "2")
{
    <!-- ================= DENTAL EDUCATION UNIT ================= -->

    <div class="verification-card mt-4">

        <div class="verification-card-header">
            <h3 class="verification-card-title">
                <i class="bi bi-mortarboard"></i>
                Dental Education Unit (DEU)
            </h3>
        </div>

        <div class="verification-card-body">

            <div class="row g-4">

                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Dental Education Unit Available
                    </label>

                    <input class="form-control"
                           value="@(Model.HasDentalEducationUnit == true ? "Yes" : "No")"
                           disabled />
                </div>

                @if (Model.HasDentalEducationUnit == true)
                {
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Area (Sq. m.)
                        </label>

                        <input class="form-control"
                               value="@Model.DentalEducationUnitAreaSqm"
                               disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Audio Visual Facilities
                        </label>

                        <input class="form-control"
                               value="@(Model.DentalEducationUnitHasAudioVisual == true ? "Yes" : "No")"
                               disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Internet Facility
                        </label>

                        <input class="form-control"
                               value="@(Model.DentalEducationUnitHasInternet == true ? "Yes" : "No")"
                               disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Coordinator Name
                        </label>

                        <input class="form-control"
                               value="@Model.DeuCoordinatorName"
                               disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Designation & Department
                        </label>

                        <input class="form-control"
                               value="@Model.DeuCoordinatorDesignationDepartment"
                               disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Phone
                        </label>

                        <input class="form-control"
                               value="@Model.DeuCoordinatorPhone"
                               disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Email
                        </label>

                        <input class="form-control"
                               value="@Model.DeuCoordinatorEmail"
                               disabled />
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">
                            Activities During Last Academic Year
                        </label>

                        <textarea class="form-control"
                                  rows="4"
                                  disabled>@Model.DeuActivitiesLastAcademicYear</textarea>
                    </div>
                }

            </div>
            @if (deuFeedback != null)
            {
                @await Html.PartialAsync("_SectionFeedback", deuFeedback)
            }
        </div>

    </div>

}
else
{
    <!-- ================= MEDICAL EDUCATION UNIT ================= -->

    <div class="verification-card mt-4">

        <div class="verification-card-header">
            <h3 class="verification-card-title">
                <i class="bi bi-mortarboard"></i>
                Medical Education Unit (MEU)
            </h3>
        </div>

        <div class="verification-card-body">

            <div class="row g-4">

                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Medical Education Unit Available
                    </label>

                    <input class="form-control"
                           value="@(Model.HasMedicalEducationUnit == true ? "Yes" : "No")"
                           disabled />
                </div>

                @if (Model.HasMedicalEducationUnit == true)
                {
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Area (Sq. m.)
                        </label>

                        <input class="form-control"
                               value="@Model.MedicalEducationUnitAreaSqm"
                               disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Audio Visual Facilities
                        </label>

                        <input class="form-control"
                               value="@(Model.MedicalEducationUnitHasAudioVisual == true ? "Yes" : "No")"
                               disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Internet Facility
                        </label>

                        <input class="form-control"
                               value="@(Model.MedicalEducationUnitHasInternet == true ? "Yes" : "No")"
                               disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Coordinator Name
                        </label>

                        <input class="form-control"
                               value="@Model.MeuCoordinatorName"
                               disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Designation & Department
                        </label>

                        <input class="form-control"
                               value="@Model.MeuCoordinatorDesignationDepartment"
                               disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Phone
                        </label>

                        <input class="form-control"
                               value="@Model.MeuCoordinatorPhone"
                               disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Email
                        </label>

                        <input class="form-control"
                               value="@Model.MeuCoordinatorEmail"
                               disabled />
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">
                            Activities During Last Academic Year
                        </label>

                        <textarea class="form-control"
                                  rows="4"
                                  disabled>@Model.MeuActivitiesLastAcademicYear</textarea>
                    </div>
                }

            </div>

        </div>

    </div>
}

<div class="verification-card mt-4">

    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-file-earmark-pdf"></i>
            Supporting Documents
        </h3>
    </div>

    <div class="verification-card-body">

        @if ((ViewBag.FacultyCode?.ToString() ?? "") == "2")
        {
            <!-- DEU -->
            <div class="row">
                <div class="col-md-12">

                    <label class="form-label fw-semibold">
                        DEU Members List
                    </label>

                    @if (Model.HasDeuMembersListFile)
                    {
                        <div class="d-flex align-items-center justify-content-between border rounded p-2">

                            <div>
                                <i class="bi bi-file-earmark-pdf text-danger me-2"></i>
                                DEU Members List (PDF)
                            </div>

                            <div style="min-width: 150px;">
                                @await Html.PartialAsync(
                                    "_DocumentViewerButton",
                                    new DocumentViewerVm
                                    {
                                        Url = Url.Action(
                                            "ViewDeuMembersList",
                                            "VerificationDashboard",
                                            new
                                            {
                                                collegeCode = ViewBag.CollegeCode
                                            })!,
                                        Title = "DEU Members List"
                                    })
                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            No DEU Members List uploaded.
                        </div>
                    }

                </div>
            </div>
        }
        else
        {
            <!-- MEU -->
            <div class="row">
                <div class="col-md-12">

                    <label class="form-label fw-semibold">
                        MEU Members List
                    </label>

                    @if (Model.HasMeuMembersListFile)
                    {
                        <div class="d-flex align-items-center justify-content-between border rounded p-3 bg-light">

                            <div>
                                <i class="bi bi-file-earmark-pdf text-danger me-2"></i>
                                MEU Members List (PDF)
                            </div>

                            <a asp-controller="VerificationDashboard"
                               asp-action="ViewMeuMembersList"
                               asp-route-collegeCode="@ViewBag.CollegeCode"
                               target="_blank"
                               class="btn btn-outline-primary btn-sm">

                                <i class="bi bi-eye"></i>
                                View Document

                            </a>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            No MEU Members List uploaded.
                        </div>
                    }

                </div>
            </div>
        }

    </div>
</div>
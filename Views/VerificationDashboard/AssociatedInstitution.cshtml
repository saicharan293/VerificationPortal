@model VerificationPortal.Models.AssociatedInstitutionVm

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Associated Institution";
    ViewData["ActiveTab"] = "AssociatedInstitution";

    ViewData["InstitutionName"] = Model.PageContext.InstitutionName ?? "Unknown Institution";
    ViewData["CollegeCode"] = Model.PageContext.CollegeCode ?? Model.CollegeCode ?? "";
    ViewData["FacultyName"] = Model.PageContext.FacultyName ?? "";

    ViewData["ShowFeedbackSection"] = true;

    ViewData["CurrentVerifier"] =
        User.Identity?.Name + " - " + Model.UserDesignation;

    ViewData["PrevTabAction"] = Url.Action(
        "HostelDetails",
        "VerificationDashboard",
        new { collegeCode = Model.CollegeCode });

    ViewData["PrevTabLabel"] = "Previous : Hostel Details";

    ViewData["NextTabAction"] = Url.Action(
        "CA_VehicleDetails",
        "VerificationDashboard",
        new { collegeCode = Model.CollegeCode });

    ViewData["NextTabLabel"] = "Next : Vehicle Details";

    var associatedFeedback = Model.SectionFeedback.FirstOrDefault(x => x.SectionName == "Associated Institution Details");
}

@section Scripts {
    <script src="~/js/verification-dashboard.js" asp-append-version="true"></script>
}

<div class="page-header mb-4">
    <h1 class="page-title">
        <i class="bi bi-building"></i>
        Associated Institution
    </h1>

    <p class="text-muted mb-0">
        Review and verify the associated institutions linked to this college.
    </p>
</div>

<div class="note-box mb-4">
    <i class="bi bi-info-circle"></i>

    <div class="note-box-content">
        <h6>Verification Instructions</h6>

        <p>
            Verify the details of the institutions associated with this college
            before approving this section.
        </p>
    </div>
</div>

<div class="verification-card" id="section_@associatedFeedback?.SectionId">

    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-building"></i>
            Associated Institution Details
        </h3>
    </div>

    <div class="verification-card-body">

        @if (Model.AssociatedInstitutions != null && Model.AssociatedInstitutions.Any())
        {
            <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">

                <table class="table table-bordered table-hover align-middle" style="width: 100%;">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Associated College Name</th>
                            <th>Associated Faculty Name</th>
                            <th>Course Name</th>
                            <th>Course Level</th>
                            <th>Annual Intake</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            var index = 1;
                        }

                        @foreach (var item in Model.AssociatedInstitutions)
                        {
                            <tr>
                                <td>@index</td>
                                <td>@(item.AssociatedCollegeName ?? "-")</td>
                                <td>@(item.AssociatedFacultyName ?? "-")</td>
                                <td>@(item.CourseName ?? "-")</td>
                                <td>@(item.CourseLevel ?? "-")</td>
                                <td>@item.AnnualIntake</td>
                            </tr>

                            index++;
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="alert alert-light border mb-0">
                <i class="bi bi-info-circle me-2"></i>
                No associated institutions are linked to this college.
            </div>
        }

        @if (associatedFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", associatedFeedback)
        }

    </div>

</div>
@model VerificationPortal.Models.ResearchPublicationsVerificationViewModel

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";
    ViewData["Title"] = "Research and Publications";
    ViewData["ActiveTab"] = "ResearchPublications";

    ViewData["InstitutionName"] =
        Model.PageContext.InstitutionName ?? "Unknown Institution";

    ViewData["CollegeCode"] = Model.PageContext.CollegeCode ?? "";

    ViewData["FacultyCode"] = Model.PageContext.FacultyId;

    ViewData["ShowFeedbackSection"] = true;

    ViewData["CurrentVerifier"] =
        User.Identity?.Name + " - " + Model.PageContext.CurrentVerifier;

    ViewData["PrevTabAction"] =
        Url.Action(
            "LibraryServices",
            "VerificationDashboard",
            new { collegeCode = Model.PageContext.CollegeCode }
        );

    ViewData["PrevTabLabel"] =
        "Previous : Library Services";

    ViewData["NextTabAction"] =
        Url.Action(
            "NextTab",
            "VerificationDashboard",
            new { collegeCode = Model.PageContext.CollegeCode }
        );

    ViewData["NextTabLabel"] = "Next : Next Section";
}

<!-- ========================================================= -->
<!-- PAGE HEADER -->
<!-- ========================================================= -->

<div class="verification-page-header">

    <h2 class="verification-page-title">
        Research and Publications
    </h2>

    <p class="verification-page-subtitle">
        Research publications, funding and department-wise publication details
    </p>
</div>

<!-- ========================================================= -->
<!-- Research and Publication DETAILS -->
<!-- ========================================================= -->

<div class="verification-card mt-4">

    <div class="verification-card-header">

        <h3 class="verification-card-title">
            <i class="bi bi-journal-richtext me-2"></i>
            Research and Publication Details
        </h3>

        <span class="badge bg-primary">
            Research Details
        </span>

    </div>


    <div class="verification-card-body">

        <div class="row g-4">


            <!-- Publications -->

            <div class="col-md-6">

                <div class="verification-field">

                    <label class="verification-label">
                        Number of Publications
                    </label>

                    <div class="verification-value">

                        @(Model.PublicationsNo?.ToString() ?? "-")

                    </div>

                </div>

            </div>

            
            <!-- Publications Document -->

            <div class="col-md-6">

                <div class="verification-field">

                    <label class="verification-label">
                        Publications Document
                    </label>

                    <div class="verification-value">

                        @if (!string.IsNullOrWhiteSpace(Model.PublicationsPdfName))
                        {
                            @await Html.PartialAsync(
                                "_DocumentViewerButton",
                                new DocumentViewerVm
                                {
                                    Url = Url.Action(
                                        "ViewResearchPublicationPdf",
                                        "VerificationDashboard",
                                        new
                                        {
                                            collegeCode = Model.CollegeCode
                                        })!,
                                    Title = "Publications Document"
                                })
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>

            </div>


            <!-- Students RGUHS Funding -->

            <div class="col-md-6">

                <div class="verification-field">

                    <label class="verification-label">
                        Students Research Project - RGUHS Funded
                    </label>

                    <div class="verification-value">

                        @(Model.StudentsRGUHSFunded?.ToString() ?? "-")

                    </div>

                </div>

            </div>


            <!-- Students External Funding -->

            <div class="col-md-6">

                <div class="verification-field">

                    <label class="verification-label">
                        Students Research Project - External Body Funding
                    </label>

                    <div class="verification-value">

                        @(Model.StudentsExternalBodyFunding?.ToString() ?? "-")

                    </div>

                </div>

            </div>


            <!-- Faculty RGUHS Funding -->

            <div class="col-md-6">

                <div class="verification-field">

                    <label class="verification-label">
                        Faculty Research Project - RGUHS Funded
                    </label>

                    <div class="verification-value">

                        @(Model.FacultyRGUHSFunded?.ToString() ?? "-")

                    </div>

                </div>

            </div>


            <!-- Faculty External Funding -->

            <div class="col-md-6">

                <div class="verification-field">

                    <label class="verification-label">
                        Faculty Research Project - External Body Funding
                    </label>

                    <div class="verification-value">

                        @(Model.FacultyExternalBodyFunding?.ToString() ?? "-")

                    </div>

                </div>

            </div>

        </div>


        @{
            var researchDetailsFeedback = Model.SectionFeedback
                                        ?.FirstOrDefault(x => x.SectionName == "Research and Publication Details");
        }

        @if (researchDetailsFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", researchDetailsFeedback)
        }

        <!-- ================================================= -->
        <!-- UPLOADED DOCUMENTS -->
        <!-- ================================================= -->

        <hr class="my-4" />

        <h5 class="fw-semibold mb-3">
            Uploaded Documents
        </h5>


        <div class="row g-3">

            <!-- Clinical Trials Document -->

            <div class="col-md-6">

                <div class="verification-field">

                    <label class="verification-label">
                        Clinical Trials Document
                    </label>

                    <div class="verification-value">

                        @if (!string.IsNullOrWhiteSpace(Model.ClinicalTrialsPdfName))
                        {
                            @await Html.PartialAsync(
                                "_DocumentViewerButton",
                                new DocumentViewerVm
                                {
                                    Url = Url.Action(
                                        "ViewClinicalTrialsPdf",
                                        "VerificationDashboard",
                                        new
                                        {
                                            collegeCode = Model.CollegeCode
                                        })!,
                                    Title = "Clinical Trials Document"
                                })
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>

            </div>


            <!-- Students Projects Document -->

            <div class="col-md-6">

                <div class="verification-field">

                    <label class="verification-label">
                        Students Projects Document
                    </label>

                    <div class="verification-value">

                        @if (!string.IsNullOrWhiteSpace(Model.StudentsProjectsPdfName))
                        {
                            @await Html.PartialAsync(
                                "_DocumentViewerButton",
                                new DocumentViewerVm
                                {
                                    Url = Url.Action(
                                        "ViewStudentsProjectsPdf",
                                        "VerificationDashboard",
                                        new
                                        {
                                            collegeCode = Model.CollegeCode
                                        })!,
                                    Title = "Students Projects Document"
                                })
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>

            </div>


            <!-- Faculty Projects Document -->

            <div class="col-md-6">

                <div class="verification-field">

                    <label class="verification-label">
                        Faculty Projects Document
                    </label>

                    <div class="verification-value">

                        @if (!string.IsNullOrWhiteSpace(Model.FacultyProjectsPdfName))
                        {
                            @await Html.PartialAsync(
                                "_DocumentViewerButton",
                                new DocumentViewerVm
                                {
                                    Url = Url.Action(
                                        "ViewFacultyProjectsPdf",
                                        "VerificationDashboard",
                                        new
                                        {
                                            collegeCode = Model.CollegeCode
                                        })!,
                                    Title = "Faculty Projects Document"
                                })
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>
    

</div>

<!-- ========================================================= -->
<!-- DEPARTMENT-WISE PUBLICATIONS -->
<!-- ========================================================= -->

@{
    var departmentWisePublicationsFeedback = Model.SectionFeedback
                                ?.FirstOrDefault(x => x.SectionName == "Department wise Publications");
}

<div class="verification-card mt-4">

    
    <div class="verification-card-header">

        <h3 class="verification-card-title">

            <i class="bi bi-building me-2"></i>

            Department Wise Publications

        </h3>

        <span class="badge bg-secondary">
            Department Details
        </span>

    </div>


    <div class="verification-card-body">

        @if (Model.DepartmentWisePublications != null &&
             Model.DepartmentWisePublications.Any())
        {

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th style="width:80px;">
                                Sl. No
                            </th>

                            <th>
                                Department
                            </th>

                            <th class="text-center">
                                Publications Count
                            </th>

                            <th>
                                Publication Document
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @for (int i = 0;
                              i < Model.DepartmentWisePublications.Count;
                              i++)
                        {
                            var row =
                                Model.DepartmentWisePublications[i];

                            <tr>

                                <td class="text-center fw-semibold">
                                    @(i + 1)
                                </td>


                                <td>

                                    <div class="fw-semibold">
                                        @(string.IsNullOrWhiteSpace(row.DeptName)
                                            ? "-"
                                            : row.DeptName)
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(row.DeptCode))
                                    {
                                        <small class="text-muted">
                                            @row.DeptCode
                                        </small>
                                    }

                                </td>


                                <td class="text-center">

                                    @row.PublicationsCount

                                </td>


                                <td>
                                    @if (!string.IsNullOrWhiteSpace(row.PublicationPath))
                                    {
                                        @await Html.PartialAsync(
                                            "_DocumentViewerButton",
                                            new DocumentViewerVm
                                            {
                                                Url = Url.Action(
                                                    "ViewDepartmentPublicationPdf",
                                                    "VerificationDashboard",
                                                    new
                                                    {
                                                        collegeCode = Model.CollegeCode,
                                                        id = row.Id
                                                    })!,
                                                Title = string.IsNullOrWhiteSpace(row.DeptName)
                                                    ? "Department Publication"
                                                    : $"Publication - {row.DeptName}"
                                            })
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        }
        else
        {

            <div class="text-center text-muted py-4">

                <i class="bi bi-info-circle me-2"></i>

                No department-wise publication details available.

            </div>

        }

    </div>

    @if (departmentWisePublicationsFeedback != null)
    {
        @await Html.PartialAsync("_SectionFeedback", departmentWisePublicationsFeedback)
    }
</div>

@section Scripts {

    <script src="~/js/verification-dashboard.js"
            asp-append-version="true">
    </script>

}

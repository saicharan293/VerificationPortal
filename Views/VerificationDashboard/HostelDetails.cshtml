@model VerificationPortal.Models.AffHostelDetailsCreateVm

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Hostel Details";
    ViewData["ActiveTab"] = "HostelDetails";

    ViewData["InstitutionName"] = Model.PageContext.CollegeName ?? "Unknown Institution";
    ViewData["CollegeCode"] = Model.PageContext.CollegeCode ?? Model.CollegeCode ?? "";
    ViewData["FacultyName"] = Model.PageContext.FacultyName ?? "";

    ViewData["ShowFeedbackSection"] = true;

    ViewData["CurrentVerifier"] =
        User.Identity?.Name + " - " + Model.UserDesignation;

    ViewData["PrevTabAction"] = Url.Action(
        "BedDistribution",
        "VerificationDashboard",
        new { collegeCode = Model.CollegeCode });

    ViewData["PrevTabLabel"] = "Previous : Bed Distribution";

    ViewData["NextTabAction"] = Url.Action(
        "HospitalDetails",
        "VerificationDashboard",
        new { collegeCode = Model.CollegeCode });

    ViewData["NextTabLabel"] = "Next : Hospital Details";

    var hostelInfoFeedback = Model.SectionFeedback.FirstOrDefault(x => x.SectionName == "Hostel Information");

    var studentAccomodationFeedback = Model.SectionFeedback.FirstOrDefault(x => x.SectionName == "Student Accommodation");

    var commonRoomFacilitiesFeedback = Model.SectionFeedback.FirstOrDefault(x => x.SectionName == "Common Room Facilities");

    var hostelFacilitiesFeedback = Model.SectionFeedback.FirstOrDefault(x => x.SectionName == "Hostel Facilities");
}
@section Scripts {
    <script src="~/js/verification-dashboard.js" asp-append-version="true"></script>
}

<div class="page-header mb-4">
    <h1 class="page-title">
        <i class="bi bi-house-door"></i>
        Hostel Details
    </h1>

    <p class="text-muted mb-0">
        Review and verify the hostel infrastructure details.
    </p>
</div>

<div class="note-box mb-4">
    <i class="bi bi-info-circle"></i>

    <div class="note-box-content">
        <h6>Verification Instructions</h6>

        <p>
            Verify the hostel infrastructure, accommodation capacity and
            facilities before approving this section.
        </p>
    </div>
</div>

<div class="verification-card" id="section_@hostelInfoFeedback?.SectionId">
    

    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-building"></i>
            Hostel Information
        </h3>
    </div>

    <div class="verification-card-body">

        <div class="row g-4">

            <div class="col-md-6">
                <label class="form-label fw-semibold">
                    Hostel Type
                </label>

                <input class="form-control"
                       value="@Model.Hostel.HostelType"
                       disabled />
            </div>


            <div class="col-md-6">
                <label class="form-label fw-semibold">
                    Built-up Area (Sq. Ft.)
                </label>

                <input class="form-control"
                       value="@Model.Hostel.BuiltUpAreaSqFt"
                       disabled />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">
                    Separate Hostel Available
                </label>

                <input class="form-control"
                       value="@(Model.Hostel.HasSeparateHostel ? "Yes" : "No")"
                       disabled />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">
                    Separate Provision for Male/Female
                </label>

                <input class="form-control"
                       value="@(Model.Hostel.SeparateProvisionMaleFemale ? "Yes" : "No")"
                       disabled />
            </div>
            @if (Model.Hostel.HasSeparateHostel)
            {
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Men Hostel Area (Sq. Ft.)
                    </label>

                    <input class="form-control"
                           value="@Model.Hostel.MenHostelAreaSqFt"
                           disabled />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Women Hostel Area (Sq. Ft.)
                    </label>

                    <input class="form-control"
                           value="@Model.Hostel.WomenHostelAreaSqFt"
                           disabled />
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Hostel.PossessionProofPath))
            {
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Possession Proof
                    </label>

                    @await Html.PartialAsync(
                        "_DocumentViewerButton",
                        new DocumentViewerVm
                        {
                            Url = Url.Action(
                                "ViewHostelDocument",
                                "VerificationDashboard",
                                new
                                {
                                    collegeCode = Model.Hostel.CollegeCode,
                                    documentType = "PossessionProof"
                                })!,
                            Title = "Possession Proof",
                            DocumentId = Model.PossessionProofDocumentId,
                            CollegeCode = Model.Hostel.CollegeCode,
                            FacultyId = Convert.ToInt32(Model.Hostel.FacultyCode)
                        })
                </div>
            }
            else
            {
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Possession Proof
                    </label>

                    <div class="text-muted mt-2">
                        <i class="bi bi-file-earmark-x me-1"></i>
                        Not Uploaded
                    </div>
                </div>
            }

        </div>

        
        @if (hostelInfoFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", hostelInfoFeedback)
        }

    </div>

</div>



<div class="verification-card mt-4"  id="section_@studentAccomodationFeedback?.SectionId">

    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-people"></i>
            Student Accommodation
        </h3>
    </div>

    <div class="verification-card-body">

        <div class="row g-4">

            <div class="col-md-6">
                <label>Total Male Students</label>
                <input class="form-control"
                       value="@Model.Hostel.TotalMaleStudents"
                       disabled />
            </div>

            <div class="col-md-6">
                <label>Total Male Rooms</label>
                <input class="form-control"
                       value="@Model.Hostel.TotalMaleRooms"
                       disabled />
            </div>

            <div class="col-md-6">
                <label>Total Female Students</label>
                <input class="form-control"
                       value="@Model.Hostel.TotalFemaleStudents"
                       disabled />
            </div>

            <div class="col-md-6">
                <label>Total Female Rooms</label>
                <input class="form-control"
                       value="@Model.Hostel.TotalFemaleRooms"
                       disabled />
            </div>

        </div>

        
        @if (studentAccomodationFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", studentAccomodationFeedback)
        }
    </div>
</div>

<div class="verification-card mt-4" id="section_@commonRoomFacilitiesFeedback?.SectionId">

    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-door-open"></i>
            Common Room Facilities
        </h3>
    </div>

    <div class="verification-card-body">

        <div class="row g-4">

            <div class="col-md-6">
                <label>Common Room for Men</label>

                <input class="form-control"
                       value="@(Model.Hostel.CommonRoomMen == true ? "Yes" : "No")"
                       disabled />
            </div>

            <div class="col-md-6">
                <label>Common Room Area for Men (Sq. Ft.)</label>

                <input class="form-control"
                       value="@(Model.Hostel.CommonRoomForMenArea)"
                       disabled />
            </div>

            <div class="col-md-6">
                <label>Common Room for Women</label>

                <input class="form-control"
                       value="@(Model.Hostel.CommonRoomWomen == true ? "Yes" : "No")"
                       disabled />
            </div>

            <div class="col-md-6">
                <label>Common Room Area for Women (Sq. Ft.)</label>

                <input class="form-control"
                       value="@(Model.Hostel.CommonRoomForWomenArea)"
                       disabled />
            </div>

            <div class="col-md-12">
                <label>Any Other Facility</label>

                <textarea class="form-control"
                          rows="3"
                          disabled>@Model.Hostel.AnyOtherFacility</textarea>
            </div>

        </div>
        
        @if (commonRoomFacilitiesFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", commonRoomFacilitiesFeedback)
        }
    </div>

</div>

<div class="verification-card mt-4" id="section_@hostelFacilitiesFeedback?.SectionId">

    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-check2-square"></i>
            Hostel Facilities
        </h3>
    </div>

    <div class="verification-card-body">

        <div class="row g-3">
            <div class="col-md-12">
                <label>Give details of facilities</label>

                <textarea class="form-control"
                        rows="3"
                        disabled>@Model.Hostel.HostelFacilityDetails</textarea>
            </div>

            <div class="col-md-6">
                <label>For men students</label>

                <input class="form-control"
                       value="@Model.Hostel.HostelMenCount"
                       disabled />
            </div>

            <div class="col-md-6">
                <label>For lady students</label>

                <input class="form-control"
                       value="@Model.Hostel.HostelWomenCount"
                       disabled />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">
                    Whether own or rented
                </label>

                <input class="form-control"
                       value="@Model.Hostel.OwnOrRented"
                       disabled />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">
                    Space given to each student (sq.ft)
                </label>

                <input class="form-control"
                       value="@Model.Hostel.SpacePerStudent"
                       disabled />
            </div>

            <div class="col-md-6">
                <strong>Sleeping Furniture</strong><br />
                <span class="badge @(Model.Hostel.SleepingFurniture == true ? "bg-success" : Model.Hostel.SleepingFurniture == false ? "bg-danger" : "bg-secondary")">
                    @(Model.Hostel.SleepingFurniture == true ? "Available" : Model.Hostel.SleepingFurniture == false ? "Not Available" : "Not Provided")
                </span>
            </div>

            <div class="col-md-6">
                <strong>Sanitary & Bathing Facilities</strong><br />
                <span class="badge @(Model.Hostel.SanitaryBathing == true ? "bg-success" : Model.Hostel.SanitaryBathing == false ? "bg-danger" : "bg-secondary")">
                    @(Model.Hostel.SanitaryBathing == true ? "Available" : Model.Hostel.SanitaryBathing == false ? "Not Available" : "Not Provided")
                </span>
            </div>

            <div class="col-md-6">
                <strong>Dining Hall</strong><br />
                <span class="badge @(Model.Hostel.DiningHall == true ? "bg-success" : Model.Hostel.DiningHall == false ? "bg-danger" : "bg-secondary")">
                    @(Model.Hostel.DiningHall == true ? "Available" : Model.Hostel.DiningHall == false ? "Not Available" : "Not Provided")
                </span>
            </div>

            <div class="col-md-6">
                <strong>Common Room</strong><br />
                <span class="badge @(Model.Hostel.HostelCommonRoom == true ? "bg-success" : Model.Hostel.HostelCommonRoom == false ? "bg-danger" : "bg-secondary")">
                    @(Model.Hostel.HostelCommonRoom == true ? "Available" : Model.Hostel.HostelCommonRoom == false ? "Not Available" : "Not Provided")
                </span>
            </div>

            <div class="col-md-6">
                <strong>Visitors Room</strong><br />
                <span class="badge @(Model.Hostel.VisitorsRoom == true ? "bg-success" : Model.Hostel.VisitorsRoom == false ? "bg-danger" : "bg-secondary")">
                    @(Model.Hostel.VisitorsRoom == true ? "Available" : Model.Hostel.VisitorsRoom == false ? "Not Available" : "Not Provided")
                </span>
            </div>

            <div class="col-md-6">
                <strong>Kitchen & Pantry</strong><br />
                <span class="badge @(Model.Hostel.KitchenPantry == true ? "bg-success" : Model.Hostel.KitchenPantry == false ? "bg-danger" : "bg-secondary")">
                    @(Model.Hostel.KitchenPantry == true ? "Available" : Model.Hostel.KitchenPantry == false ? "Not Available" : "Not Provided")
                </span>
            </div>

            <div class="col-md-6">
                <strong>Warden Office</strong><br />
                <span class="badge @(Model.Hostel.WardenOffice == true ? "bg-success" : Model.Hostel.WardenOffice == false ? "bg-danger" : "bg-secondary")">
                    @(Model.Hostel.WardenOffice == true ? "Available" : Model.Hostel.WardenOffice == false ? "Not Available" : "Not Provided")
                </span>
            </div>

            <div class="col-md-6">
                <strong>Reception Counter</strong><br />
                <span class="badge @(Model.Hostel.ReceptionCounter == true ? "bg-success" : Model.Hostel.ReceptionCounter == false ? "bg-danger" : "bg-secondary")">
                    @(Model.Hostel.ReceptionCounter == true ? "Available" : Model.Hostel.ReceptionCounter == false ? "Not Available" : "Not Provided")
                </span>
            </div>

            <div class="col-md-6">
                <strong>Games & Recreation</strong><br />
                <span class="badge @(Model.Hostel.GamesRecreation == true ? "bg-success" : Model.Hostel.GamesRecreation == false ? "bg-danger" : "bg-secondary")">
                    @(Model.Hostel.GamesRecreation == true ? "Available" : Model.Hostel.GamesRecreation == false ? "Not Available" : "Not Provided")
                </span>
            </div>

            <div class="col-md-6">
                <strong>Medical Facilities</strong><br />
                <span class="badge @(Model.Hostel.MedicalFacilities == true ? "bg-success" : Model.Hostel.MedicalFacilities == false ? "bg-danger" : "bg-secondary")">
                    @(Model.Hostel.MedicalFacilities == true ? "Available" : Model.Hostel.MedicalFacilities == false ? "Not Available" : "Not Provided")
                </span>
            </div>

        </div>

        @if (hostelFacilitiesFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", hostelFacilitiesFeedback)
        }

    </div>

</div>

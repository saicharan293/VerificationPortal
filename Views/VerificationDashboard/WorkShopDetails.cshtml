@model VerificationPortal.Models.WorkShopDetailsVerificationVm

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Workshop Details";
    ViewData["ActiveTab"] = "WorkShopDetails";

    ViewData["InstitutionName"] = Model.InstitutionName ?? "Unknown Institution";

    ViewData["CollegeCode"] = Model.CollegeCode ?? "";
    ViewData["FacultyName"] = Model.FacultyName ?? "";

    ViewData["ShowFeedbackSection"] = true;

    ViewData["CurrentVerifier"] =
        User.Identity?.Name + " - " + Model.UserDesignation;

    ViewData["PrevTabAction"] = Url.Action(
        "CA_VehicleDetails",
        "VerificationDashboard",
        new { collegeCode = Model.CollegeCode });

    ViewData["PrevTabLabel"] = "Previous : Vehicle Details";

    ViewData["NextTabAction"] = Url.Action(
        "HospitalDetails",
        "VerificationDashboard",
        new { collegeCode = Model.CollegeCode });

    ViewData["NextTabLabel"] = "Next : Hospital Details";

    var workshopFeedback = Model.SectionFeedback.FirstOrDefault(x => x.SectionId == 65);
}

@section Scripts {
    <script src="~/js/verification-dashboard.js"
            asp-append-version="true"></script>
}

<div class="page-header mb-4">
    <h1 class="page-title">
        <i class="bi bi-tools"></i>
        Workshop Details
    </h1>

    <p class="text-muted mb-0">
        Review and verify the workshop facilities, staff, equipment,
        and scope of work.
    </p>
</div>

<div class="note-box mb-4">
    <i class="bi bi-info-circle"></i>

    <div class="note-box-content">
        <h6>Verification Instructions</h6>
        <p>
            Review the workshop details submitted by the institution.
            Verify the staff, equipment, and scope of work before
            completing the verification of this section.
        </p>
    </div>
</div>

<div class="verification-card">
    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-wrench-adjustable-circle"></i>
            Workshop Information
        </h3>
    </div>

    <div class="verification-card-body">

        @if (Model.WorkshopDetails != null &&
             Model.WorkshopDetails.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>Staff</th>
                            <th>Equipment</th>
                            <th>Scope of Work</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            var index = 1;
                        }

                        @foreach (var workshop in Model.WorkshopDetails)
                        {
                            <tr>
                                <td>@index</td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(workshop.Staff)
                                        ? "-"
                                        : workshop.Staff)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(workshop.Equipment)
                                        ? "-"
                                        : workshop.Equipment)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(workshop.ScopeOfWork)
                                        ? "-"
                                        : workshop.ScopeOfWork)
                                </td>
                            </tr>

                            index++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-light border mb-0">
                <i class="bi bi-info-circle me-2"></i>
                No workshop details have been submitted by this institution.
            </div>
        }

        @if (workshopFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", workshopFeedback)
        }

    </div>
</div>
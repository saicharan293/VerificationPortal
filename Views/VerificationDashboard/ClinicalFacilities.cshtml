@model ClinicalFacilitiesVerificationViewModel

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Clinical Facilities";
    ViewData["ActiveTab"] = "ClinicalFacilities";

    ViewData["InstitutionName"] =
        ViewBag.InstitutionName ?? "Unknown Institution";

    ViewData["CollegeCode"] =
        ViewBag.CollegeCode ?? Model?.CollegeCode ?? "";

    ViewData["FacultyCode"] =
        ViewBag.FacultyCode ?? Model?.FacultyCode.ToString() ?? "";

    ViewData["ShowFeedbackSection"] = true;

    ViewData["CurrentVerifier"] =
        User.Identity?.Name + " - " + ViewBag.UserDesignation;

    ViewData["PrevTabAction"] =
        Url.Action(
            "LibraryDetails",
            "VerificationDashboard",
            new { collegeCode = ViewBag.CollegeCode });

    ViewData["PrevTabLabel"] =
        "Previous : Library Details";

    ViewData["NextTabAction"] =
        Url.Action(
            "NextTab",
            "VerificationDashboard",
            new { collegeCode = ViewBag.CollegeCode });

    ViewData["NextTabLabel"] =
        "Next : Next Section";
}

<div class="verification-page-header">

    <h2 class="verification-page-title">
        Clinical Facilities
    </h2>

    <p class="verification-page-subtitle">
        Clinical hospital details, facilities and related requirements
    </p>

</div>

<div class="container-fluid">

    @await Html.PartialAsync(
        "Partials/ClinicalFacilities/Dental/_ClinicalHospitalDetails",
        Model.HospitalDetails)

    @await Html.PartialAsync(
        "Partials/ClinicalFacilities/Dental/_ClinicalStatistics",
        Model.ClinicalStatistics)

    @if(Model?.FacultyCode.ToString() == "2")
    {
        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Dental/_CertificatesAndDocuments",
            Model.HospitalCertificates)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Dental/_AnatomyActRegistration",
            Model.AnatomyActRegistration)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Dental/_HospitalTieUp",
            Model.HospitalTieUp)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Dental/_DisciplineDetails",
            Model.Disciplines)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Dental/_NPTARequirements",
            Model.NptaRequirementPostvm)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Dental/_EngAlliedRequirements",
            Model.EngAlliedRequirementPostvm)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Dental/_ClinicalWardBedDistribution",
                        Model.DentalWardBedDistribution)
    }
    else if (Model?.FacultyCode.ToString() == "1")
    {
        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Medical/_AffliatedHospitalDocuments",
            Model.HospitalMedicalCertificates)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Medical/_CasualityRequirements",
            Model.CasualityRequirements)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Medical/_CSSDandLaundryRequirements",
            Model.CSSDandLaundryRequirements)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Medical/_RadioDiagnosisRequirements",
            Model.RadioDiagnosisRequirements)
        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Medical/_AnaesthesiologyRequirements",
            Model.AnaesthesiologyRequirements)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Medical/_CentralLaboratoryRequirements",
            Model.CentralLaboratoryRequirements)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Medical/_BloodBankRequirements",
            Model.BloodBankRequirements)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Medical/_YogaRequirements",
            Model.YogaRequirements)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Medical/_RadiationOncologyRequirements",
            Model.RadiationOncologyRequirements)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Medical/_ArtCenterRequirements",
            Model.ArtCenterRequirements)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Medical/_PharmacyRequirements",
            Model.PharmacyRequirements)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Medical/_SuperVisionInFieldPracticeArea.cshtml",
            Model.SuperVisionInFieldPracticeArea)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Medical/_OutpatientAreaRequirements",
            Model.OutpatientAreaRequirements)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Medical/_IndoorBedsRequirements",
            Model.IndoorBedsRequirements)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Medical/_IndoorBedsUnitsRequirements",
            Model.IndoorBedsUnitsRequirements)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Medical/_IndoorDepartmentRequirements",
            Model.IndoorDepartmentRequirements)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Medical/_UtilitiesRequirements",
            Model.UtilitiesRequirements)

        @await Html.PartialAsync(
            "Partials/ClinicalFacilities/Medical/_OTRequirements",
            Model.OTRequirements)

    }


</div>

@section Scripts {
    <script src="~/js/verification-dashboard.js"
            asp-append-version="true"></script>
}
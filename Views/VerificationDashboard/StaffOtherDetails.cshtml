@model VerificationPortal.Models.StaffDetailsCombinedViewModel

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Staff Other Details";
    ViewData["ActiveTab"] = "StaffOtherDetails";

    ViewData["ShowFeedbackSection"] = true;

    var staffOther = Model.StaffOther;
    var page = staffOther?.PageContext;

    ViewData["InstitutionName"] =  page?.InstitutionName ?? "Unknown Institution";

    ViewData["CollegeCode"] =   page?.CollegeCode ?? "";

    ViewData["FacultyCode"] =   page?.FacultyId;


    ViewData["CurrentVerifier"] =  page?.CurrentVerifier;

    ViewData["PrevTabAction"] = Url.Action( "StaffPayScale", "VerificationDashboard",  new { collegeCode =  page?.CollegeCode } );

    ViewData["PrevTabLabel"] = "Previous : Staff Pay Scale";

    ViewData["NextTabAction"] = Url.Action( "NextTab", "VerificationDashboard",  new { collegeCode =  page?.CollegeCode } );

    ViewData["NextTabLabel"] = "Next : Next Section";

    var staffOtherDetailsFeedback = staffOther?.SectionFeedback?.FirstOrDefault(x => x.SectionId == 41);

    var documents = new List<(string Label, string? FileName, int? Id,string FileType, string Title)>
    {
        ("Examiners List", staffOther?.TeachersUpdatedPdfName, staffOther?.TeachersUpdatedPdfId,"EmsList", "Examiners List"),
        ("Form 16 Details", staffOther?.ExaminerDetailsPdfName, staffOther?.ExaminerDetailsPdfId, "Examiner", "Examiner Details"),
        ("Form 16 Details Upload 2", staffOther?.ExaminerDetailsPdfName2, staffOther?.ExaminerDetailsPdf2Id, "Examiner2", "Examiner Details"),
        ("Form 16 Details Upload 3", staffOther?.ExaminerDetailsPdfName3, staffOther?.ExaminerDetailsPdf3Id, "Examiner3", "Examiner Details"),
        ("Form 16 Details Upload 4", staffOther?.ExaminerDetailsPdfName4, staffOther?.ExaminerDetailsPdf4Id, "Examiner4", "Examiner Details Upload 4"),
        ("Form 16 Details Upload 5", staffOther?.ExaminerDetailsPdfName5, staffOther?.ExaminerDetailsPdf5Id, "Examiner5", "Examiner Details Upload 5"),
        ("AEBAS – Last Three Months", staffOther?.AEBASLastThreeMonthsPdfName, staffOther?.AEBASLastThreeMonthsPdfId, "AEBAS3Months", "AEBAS – Last Three Months"),
        ("AEBAS – Inspection Day", staffOther?.AEBASInspectionDayPdfName, staffOther?.AEBASInspectionDayPdfId, "AEBASInspection", "AEBAS – Inspection Day"),
        ("Provident Fund", staffOther?.ProvidentFundPdfName, staffOther?.ProvidentFundPdfId, "PF", "Provident Fund"),
        ("ESI", staffOther?.ESIPdfName, staffOther?.ESIPdfId, "ESI", "ESI")
    };
}

<div class="verification-page-header">

    <h2 class="verification-page-title">
        Staff Other Details
    </h2>

    <p class="verification-page-subtitle">
        Additional staff, examiner and service-register details
    </p>

</div>

<div class="verification-card mt-4">

    <div class="verification-card-header">

        <h3 class="verification-card-title">
            <i class="bi bi-people me-2"></i>
            Staff Other Details
        </h3>

        <span class="badge bg-primary">
            Staff Details
        </span>

    </div>

    <div class="verification-card-body">

        <div class="row g-4">

            <div class="col-md-6">

                <div class="verification-field">

                    <label class="verification-label">
                        Teachers Updated in EMS
                    </label>

                    <div class="verification-value">
                        @(string.IsNullOrWhiteSpace(
                            staffOther?.TeachersUpdatedInEMS)
                            ? "-"
                            : staffOther.TeachersUpdatedInEMS)
                    </div>

                </div>

            </div>


            <div class="col-md-6">

                <div class="verification-field">

                    <label class="verification-label">
                        Examiner Details Attached
                    </label>

                    <div class="verification-value">
                        @(string.IsNullOrWhiteSpace(
                            staffOther?.ExaminerDetailsAttached)
                            ? "-"
                            : staffOther.ExaminerDetailsAttached)
                    </div>

                </div>

            </div>


            <div class="col-md-6">

                <div class="verification-field">

                    <label class="verification-label">
                        Service Register Maintained
                    </label>

                    <div class="verification-value">
                        @(string.IsNullOrWhiteSpace(
                            staffOther?.ServiceRegisterMaintained)
                            ? "-"
                            : staffOther.ServiceRegisterMaintained)
                    </div>

                </div>

            </div>


            <div class="col-md-6">

                <div class="verification-field">

                    <label class="verification-label">
                        Acquittance Register Maintained
                    </label>

                    <div class="verification-value">
                        @(string.IsNullOrWhiteSpace(
                            staffOther?.AcquittanceRegisterMaintained)
                            ? "-"
                            : staffOther.AcquittanceRegisterMaintained)
                    </div>

                </div>

            </div>

        </div>

        @if (staffOtherDetailsFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", staffOtherDetailsFeedback)
        }


        @* Uploaded Documents *@

        <hr class="my-4" />

        <h5 class="fw-semibold mb-3">
            Uploaded Documents
        </h5>

        <div class="row g-3">
            @foreach (var document in documents)
            {
                <div class="col-md-6" key="@document.FileType">
                    <div class="verification-field">
                        <label class="verification-label">
                            @document.Label
                        </label>

                        <div class="verification-value">
                            @if (!string.IsNullOrWhiteSpace(document.FileName))
                            {
                                <div class="d-flex align-items-center justify-content-between gap-2">
                                    <span class="text-break">
                                        @document.FileName
                                    </span>

                                    @await Html.PartialAsync(
                                        "_DocumentViewerButton",
                                        new DocumentViewerVm
                                        {
                                            Url = Url.Action(
                                                "ViewStaffOtherPdf",
                                                "VerificationDashboard",
                                                new
                                                {
                                                    collegeCode = Model.CollegeCode,
                                                    fileType = document.FileType
                                                })!,

                                            Title = document.Title,

                                            FacultyId = Convert.ToInt32(
                                                staffOther?.FacultyCode),

                                            DocumentId = document.Id, // Replace with the actual document ID property

                                            CollegeCode = Model.CollegeCode,

                                            CanVerify = true
                                        })
                                </div>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/verification-dashboard.js" asp-append-version="true"></script>
}
@model VerificationPortal.Models.CA_Aff_AcademicMattersViewModel

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "UG Academic Matters";
    ViewData["ActiveTab"] = "UgAcademicMatters";

    ViewData["InstitutionName"] = ViewBag.InstitutionName ?? "Unknown Institution";

    ViewData["CollegeCode"] = ViewBag.CollegeCode ?? "";

    ViewData["FacultyCode"] = ViewBag.FacultyCode ?? "";

    ViewData["ShowFeedbackSection"] = true;

    ViewData["CurrentVerifier"] = User.Identity?.Name + " - " + ViewBag.UserDesignation;

    ViewData["PrevTabAction"] = Url.Action( "AcademicIntake", "VerificationDashboard", new { collegeCode = ViewBag.CollegeCode });

    ViewData["PrevTabLabel"] = "Previous : Academic Intake";

    // Replace this with your actual next verification tab
    ViewData["NextTabAction"] = Url.Action( "NextTab", "VerificationDashboard", new { collegeCode = ViewBag.CollegeCode });

    ViewData["NextTabLabel"] = "Next : Next Section";
}

<style>
    .academic-performance-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .academic-performance-table-wrapper table {
        min-width: 1000px;
    }
</style>

@section Scripts {
    <script src="~/js/verification-dashboard.js"  asp-append-version="true"></script>
}

<div class="page-header mb-4">

    <h1 class="page-title">
        <i class="bi bi-mortarboard"></i>
        UG Academic Matters
    </h1>

    <p class="text-muted mb-0">
        Review and verify the undergraduate academic performance,
        curriculum, examination schemes and student registers.
    </p>

</div>

<div class="note-box mb-4">

    <i class="bi bi-info-circle"></i>

    <div class="note-box-content">

        <h6>Verification Instructions</h6>

        <p class="mb-0">
            Verify the academic performance records, course curriculum,
            examination schemes and student registers submitted by
            the institution.
        </p>

    </div>

</div>

<div class="verification-card mb-4">

    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-bar-chart-line"></i>
            UG Academic Performance
        </h3>
    </div>

    <div class="verification-card-body">

        @if (Model.AcademicRows != null && Model.AcademicRows.Any())
        {
            <div class="table-responsive academic-performance-table-wrapper">
                <table class="table table-bordered table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Year</th>
                            <th>Regular Students</th>
                            <th>Repeater Students</th>
                            <th>Students Passed</th>
                            <th>Pass Percentage</th>
                            <th>First Class</th>
                            <th>Distinction</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.AcademicRows)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @item.YearName
                                </td>

                                <td>
                                    @(item.RegularStudents?.ToString() ?? "-")
                                </td>

                                <td>
                                    @(item.RepeaterStudents?.ToString() ?? "-")
                                </td>

                                <td>
                                    @(item.NumberOfStudentsPassed?.ToString() ?? "-")
                                </td>

                                <td>
                                    @if (item.PassPercentage.HasValue)
                                    {
                                        @($"{item.PassPercentage:0.##}%")
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>

                                <td>
                                    @(item.FirstClassCount?.ToString() ?? "-")
                                </td>

                                <td>
                                    @(item.DistinctionCount?.ToString() ?? "-")
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Remarks))
                                    {
                                        @item.Remarks
                                    }
                                    else
                                    {
                                        <span class="text-muted">No remarks</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="alert alert-warning mb-0">
                <i class="bi bi-exclamation-triangle me-2"></i>
                No academic performance records found.
            </div>
        }

    </div>

</div>
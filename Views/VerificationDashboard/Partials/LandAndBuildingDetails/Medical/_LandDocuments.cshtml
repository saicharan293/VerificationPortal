@model VerificationPortal.Models.MedicalLandBuildingVerificationVm

<h5 class="fw-bold mb-3 border-bottom pb-2">
    <i class="bi bi-file-earmark-text me-2"></i>
    Land Documents
</h5>

<div class="row g-3 mb-4">

    @foreach (var document in Model.LandDocuments)
    {
        <div class="col-md-12">
            <div class="border rounded-3 p-3 h-100">

                <label class="form-label fw-semibold"> @document.Label </label>

                @if (!string.IsNullOrWhiteSpace(document.Path))
                {
                    <div class="mt-2">
                        @await Html.PartialAsync(
                            "_DocumentViewerButton",
                            new DocumentViewerVm
                            {
                                Url = Url.Action(document.Action, "VerificationDashboard",
                                    new
                                    {
                                        id = Model.Id,
                                        documentType = document.DocumentType
                                    })!,
                                Title = document.Label,
                                DocumentId = document.DocumentId,
                                FacultyId = Model.PageContext.FacultyId,
                                CollegeCode = Model.PageContext.CollegeCode
                            })
                    </div>
                }
                else
                {
                    <div class="text-muted small mt-2">
                        <i class="bi bi-exclamation-circle me-1"></i>
                        Not Uploaded
                    </div>
                }

            </div>
        </div>
    }

</div>
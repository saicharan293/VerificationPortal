@model VerificationPortal.Models.InstitutionDetailsVerificationVm

@{
    var sectionFeedback = Model.SectionFeedback  ?? new List<VerificationPortal.Models.SectionFeedbackViewModel>();

    var addressFeedback = sectionFeedback.FirstOrDefault(x => x.SectionName == "Address Details");
}

<div class="verification-card"  id="section_@addressFeedback?.SectionId">
    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-geo-alt"></i>
            Address Details
        </h3>
    </div>
    <div class="verification-card-body">
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label">Address</label>
                <textarea class="form-control" rows="2" disabled>@Model.Institution.Address</textarea>
            </div>
            <div class="col-md-4">
                <label class="form-label">Village/Town/City</label>
                <input type="text" class="form-control" value="@Model.Institution.VillageTownCity" disabled />
            </div>
            <div class="col-md-4">
                <label class="form-label">Taluk</label>
                <input type="text" class="form-control" value="@Model.TalukText" disabled />
            </div>
            <div class="col-md-4">
                <label class="form-label">District</label>
                <input type="text" class="form-control" value="@Model.DistrictText" disabled />
            </div>
            <div class="col-md-4">
                <label class="form-label">Pin Code</label>
                <input type="text" class="form-control" value="@Model.Institution.PinCode" disabled />
            </div>
            <div class="col-md-4">
                <label class="form-label">STD Code</label>
                <input type="text" class="form-control" value="@Model.Institution.StdCode" disabled />
            </div>
            <div class="col-md-4">
                <label class="form-label">Fax</label>
                <input type="text" class="form-control" value="@Model.Institution.Fax" disabled />
            </div>
        </div>

        @if (addressFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", addressFeedback)
        }
    </div>
</div>

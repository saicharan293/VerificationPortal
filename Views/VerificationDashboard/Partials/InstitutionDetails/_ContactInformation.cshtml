@model VerificationPortal.Models.InstitutionDetailsVerificationVm

@{
    var sectionFeedback = Model.SectionFeedback  ?? new List<VerificationPortal.Models.SectionFeedbackViewModel>();
    var contactFeedback = sectionFeedback.FirstOrDefault(x => x.SectionName == "Contact Information");
}

<div class="verification-card" id="section_@contactFeedback?.SectionId">
    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-telephone"></i>
            Contact Information
        </h3>
    </div>
    <div class="verification-card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Mobile Number</label>
                <input type="text" class="form-control" value="@Model.Institution.MobileNumber" disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">Email ID</label>
                <input type="email" class="form-control" value="@Model.Institution.EmailId" disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">Alternate Landline/Mobile</label>
                <input type="text" class="form-control" value="@Model.Institution.AltLandlineMobile" disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">Alternate Email ID</label>
                <input type="email" class="form-control" value="@Model.Institution.AltEmailId" disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">Website</label>
                <input type="url" class="form-control" value="@Model.Institution.Website" disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">College URL</label>
                <input type="url" class="form-control" value="@Model.Institution.CollegeUrl" disabled />
            </div>
        </div>

        @if (contactFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", contactFeedback)
        }

    </div>
</div>

@model VerificationPortal.Models.InstitutionDetailsVerificationVm

@{
    var sectionFeedback = Model.SectionFeedback  ?? new List<VerificationPortal.Models.SectionFeedbackViewModel>();
    var trustFeedback = sectionFeedback.FirstOrDefault( x => x.SectionName == "Trust Details");
}

<div class="verification-card" id="section_@trustFeedback?.SectionId">
        <div class="verification-card-header">
            <h3 class="verification-card-title">
                <i class="bi bi-building"></i>
                Trust Details <small style="font-size: 0.675em;">(Preview - Full details in Trust Details tab)</small>
            </h3>
        </div>
        <div class="verification-card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Trust Name</label>
                    <input type="text" class="form-control" value="@Model.Institution.TrustName" disabled />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Trust President</label>
                    <input type="text" class="form-control" value="@Model.Institution.TrustPresidentName" disabled />
                </div>
                <div class="col-md-4">
                    <label class="form-label">President Contact</label>
                    <input type="text" class="form-control" value="@Model.Institution.TrustPresidentContactNo" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Trust Address</label>
                    <input type="text" class="form-control" value="@Model.Institution.TrustAddress" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Trust Establishment Date</label>
                    <input type="text" class="form-control" value="@(Model.Institution.TrustEstablishmentDate?.ToString("dd MMM yyyy") ?? "")" disabled />
                </div>
            </div>

            @if (trustFeedback != null)
            {
                @await Html.PartialAsync("_SectionFeedback", trustFeedback)
            }
        </div>
    </div>
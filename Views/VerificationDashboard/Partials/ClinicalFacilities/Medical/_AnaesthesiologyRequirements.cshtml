@model VerificationPortal.Models.AnaesthesiologyRequirementsVerificationVM

<div class="verification-card mt-4">

    @{
        var anaesthesiologyFeedback = (ViewBag.SectionFeedback as List<VerificationPortal.Models.SectionFeedbackViewModel>)
                                    ?.FirstOrDefault(x => x.SectionName == "Anaesthesiology Requirements");
    }

    <div class="verification-card-header" id="section_@anaesthesiologyFeedback?.SectionId">

        <h3 class="verification-card-title">
            <i class="bi bi-heart-pulse me-2"></i>
            Anaesthesiology Requirements
        </h3>

        <span class="badge bg-primary">
            @(Model?.Requirements?.Count ?? 0) Requirements
        </span>

    </div>

    <div class="verification-card-body">

        @if (Model == null ||
             Model.Requirements == null ||
             !Model.Requirements.Any())
        {
            <div class="alert alert-info mb-0">
                No Anaesthesiology Requirements found.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Requirement</th>
                            <th>Availability</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            var serialNo = 1;
                        }

                        @foreach (var requirement in Model.Requirements)
                        {
                            <tr>

                                <td>
                                    @serialNo
                                </td>

                                <td class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(requirement.RequirementName)
                                        ? "-"
                                        : requirement.RequirementName)
                                </td>

                                <td>
                                    @if (requirement.IsAvailable)
                                    {
                                        <span class="badge bg-success">
                                            Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Not Available
                                        </span>
                                    }
                                </td>

                            </tr>

                            serialNo++;
                        }

                    </tbody>

                </table>

            </div>
        }

        @if (anaesthesiologyFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", anaesthesiologyFeedback)
        }

    </div>

</div>
@model VerificationPortal.Models.ClassroomAndLaboratoryViewModel

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Classroom & Laboratory";

    ViewData["ActiveTab"] =
        ViewBag.ActiveTab ?? "ClassroomAndLaboratory";

    ViewData["InstitutionName"] =
        ViewBag.InstitutionName ?? "Unknown Institution";

    ViewData["CollegeCode"] =
        ViewBag.CollegeCode ?? "";

    ViewData["ShowFeedbackSection"] = true;
    ViewData["ShowFeedbackForm"] = ViewData["ShowFeedbackForm"];

    ViewData["CurrentVerifier"] =
        $"{User.Identity?.Name} - {ViewBag.UserDesignation}";

    ViewData["PrevTabAction"] =
        Url.Action(
            "LandAndBuildingDetails",
            new { collegeCode = ViewBag.CollegeCode });

    ViewData["PrevTabLabel"] =
        "Previous: Land & Building";

    ViewData["NextTabAction"] =
        Url.Action(
            "TeachingStaffDepartmentWise",
            new { collegeCode = ViewBag.CollegeCode });

    ViewData["NextTabLabel"] =
        "Next: Teaching Staff";
}

@section Scripts
{
    <script src="~/js/verification-dashboard.js"
            asp-append-version="true"></script>
}


<!-- ========================================================= -->
<!-- PAGE HEADER -->
<!-- ========================================================= -->

<div class="page-header mb-4">

    <h1 class="page-title">
        <i class="bi bi-building"></i>
        Classroom & Laboratory
    </h1>

    <p class="text-muted mb-0">
        Review the classroom and laboratory infrastructure
        before verification.
    </p>

</div>


<!-- ========================================================= -->
<!-- VERIFICATION INSTRUCTIONS -->
<!-- ========================================================= -->

<div class="note-box mb-4">

    <i class="bi bi-info-circle"></i>

    <div class="note-box-content">

        <h6>Verification Instructions</h6>

        <p class="mb-0">
            Verify that the available area satisfies the required
            norms for each classroom and laboratory requirement.
            Review all infrastructure and facilities before
            marking the verification status.
        </p>

    </div>

</div>


@if (Model?.MedicalSkillsLaboratory != null)
{
    <!-- ========================================================= -->
    <!-- MEDICAL SKILLS LABORATORY -->
    <!-- ========================================================= -->

    <div class="verification-card mb-4">

        <div class="verification-card-header">

            <h3 class="verification-card-title">
                <i class="bi bi-hospital"></i>
                Medical Skills Laboratory
            </h3>

        </div>


        <div class="verification-card-body">

            <!-- ================================================= -->
            <!-- AREA & CAPACITY SUMMARY -->
            <!-- ================================================= -->

            <div class="row g-3">

                <div class="col-md">

                    <div class="border rounded p-3 h-100">

                        <label class="form-label fw-bold text-muted">
                            Required Area
                        </label>

                        <div class="fs-5">
                            @Model.MedicalSkillsLaboratory.TotalAreaRequiredSqm.ToString("0.##")
                            <small class="text-muted">
                                Sq.m
                            </small>
                        </div>

                    </div>

                </div>


                <div class="col-md">

                    <div class="border rounded p-3 h-100">

                        <label class="form-label fw-bold text-muted">
                            Available Area
                        </label>

                        <div class="fs-5">
                            @Model.MedicalSkillsLaboratory.TotalAreaAvailableSqm
                            <small class="text-muted">
                                Sq.m
                            </small>
                        </div>

                    </div>

                </div>


                <div class="col-md">

                    <div class="border rounded p-3 h-100">

                        <label class="form-label fw-bold text-muted">
                            Deficiency
                        </label>

                        <div class="fs-5">
                            @Model.MedicalSkillsLaboratory.TotalAreaDeficiencySqm
                            <small class="text-muted">
                                Sq.m
                            </small>
                        </div>

                    </div>

                </div>


                <div class="col-md">

                    <div class="border rounded p-3 h-100">

                        <label class="form-label fw-bold text-muted">
                            Skill Stations
                        </label>

                        <div class="fs-5">
                            @Model.MedicalSkillsLaboratory.NumberOfSkillStations
                        </div>

                    </div>

                </div>


                <div class="col-md">

                    <div class="border rounded p-3 h-100">

                        <label class="form-label fw-bold text-muted">
                            Examination Rooms
                        </label>

                        <div class="fs-5">
                            @Model.MedicalSkillsLaboratory.NumberOfExaminationRooms
                        </div>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <!-- ================================================= -->
            <!-- FACILITY REQUIREMENTS -->
            <!-- ================================================= -->

            <h5 class="form-section-title mb-3">

                <i class="bi bi-check2-square me-2"></i>

                Facility Requirements

            </h5>


            <div class="row g-3">

                <!-- LEFT COLUMN -->

                <div class="col-lg-6">

                    <div class="border rounded">

                        <div class="p-3 border-bottom fw-semibold">
                            Infrastructure & Training
                        </div>

                        <div class="p-3">

                            <div class="row g-3">

                                <div class="col-12">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <span>
                                            Training Before Clinical
                                        </span>

                                        <span class="badge @(Model.MedicalSkillsLaboratory.SixWeeksTrainingCompletedBeforeClinical
                                            ? "bg-success"
                                            : "bg-danger")">

                                            @(Model.MedicalSkillsLaboratory
                                                .SixWeeksTrainingCompletedBeforeClinical
                                                ? "Yes"
                                                : "No")

                                        </span>

                                    </div>

                                </div>


                                <div class="col-12">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <span>
                                            Minimum Four Exam Rooms
                                        </span>

                                        <span class="badge @(Model.MedicalSkillsLaboratory.HasMinFourExamRooms
                                            ? "bg-success"
                                            : "bg-danger")">

                                            @(Model.MedicalSkillsLaboratory
                                                .HasMinFourExamRooms
                                                ? "Yes"
                                                : "No")

                                        </span>

                                    </div>

                                </div>


                                <div class="col-12">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <span>
                                            Demo Room
                                        </span>

                                        <span class="badge @(Model.MedicalSkillsLaboratory.HasDemoRoomSmallGroups
                                            ? "bg-success"
                                            : "bg-danger")">

                                            @(Model.MedicalSkillsLaboratory
                                                .HasDemoRoomSmallGroups
                                                ? "Yes"
                                                : "No")

                                        </span>

                                    </div>

                                </div>


                                <div class="col-12">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <span>
                                            Debrief Area
                                        </span>

                                        <span class="badge @(Model.MedicalSkillsLaboratory.HasDebriefArea
                                            ? "bg-success"
                                            : "bg-danger")">

                                            @(Model.MedicalSkillsLaboratory
                                                .HasDebriefArea
                                                ? "Yes"
                                                : "No")

                                        </span>

                                    </div>

                                </div>


                                <div class="col-12">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <span>
                                            Faculty Coordinator Room
                                        </span>

                                        <span class="badge @(Model.MedicalSkillsLaboratory.HasFacultyCoordinatorRoom
                                            ? "bg-success"
                                            : "bg-danger")">

                                            @(Model.MedicalSkillsLaboratory
                                                .HasFacultyCoordinatorRoom
                                                ? "Yes"
                                                : "No")

                                        </span>

                                    </div>

                                </div>


                                <div class="col-12">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <span>
                                            Support Staff Room
                                        </span>

                                        <span class="badge @(Model.MedicalSkillsLaboratory.HasSupportStaffRoom
                                            ? "bg-success"
                                            : "bg-danger")">

                                            @(Model.MedicalSkillsLaboratory
                                                .HasSupportStaffRoom
                                                ? "Yes"
                                                : "No")

                                        </span>

                                    </div>

                                </div>


                                <div class="col-12">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <span>
                                            Storage for Mannequins
                                        </span>

                                        <span class="badge @(Model.MedicalSkillsLaboratory.HasStorageForMannequins
                                            ? "bg-success"
                                            : "bg-danger")">

                                            @(Model.MedicalSkillsLaboratory
                                                .HasStorageForMannequins
                                                ? "Yes"
                                                : "No")

                                        </span>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- RIGHT COLUMN -->

                <div class="col-lg-6">

                    <div class="border rounded">

                        <div class="p-3 border-bottom fw-semibold">
                            Facilities & Support
                        </div>

                        <div class="p-3">

                            <div class="row g-3">

                                <div class="col-12">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <span>
                                            Video Recording Facility
                                        </span>

                                        <span class="badge @(Model.MedicalSkillsLaboratory.HasVideoRecordingFacility
                                            ? "bg-success"
                                            : "bg-danger")">

                                            @(Model.MedicalSkillsLaboratory
                                                .HasVideoRecordingFacility
                                                ? "Yes"
                                                : "No")

                                        </span>

                                    </div>

                                </div>


                                <div class="col-12">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <span>
                                            Required Trainers & Mannequins
                                        </span>

                                        <span class="badge @(Model.MedicalSkillsLaboratory.HasRequiredTrainersAndMannequins
                                            ? "bg-success"
                                            : "bg-danger")">

                                            @(Model.MedicalSkillsLaboratory
                                                .HasRequiredTrainersAndMannequins
                                                ? "Yes"
                                                : "No")

                                        </span>

                                    </div>

                                </div>


                                <div class="col-12">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <span>
                                            Dedicated Technical Officer
                                        </span>

                                        <span class="badge @(Model.MedicalSkillsLaboratory.HasDedicatedTechnicalOfficer
                                            ? "bg-success"
                                            : "bg-danger")">

                                            @(Model.MedicalSkillsLaboratory
                                                .HasDedicatedTechnicalOfficer
                                                ? "Yes"
                                                : "No")

                                        </span>

                                    </div>

                                </div>


                                <div class="col-12">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <span>
                                            Adequate Support Staff
                                        </span>

                                        <span class="badge @(Model.MedicalSkillsLaboratory.HasAdequateSupportStaff
                                            ? "bg-success"
                                            : "bg-danger")">

                                            @(Model.MedicalSkillsLaboratory
                                                .HasAdequateSupportStaff
                                                ? "Yes"
                                                : "No")

                                        </span>

                                    </div>

                                </div>


                                <div class="col-12">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <span>
                                            Teaching Areas AV Enabled
                                        </span>

                                        <span class="badge @(Model.MedicalSkillsLaboratory.TeachingAreasHaveAv
                                            ? "bg-success"
                                            : "bg-danger")">

                                            @(Model.MedicalSkillsLaboratory
                                                .TeachingAreasHaveAv
                                                ? "Yes"
                                                : "No")

                                        </span>

                                    </div>

                                </div>


                                <div class="col-12">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <span>
                                            Internet Facility
                                        </span>

                                        <span class="badge @(Model.MedicalSkillsLaboratory.TeachingAreasHaveInternet
                                            ? "bg-success"
                                            : "bg-danger")">

                                            @(Model.MedicalSkillsLaboratory
                                                .TeachingAreasHaveInternet
                                                ? "Yes"
                                                : "No")

                                        </span>

                                    </div>

                                </div>


                                <div class="col-12">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <span>
                                            E-learning Enabled
                                        </span>

                                        <span class="badge @(Model.MedicalSkillsLaboratory.SkillsLabEnabledForElearning
                                            ? "bg-success"
                                            : "bg-danger")">

                                            @(Model.MedicalSkillsLaboratory
                                                .SkillsLabEnabledForElearning
                                                ? "Yes"
                                                : "No")

                                        </span>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>
         @{
            var classroomFeedback = (ViewBag.SectionFeedback as List<VerificationPortal.Models.SectionFeedbackViewModel>)
                                        ?.FirstOrDefault(x => x.SectionId == 27);
        }
        @if (classroomFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", classroomFeedback)
        }

    </div>
}
else
{
    <!-- ========================================================= -->
    <!-- NO DATA -->
    <!-- ========================================================= -->

    <div class="verification-card">

        <div class="verification-card-body">

            <div class="text-center text-muted py-5">

                <i class="bi bi-database-x fs-1 d-block mb-3 opacity-50"></i>

                <h5>
                    No Medical Skills Laboratory Details Available
                </h5>

                <p class="mb-0">
                    No classroom or laboratory infrastructure
                    details were found for this institution.
                </p>

            </div>

        </div>

    </div>
}
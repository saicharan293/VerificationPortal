
@model VerificationPortal.Models.AnimalHouseDetailsVerificationVm

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Animal House Details";
    ViewData["ActiveTab"] = "AnimalHouseDetails";

    ViewData["InstitutionName"] = Model.PageContext.InstitutionName ?? "Unknown Institution";

    ViewData["CollegeCode"] = Model.PageContext.CollegeCode ?? string.Empty;

    ViewData["FacultyName"] = Model.PageContext.FacultyName ?? string.Empty;

    ViewData["ShowFeedbackSection"] = true;

    ViewData["CurrentVerifier"] = Model.PageContext.CurrentVerifier ?? string.Empty;

    ViewData["PrevTabAction"] = Model.PageContext.PrevTabAction;
    ViewData["PrevTabLabel"] = Model.PageContext.PrevTabLabel;

    ViewData["NextTabAction"] = Model.PageContext.NextTabAction;
    ViewData["NextTabLabel"] = Model.PageContext.NextTabLabel;

    // Replace 13 with the configured Animal House section ID.
    var animalHouseFeedback = Model.SectionFeedback.FirstOrDefault(x => x.SectionId == 66);
}

@section Scripts {
    <script src="~/js/verification-dashboard.js" asp-append-version="true"></script>
}

<div class="page-header mb-4">
    <h1 class="page-title">
        <i class="bi bi-hospital"></i>
        Animal House Details
    </h1>

    <p class="text-muted mb-0">
        Review and verify the animal house facilities, available area,
        staff, and types of animals maintained by the institution.
    </p>
</div>

<div class="note-box mb-4">
    <i class="bi bi-info-circle"></i>

    <div class="note-box-content">
        <h6>Verification Instructions</h6>

        <p class="mb-0">
            Review the animal house details submitted by the institution.
            Verify the reported area, staff availability, and types of
            animals maintained for the respective course levels before
            completing verification.
        </p>
    </div>
</div>

<div class="verification-card mb-4">
    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-clipboard2-pulse"></i>
            Animal House Information
        </h3>
    </div>

    <div class="verification-card-body">

        @if (Model.AnimalHouseDetails != null &&
             Model.AnimalHouseDetails.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>Area</th>
                            <th>Staff</th>
                            <th>Types of Animals</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            var index = 1;
                        }

                        @foreach (var animalHouse in Model.AnimalHouseDetails)
                        {
                            <tr>
                                <td>@index</td>


                                <td>
                                    @(
                                        animalHouse.Area.HasValue
                                            ? animalHouse.Area.Value.ToString("0.##")
                                            : "-"
                                    )
                                </td>

                                <td>
                                    @(
                                        string.IsNullOrWhiteSpace(animalHouse.Staff)
                                            ? "-"
                                            : animalHouse.Staff
                                    )
                                </td>

                                <td>
                                    @(
                                        string.IsNullOrWhiteSpace(animalHouse.TypeOfAnimals)
                                            ? "-"
                                            : animalHouse.TypeOfAnimals
                                    )
                                </td>
                            </tr>

                            index++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-light border mb-0">
                <i class="bi bi-info-circle me-2"></i>
                No animal house details have been submitted by this institution.
            </div>
        }

        @if (animalHouseFeedback != null)
        {
            @await Html.PartialAsync( "_SectionFeedback", animalHouseFeedback)
        }

    </div>
</div>

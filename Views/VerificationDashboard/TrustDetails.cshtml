@model VerificationPortal.Models.InstitutionBasicDetail

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Trust Details - Verification Dashboard";
    ViewData["ActiveTab"] = "TrustDetails";

    ViewData["InstitutionName"] =
        Model?.NameOfInstitution ?? "Unknown Institution";

    ViewData["CollegeCode"] =
        Model?.CollegeCode ?? "";

    ViewData["FacultyName"] =
        Model?.FacultyCode ?? "";

    ViewData["VerificationStatus"] =
        Model?.OverallStatus
        ?? (Model?.IsDeoVerified == true
            ? "Verified"
            : Model?.IsDeoVerified == false
                ? "Rejected"
                : "Pending");

    ViewData["StatusBadgeClass"] =
        Model?.OverallStatus == "Verified"
            ? "verified"
            : Model?.OverallStatus == "Rejected"
                ? "rejected"
                : "pending";

    // Enable feedback section
    ViewData["ShowFeedbackSection"] = true;

    // DO NOT set ShowFeedbackForm here.
    // SetVerificationViewData<InstitutionBasicDetail>()
    // controls whether the editable form or display-only section is shown.

    ViewData["CurrentVerifier"] =
        User.Identity?.Name + " - " + ViewBag.UserDesignation;

    ViewData["NextTabAction"] =
        Url.Action(
            "TrustMemberDetails",
            "VerificationDashboard",
            new { collegeCode = Model?.CollegeCode });

    ViewData["NextTabLabel"] =
        "Next: Trust Member Details";

    ViewData["PrevTabAction"] =
        Url.Action(
            "InstitutionDetails",
            "VerificationDashboard",
            new { collegeCode = Model?.CollegeCode });

    ViewData["PrevTabLabel"] =
        "Previous: Institution Details";
}

@section Styles {
}

@{
    ViewBag.ActiveTab = "TrustDetails";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <h1 class="page-title">
        <i class="bi bi-building"></i>
        Trust Details
    </h1>
    <p class="text-muted mb-0">Review and verify trust information for this institution</p>
</div>

<!-- Note Box -->
<div class="note-box mb-4">
    <i class="bi bi-info-circle"></i>
    <div class="note-box-content">
        <h6>Verification Instructions</h6>
        <p>Review the trust details below. Provide your remarks in the remarks field below, and select the verification status (Accept/Reject). Once completed, you can proceed to the next tab: <strong>Trust Member Details</strong>.</p>
    </div>
</div>

    <!-- Trust Information Card -->
    <div class="verification-card mb-4">
        <div class="verification-card-header">
            <h3 class="verification-card-title">
                <i class="bi bi-building"></i>
                Trust Information
            </h3>
        </div>
        <div class="verification-card-body">
            <div class="row g-3">
                <!-- Institution Basic Details -->
                <div class="col-md-6">
                    <label class="form-label">Faculty Code</label>
                    <input type="text" class="form-control" value="@Model.FacultyCode" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">College Code</label>
                    <input type="text" class="form-control" value="@Model.CollegeCode" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Type of Organization</label>
                    <input type="text" class="form-control" value="@Model.TypeOfOrganization" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Type of Institution</label>
                    <input type="text" class="form-control" value="@Model.TypeOfInstitution" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Name of Institution</label>
                    <input type="text" class="form-control" value="@Model.NameOfInstitution" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Village/Town/City</label>
                    <input type="text" class="form-control" value="@Model.VillageTownCity" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Taluk</label>
                    <input type="text" class="form-control" value="@Model.Taluk" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">District</label>
                    <input type="text" class="form-control" value="@Model.District" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Pin Code</label>
                    <input type="text" class="form-control" value="@Model.PinCode" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Mobile Number</label>
                    <input type="text" class="form-control" value="@Model.MobileNumber" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">STD Code</label>
                    <input type="text" class="form-control" value="@Model.StdCode" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Fax</label>
                    <input type="text" class="form-control" value="@Model.Fax" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Website</label>
                    <input type="text" class="form-control" value="@Model.Website" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Email ID</label>
                    <input type="text" class="form-control" value="@Model.EmailId" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Alt Landline/Mobile</label>
                    <input type="text" class="form-control" value="@Model.AltLandlineOrMobile" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Alt Email ID</label>
                    <input type="text" class="form-control" value="@Model.AltEmailId" disabled />
                </div>

                <!-- Institution Address -->
                <div class="col-12">
                    <label class="form-label">Address of Institution</label>
                    <textarea class="form-control" rows="2" disabled>@Model.AddressOfInstitution</textarea>
                </div>

                <!-- Academic & Category Details -->
                <div class="col-md-6">
                    <label class="form-label">Academic Year Started</label>
                    <input type="text" class="form-control" value="@Model.AcademicYearStarted" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Is Rural Institution</label>
                    <input type="text" class="form-control" value="@(Model.IsRuralInstitution == true ? "Yes" : Model.IsRuralInstitution == false ? "No" : "Not specified")" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Is Minority Institution</label>
                    <input type="text" class="form-control" value="@(Model.IsMinorityInstitution == true ? "Yes" : Model.IsMinorityInstitution == false ? "No" : "Not specified")" disabled />
                </div>

                <!-- Trust Details -->
                <div class="col-md-6">
                    <label class="form-label">Trust Name</label>
                    <input type="text" class="form-control" value="@Model.TrustName" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">President Name</label>
                    <input type="text" class="form-control" value="@Model.PresidentName" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Aadhaar Number</label>
                    <input type="text" class="form-control" value="@Model.AadhaarNumber" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">PAN Number</label>
                    <input type="text" class="form-control" value="@Model.Pannumber" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Registration Number</label>
                    <input type="text" class="form-control" value="@Model.RegistrationNumber" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Registration Date</label>
                    <input type="text" class="form-control" value="@(Model.RegistrationDate?.ToString("dd MMM yyyy") ?? "Not provided")" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Amendments</label>
                    <input type="text" class="form-control" value="@(Model.Amendments == true ? "Yes" : Model.Amendments == false ? "No" : "Not specified")" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Existing Trust Name</label>
                    <input type="text" class="form-control" value="@Model.ExistingTrustName" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">GOK Obtained Trust Name</label>
                    <input type="text" class="form-control" value="@Model.GokobtainedTrustName" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Changes in Trust Name</label>
                    <input type="text" class="form-control" value="@(Model.ChangesInTrustName == true ? "Yes" : Model.ChangesInTrustName == false ? "No" : "Not specified")" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Other Nursing College in City</label>
                    <input type="text" class="form-control" value="@(Model.OtherNursingCollegeInCity == true ? "Yes" : Model.OtherNursingCollegeInCity == false ? "No" : "Not specified")" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Category of Organisation</label>
                    <input type="text" class="form-control" value="@Model.CategoryOfOrganisation" disabled />
                </div>

                <!-- Contact Person Details -->
                <div class="col-md-6">
                    <label class="form-label">Contact Person Name</label>
                    <input type="text" class="form-control" value="@Model.ContactPersonName" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Contact Person Relation</label>
                    <input type="text" class="form-control" value="@Model.ContactPersonRelation" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Contact Person Mobile</label>
                    <input type="text" class="form-control" value="@Model.ContactPersonMobile" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Other Physiotherapy College in City</label>
                    <input type="text" class="form-control" value="@(Model.OtherPhysiotherapyCollegeInCity == true ? "Yes" : Model.OtherPhysiotherapyCollegeInCity == false ? "No" : "Not specified")" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Courses Applied Text</label>
                    <input type="text" class="form-control" value="@Model.CoursesAppliedText" disabled />
                </div>

                <!-- Head of Institution & Financing -->
                <div class="col-md-6">
                    <label class="form-label">Head of Institution Name</label>
                    <input type="text" class="form-control" value="@Model.HeadOfInstitutionName" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Head of Institution Address</label>
                    <input type="text" class="form-control" value="@Model.HeadOfInstitutionAddress" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Financing Authority Name</label>
                    <input type="text" class="form-control" value="@Model.FinancingAuthorityName" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">College Status</label>
                    <input type="text" class="form-control" value="@Model.CollegeStatus" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Gov. Autonomous Cert. Number</label>
                    <input type="text" class="form-control" value="@Model.GovAutonomousCertNumber" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">KNC Certificate Number</label>
                    <input type="text" class="form-control" value="@Model.KncCertificateNumber" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Created On</label>
                    <input type="text" class="form-control" value="@Model.CreatedOn.ToString("dd MMM yyyy HH:mm")" disabled />
                </div>

                <!-- Required Documents -->
                <div class="col-12">
                    <h5 class="border-bottom pb-2 mb-3">Required Documents</h5>
                </div>

            <!-- Amended Document -->
            <div class="col-md-6">
                <label class="form-label">GOK order Document</label>

                @if (!string.IsNullOrWhiteSpace(Model.GokOrderExistingCoursesFilePath))
                {
                    @await Html.PartialAsync(
                        "_DocumentViewerButton",
                        new DocumentViewerVm
                        {
                            Url = Url.Action(
                                "ViewGokOrderDocument",
                                "VerificationDashboard",
                                new
                                {
                                    id = Model.InstitutionId,
                                    documentType = "AmendedDoc"
                                })!,
                            Title = "Amended Document"
                        })
                }
                else
                {
                    <span class="badge bg-secondary">Not Uploaded</span>
                }
            </div>

            <!-- Trust PAN -->
            <div class="col-md-6">
                <label class="form-label">Trust PAN</label>

                @if (!string.IsNullOrWhiteSpace(Model.PanfilePath))
                {
                    @await Html.PartialAsync(
                        "_DocumentViewerButton",
                        new DocumentViewerVm
                        {
                            Url = Url.Action(
                                "ViewTrustDocument",
                                "VerificationDashboard",
                                new
                                {
                                    id = Model.InstitutionId,
                                    documentType = "Panfile"
                                })!,
                            Title = "Trust PAN"
                        })
                }
                else
                {
                    <span class="badge bg-secondary">Not Uploaded</span>
                }
            </div>

            <!-- Bank Statement -->
            <div class="col-md-6">
                <label class="form-label">Bank Statement</label>

                @if (!string.IsNullOrWhiteSpace(Model.BankStatementFilePath))
                {
                    @await Html.PartialAsync(
                        "_DocumentViewerButton",
                        new DocumentViewerVm
                        {
                            Url = Url.Action(
                                "ViewTrustDocument",
                                "VerificationDashboard",
                                new
                                {
                                    id = Model.InstitutionId,
                                    documentType = "BankStatement"
                                })!,
                            Title = "Bank Statement"
                        })
                }
                else
                {
                    <span class="badge bg-secondary">Not Uploaded</span>
                }
            </div>

            <!-- Registration Certificate -->
            <div class="col-md-6">
                <label class="form-label">Registration Certificate</label>

                @if (!string.IsNullOrWhiteSpace(Model.RegistrationCertificateFilePath))
                {
                    @await Html.PartialAsync(
                        "_DocumentViewerButton",
                        new DocumentViewerVm
                        {
                            Url = Url.Action(
                                "ViewTrustDocument",
                                "VerificationDashboard",
                                new
                                {
                                    id = Model.InstitutionId,
                                    documentType = "RegistrationCertificate"
                                })!,
                            Title = "Registration Certificate"
                        })
                }
                else
                {
                    <span class="badge bg-secondary">Not Uploaded</span>
                }
            </div>

            <!-- Audit Statement -->
            <div class="col-md-6">
                <label class="form-label">Audit Statement</label>

                @if (!string.IsNullOrWhiteSpace(Model.AuditStatementFilePath))
                {
                    @await Html.PartialAsync(
                        "_DocumentViewerButton",
                        new DocumentViewerVm
                        {
                            Url = Url.Action(
                                "ViewTrustDocument",
                                "VerificationDashboard",
                                new
                                {
                                    id = Model.InstitutionId,
                                    documentType = "AuditStatement"
                                })!,
                            Title = "Audit Statement"
                        })
                }
                else
                {
                    <span class="badge bg-secondary">Not Uploaded</span>
                }
            </div>
                <div class="col-md-6">
                    <label class="form-label">Other Dental College in City</label>
                    <input type="text" class="form-control" value="@(Model.OtherDentalCollegeInCity == true ? "Yes" : Model.OtherDentalCollegeInCity == false ? "No" : "Not specified")" disabled />
                </div>
            </div>
        </div>
    </div>

    <!-- Verification Status Overview Card -->
    <div class="verification-card mb-4">
        <div class="verification-card-header">
            <h3 class="verification-card-title">
                <i class="bi bi-shield-check"></i>
                Verification Status Overview
            </h3>
        </div>
        <div class="verification-card-body">
            <div class="table-responsive">
                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Level</th>
                            <th>Status</th>
                            <th>Verified By</th>
                            <th>Verified Date</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var level in new (string Level, bool? Verified, string Name, DateTime? Date, string Remarks)[]
                        {
                            ("DEO", Model.IsDeoVerified, Model.DeoName, Model.DeoVerifiedDate, Model.DeoRemarks),
                            ("JR", Model.IsJrVerified, Model.JrName, Model.JrVerifiedDate, Model.JrRemarks),
                            ("SO", Model.IsSoVerified, Model.SoName, Model.SoVerifiedDate, Model.SoRemarks),
                            ("AR", Model.IsArVerified, Model.ArName, Model.ArVerifiedDate, Model.ArRemarks),
                            ("RG", Model.IsRgVerified, Model.RgName, Model.RgVerifiedDate, Model.RgRemarks),
                            ("RE", Model.IsReVerified, Model.ReName, Model.ReVerifiedDate, Model.ReRemarks),
                            ("DR", Model.IsDrVerified, Model.DrName, Model.DrVerifiedDate, Model.DrRemarks),
                            ("VC", Model.IsVcVerified, Model.VcName, Model.VcVerifiedDate, Model.VcRemarks)
                        })
                        {
                            <tr>
                                <td><strong>@level.Level</strong></td>
                                <td>
                                    @if (level.Verified == true)
                                    {
                                        <span class="badge bg-success">Verified</span>
                                    }
                                    else if (level.Verified == false)
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </td>
                                <td>@(level.Name ?? "-")</td>
                                <td>@(level.Date?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td>@(level.Remarks ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-3">
                <strong>Current Verification Level:</strong> @(Model.CurrentVerificationLevel ?? "Not Started")<br />
                <strong>Overall Status:</strong> @(Model.OverallStatus ?? "Pending")<br />
                <strong>Last Updated:</strong> @(Model.LastUpdatedDate?.ToString("dd MMM yyyy HH:mm") ?? "Never")
            </div>
        </div>
    </div>
@model VerificationPortal.Models.TrustDetailsVerificationVm

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    var pageContext = Model.PageContext;
    var institution = Model.Institution;
    var documentMappings = Model.Documents;

    ViewData["Title"] = "Trust Details";
    ViewData["ShowFeedbackSection"] = true;

    int? GetDocumentId(string documentName)
    {
        return documentMappings.TryGetValue(
            documentName,
            out var documentId)
            ? documentId
            : null;
    }

    var trustInfoFeedback = Model.SectionFeedback.FirstOrDefault(x => x.SectionName == "Trust Information");
}

@section Styles {
}

@{
    ViewBag.ActiveTab = "TrustDetails";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <h1 class="page-title">
        <i class="bi bi-building"></i>
        Trust Details
    </h1>
    <p class="text-muted mb-0">Review and verify trust information for this institution</p>
</div>

<!-- Note Box -->
<div class="note-box mb-4">
    <i class="bi bi-info-circle"></i>
    <div class="note-box-content">
        <h6>Verification Instructions</h6>
        <p>Review the trust details below. Provide your remarks in the remarks field below, and select the verification status (Accept/Reject). Once completed, you can proceed to the next tab: <strong>Trust Member Details</strong>.</p>
    </div>
</div>


<!-- Trust Information Card -->
<div class="verification-card mb-4">
    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-building"></i>
            Trust Information
        </h3>
    </div>
    <div class="verification-card-body">
        <div class="row g-3">
            <!-- Institution Basic Details -->
                
            <!-- Trust Details -->
            <div class="col-md-6">
                <label class="form-label">Trust Name</label>
                <input type="text" class="form-control" value="@institution.TrustName" disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">PAN Number</label>
                <input type="text" class="form-control" value="@institution.Pannumber" disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">Registration Number</label>
                <input type="text" class="form-control" value="@institution.RegistrationNumber" disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">Registration Date</label>
                <input type="text" class="form-control" value="@(institution.RegistrationDate?.ToString("dd MMM yyyy") ?? "Not provided")" disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">President Name</label>
                <input type="text" class="form-control" value="@institution.PresidentName" disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">Category of Organisation</label>
                <input type="text" class="form-control" value="@institution.CategoryOfOrganisation" disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">GOK Obtained Trust Name</label>
                <input type="text" class="form-control" value="@institution.GokobtainedTrustName" disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">Amendments</label>
                <input type="text" class="form-control" value="@(institution.Amendments == true ? "Yes" : institution.Amendments == false ? "No" : "Not specified")" disabled />
            </div>
            @* <div class="col-md-6">
                <label class="form-label">Aadhaar Number</label>
                <input type="text" class="form-control" value="@Model.AadhaarNumber" disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">Existing Trust Name</label>
                <input type="text" class="form-control" value="@Model.ExistingTrustName" disabled />
            </div> *@
            @* <div class="col-md-6">
                <label class="form-label">Changes in Trust Name</label>
                <input type="text" class="form-control" value="@(Model.ChangesInTrustName == true ? "Yes" : Model.ChangesInTrustName == false ? "No" : "Not specified")" disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">Other Nursing College in City</label>
                <input type="text" class="form-control" value="@(Model.OtherNursingCollegeInCity == true ? "Yes" : Model.OtherNursingCollegeInCity == false ? "No" : "Not specified")" disabled />
            </div> *@

            <!-- Contact Person Details -->
            <div class="col-md-4">
                <label class="form-label">Contact Person Name</label>
                <input type="text" class="form-control" value="@institution.ContactPersonName" disabled />
            </div>
            <div class="col-md-4">
                <label class="form-label">Contact Person Designation</label>
                <input type="text" class="form-control" value="@institution.ContactPersonRelation" disabled />
            </div>
            <div class="col-md-4">
                <label class="form-label">Contact Person Mobile</label>
                <input type="text" class="form-control" value="@institution.ContactPersonMobile" disabled />
            </div>
            <div class="col-md-4">
                <label class="form-label">Address</label>
                <input type="text" class="form-control" value="@institution.AddressOfInstitution" disabled />
            </div>
            <div class="col-md-4">
                <label class="form-label">Pincode</label>
                <input type="text" class="form-control" value="@institution.PinCode" disabled />
            </div>
            <div class="col-md-4">
                <label class="form-label">Mobile Number</label>
                <input type="text" class="form-control" value="@institution.MobileNumber" disabled />
            </div>
            <div class="col-md-4">
                <label class="form-label">STD code</label>
                <input type="text" class="form-control" value="@institution.StdCode" disabled />
            </div>
            <div class="col-md-4">
                <label class="form-label">Fax</label>
                <input type="text" class="form-control" value="@institution.Fax" disabled />
            </div>
            <div class="col-md-4">
                <label class="form-label">Alternate Mobile/Landline Number</label>
                <input type="text" class="form-control" value="@institution.AltLandlineOrMobile" disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">Email Id</label>
                <input type="text" class="form-control" value="@institution.EmailId" disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">Alternate Email Id</label>
                <input type="text" class="form-control" value="@institution.AltEmailId" disabled />
            </div>
                
            <div class="col-md-6">
                <label class="form-label">Created On</label>
                <input type="text" class="form-control" value="@institution.CreatedOn.ToString("dd MMM yyyy HH:mm")" disabled />
            </div>

            <!-- Required Documents -->
            <div class="col-12">
                <h5 class="border-bottom pb-2 mb-3">Required Documents</h5>
            </div>

            <!-- Amended Document -->
            <div class="col-md-6">
                <label class="form-label">GOK Order Document</label>

                @if (!string.IsNullOrWhiteSpace(institution.GokOrderExistingCoursesFilePath))
                {
                    @await Html.PartialAsync(
                        "_DocumentViewerButton",
                        new DocumentViewerVm
                        {
                            Url = Url.Action(
                                "ViewGOKorderDocument",
                                "VerificationDashboard",
                                new
                                {
                                    id = institution.InstitutionId,
                                    documentType = "AmendedDoc"
                                })!,
                            Title = "Amended Document",

                            DocumentId = GetDocumentId("GOK Order Document"),

                            FacultyId = Convert.ToInt32(institution.FacultyCode),

                            CollegeCode = institution.CollegeCode
                        })
                }
                else
                {
                    <span class="badge bg-secondary">Not Uploaded</span>
                }
            </div>

            <!-- Trust PAN -->
            <div class="col-md-6">
                <label class="form-label">Trust PAN</label>

                @if (!string.IsNullOrWhiteSpace(institution.PanfilePath))
                {
                    @await Html.PartialAsync(
                        "_DocumentViewerButton",
                        new DocumentViewerVm
                        {
                            Url = Url.Action(
                                "ViewTrustDetailsPageDocument",
                                "VerificationDashboard",
                                new
                                {
                                    id = institution.InstitutionId,
                                    documentType = "Panfile"
                                })!,
                            Title = "Trust PAN",
                            DocumentId = GetDocumentId("Trust PAN"),

                            FacultyId = Convert.ToInt32(institution.FacultyCode),

                            CollegeCode = institution.CollegeCode
                        })
                }
                else
                {
                    <span class="badge bg-secondary">Not Uploaded</span>
                }
            </div>

            <!-- Bank Statement -->
            <div class="col-md-6">
                <label class="form-label">Bank Statement</label>

                @if (!string.IsNullOrWhiteSpace(institution.BankStatementFilePath))
                {
                    @await Html.PartialAsync(
                        "_DocumentViewerButton",
                        new DocumentViewerVm
                        {
                            Url = Url.Action(
                                "ViewTrustDetailsPageDocument",
                                "VerificationDashboard",
                                new
                                {
                                    id = institution.InstitutionId,
                                    documentType = "BankStatement"
                                })!,
                            Title = "Bank Statement",
                            DocumentId = GetDocumentId("Bank Statement"),

                            FacultyId = Convert.ToInt32(institution.FacultyCode),

                            CollegeCode = institution.CollegeCode
                        })
                }
                else
                {
                    <span class="badge bg-secondary">Not Uploaded</span>
                }
            </div>

            <!-- Registration Certificate -->
            <div class="col-md-6">
                <label class="form-label">Registration Certificate</label>

                @if (!string.IsNullOrWhiteSpace(institution.RegistrationCertificateFilePath))
                {
                    @await Html.PartialAsync(
                        "_DocumentViewerButton",
                        new DocumentViewerVm
                        {
                            Url = Url.Action(
                                "ViewTrustDetailsPageDocument",
                                "VerificationDashboard",
                                new
                                {
                                    id = institution.InstitutionId,
                                    documentType = "RegistrationCertificate"
                                })!,
                            Title = "Registration Certificate",

                            DocumentId = GetDocumentId("Registration Certificate"),

                            FacultyId = Convert.ToInt32(institution.FacultyCode),

                            CollegeCode = institution.CollegeCode
                        })
                }
                else
                {
                    <span class="badge bg-secondary">Not Uploaded</span>
                }
            </div>

            <!-- Audit Statement -->
            <div class="col-md-6">
                <label class="form-label">Audit Statement</label>

                @if (!string.IsNullOrWhiteSpace(institution.AuditStatementFilePath))
                {
                    @await Html.PartialAsync(
                        "_DocumentViewerButton",
                        new DocumentViewerVm
                        {
                            Url = Url.Action(
                                "ViewAuditStatementDocument",
                                "VerificationDashboard",
                                new
                                {
                                    id = institution.InstitutionId,
                                    documentType = "AuditStatement"
                                })!,

                            Title = "Audit Statement",

                            DocumentId = GetDocumentId("Audit Statement"),

                            FacultyId = Convert.ToInt32(institution.FacultyCode),

                            CollegeCode = institution.CollegeCode
                        })
                }
                else
                {
                    <span class="badge bg-secondary">Not Uploaded</span>
                }
            </div>

            <div class="col-md-6">
                <label class="form-label">Other Dental College in City</label>
                <input type="text" class="form-control" value="@(institution.OtherDentalCollegeInCity == true ? "Yes" : institution.OtherDentalCollegeInCity == false ? "No" : "Not specified")" disabled />
            </div>
        </div>

        
        @if (trustInfoFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", trustInfoFeedback)
        }
    </div>
</div>



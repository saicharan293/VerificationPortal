@model VerificationPortal.Models.CA_VehicleDetailsViewModel

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Vehicle Details";
    ViewData["ActiveTab"] = "CA_VehicleDetails";

    ViewData["CollegeCode"] = Model.CollegeCode ?? "";
    ViewData["FacultyCode"] = Model.FacultyCode ?? "";
    ViewData["RegistrationNo"] = Model.RegistrationNo ?? "";

    ViewData["ShowFeedbackSection"] = true;

    ViewData["CurrentVerifier"] =
        User.Identity?.Name + " - " + ViewBag.UserDesignation;

    ViewData["PrevTabAction"] = Url.Action(
        "TeachingStaffDepartmentWise",
        "VerificationDashboard",
        new { collegeCode = Model.CollegeCode });

    ViewData["PrevTabLabel"] = "Previous : Teaching Staff";

    ViewData["NextTabAction"] = Url.Action(
        "NextActionName",
        "VerificationDashboard",
        new { collegeCode = Model.CollegeCode });

    ViewData["NextTabLabel"] = "Next";
}

<style>
    .vehicle-table-wrapper {
        width: 100%;
        max-height: 500px;
        overflow-x: auto;
        overflow-y: auto;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        -webkit-overflow-scrolling: touch;
    }

    .vehicle-table-wrapper table {
        min-width: 950px;
        margin-bottom: 0;
    }

    .vehicle-table-wrapper thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: #f8f9fa;
        white-space: nowrap;
        vertical-align: middle;
    }

    .vehicle-table-wrapper tbody td {
        vertical-align: middle;
        white-space: nowrap;
    }

    .vehicle-table-wrapper tbody tr:last-child td {
        border-bottom: 0;
    }

    @@media (max-width: 768px) {
        .vehicle-table-wrapper {
            max-height: 450px;
        }

        .vehicle-table-wrapper table {
            min-width: 850px;
        }
    }

    @@media (max-width: 576px) {
        .vehicle-table-wrapper {
            max-height: 400px;
        }

        .vehicle-table-wrapper table {
            min-width: 800px;
        }
    }
</style>

<div class="page-header mb-4">
    <h1 class="page-title">
        <i class="bi bi-car-front"></i>
        Vehicle Details
    </h1>

    <p class="text-muted mb-0">
        Review and verify the vehicles available for the institution.
    </p>
</div>

<div class="note-box mb-4">
    <i class="bi bi-info-circle"></i>

    <div class="note-box-content">
        <h6>Verification Instructions</h6>

        <p class="mb-0">
            Verify the vehicle registration details, seating capacity,
            fitness certificate validity and supporting document statuses
            before approving this section.
        </p>
    </div>
</div>

<div class="verification-card">

    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-car-front"></i>
            Vehicle Information
        </h3>
    </div>

    <div class="verification-card-body">

        @if (Model.ExistingList != null && Model.ExistingList.Any())
        {
            <div class="table-responsive vehicle-table-wrapper">

                <table class="table table-bordered table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Vehicle Registration No.</th>
                            <th>Vehicle For</th>
                            <th>Seating Capacity</th>
                            <th>FC Validity</th>
                            <th>RC Book</th>
                            <th>Insurance</th>
                            <th>Driving Licence</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            var index = 1;
                        }

                        @foreach (var vehicle in Model.ExistingList)
                        {
                            <tr>
                                <td>@index</td>

                                <td class="fw-semibold">
                                    @vehicle.VehicleRegNo
                                </td>

                                <td>
                                    @vehicle.VehicleForCode
                                </td>

                                <td>
                                    @vehicle.SeatingCapacity
                                </td>

                                <td>
                                    @(vehicle.ValidityDate.HasValue
                                        ? vehicle.ValidityDate.Value.ToString("dd-MM-yyyy")
                                        : "-")
                                </td>

                                <td>
                                    @if (vehicle.RcBookStatus == "A")
                                    {
                                        <span class="badge bg-success">
                                            Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Not Available
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (vehicle.InsuranceStatus == "A")
                                    {
                                        <span class="badge bg-success">
                                            Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Not Available
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (vehicle.DrivingLicenseStatus == "A")
                                    {
                                        <span class="badge bg-success">
                                            Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Not Available
                                        </span>
                                    }
                                </td>
                            </tr>

                            index++;
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="alert alert-warning mb-0">
                <i class="bi bi-exclamation-triangle me-2"></i>
                No vehicle details have been submitted by the institution.
            </div>
        }

    </div>

</div>
@model VerificationPortal.Models.InstitutionDetailsVerificationVm

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";

    ViewData["Title"] = "Institution Details";
    ViewData["ActiveTab"] = ViewBag.ActiveTab;

    ViewData["InstitutionName"] =
        ViewBag.InstitutionName ?? "Unknown Institution";

    ViewData["CollegeCode"] =
        ViewBag.CollegeCode ?? Model?.Institution?.CollegeCode ?? "";

    ViewData["FacultyCode"] =
        ViewBag.FacultyCode ?? Model?.Institution?.FacultyCode ?? "";

    ViewData["ShowFeedbackSection"] = true;

    // DON'T set ShowFeedbackForm here.
    // SetVerificationViewData<AffInstitutionsDetail>()
    // should populate it.

    ViewData["CurrentVerifier"] =
        User.Identity?.Name + " - " + ViewBag.UserDesignation;

    ViewData["PrevTabAction"] =
        Url.Action(
            "TrustDetails",
            "VerificationDashboard",
            new { collegeCode = ViewBag.CollegeCode });

    ViewData["PrevTabLabel"] =
        "Previous : Trust Details";

    ViewData["NextTabAction"] =
        Url.Action(
            "TrustDetails",
            "VerificationDashboard",
            new { collegeCode = ViewBag.CollegeCode });

    ViewData["NextTabLabel"] =
        "Next : Trust Details";
}

@{

    //----------------------------------------------
    // SECTION FEEDBACK
    //----------------------------------------------

    var sectionFeedback = ViewBag.SectionFeedback
                as List<VerificationPortal.Models.SectionFeedbackViewModel>
                ?? new List<VerificationPortal.Models.SectionFeedbackViewModel>();

    var basicFeedback = sectionFeedback.FirstOrDefault(x => x.SectionId == 1);

    var addressFeedback = sectionFeedback.FirstOrDefault(x => x.SectionId == 2);

    var contactFeedback = sectionFeedback.FirstOrDefault(x => x.SectionId == 3);

    var institutionFeedback = sectionFeedback.FirstOrDefault(x => x.SectionId == 4);

    var headFeedback = sectionFeedback.FirstOrDefault( x => x.SectionId == 5);

    var nodalFeedback = sectionFeedback.FirstOrDefault( x => x.SectionId == 6);

    var principalFeedback = sectionFeedback.FirstOrDefault( x => x.SectionId == 7);

    var deanFeedback = sectionFeedback.FirstOrDefault( x => x.SectionId == 8);

    var trustFeedback = sectionFeedback.FirstOrDefault( x => x.SectionId == 9);

    var administrativeFeedback = sectionFeedback.FirstOrDefault( x => x.SectionId == 63);

    var otherHealthScienceFeedback = sectionFeedback.FirstOrDefault( x => x.SectionId == 64);

}

@section Scripts {
    <script src="~/js/verification-dashboard.js" asp-append-version="true"></script>
}

<!-- Note Box -->
<div class="note-box">
    <i class="bi bi-info-circle"></i>
    <div class="note-box-content">
        <h6>Verification Instructions</h6>
        <p>Please start verification from this <strong>Institution Details</strong> tab. Review all fields carefully, provide your remarks in the remarks field below, and select the verification status (Accept/Reject). Once completed, you can proceed to the next tab: <strong>Courses & Intake</strong>.</p>
    </div>
</div>

<!-- Institution Basic Information -->
<div class="verification-card">

    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-info-circle"></i>
            Basic Information
        </h3>
    </div>

    <div class="verification-card-body">

        <div class="row g-3">

            @* Name of Institution *@
            <div class="col-md-8">
                <label class="form-label">
                    Name of Institution
                </label>

                <input type="text" class="form-control" value="@Model.Institution.NameOfInstitution" disabled />
            </div>


            @* Type of Institution *@
            <div class="col-md-4">
                <label class="form-label">
                    Type of Institution
                </label>

                <input type="text" class="form-control" value="@Model.TypeOfInstitutionText" disabled />
            </div>


            @* Year of Establishment *@
            <div class="col-md-6">
                <label class="form-label">
                    Year of Establishment
                </label>

                <input type="text" class="form-control" value="@Model.Institution.YearOfEstablishment" disabled />
            </div>


            @* Status of College *@
            <div class="col-md-6">
                <label class="form-label">
                    Status of College
                </label>

                <input type="text" class="form-control" value="@Model.StatusOfCollegeText" disabled />
            </div>


            @* Financing Authority *@
            <div class="col-md-6">
                <label class="form-label">
                    Financing Authority
                </label>

                <input type="text" class="form-control" value="@Model.Institution.FinancingAuthority" disabled />
            </div>


            @* Minority Institute *@
            <div class="col-md-3">
                <label class="form-label">
                    Minority Institute
                </label>

                <input type="text" class="form-control" value="@(Model.Institution.MinorityInstitute ? "Yes" : "No")" disabled />
            </div>


            @* Minority Category *@
            <div class="col-md-3">
                <label class="form-label">
                    Minority Category
                </label>

                <input type="text"
                       class="form-control"
                       value="@(string.IsNullOrWhiteSpace(Model.Institution.MinorityCategory)
                                           ? "-"
                                           : Model.Institution.MinorityCategory)"
                       disabled />
            </div>


            @* Attached to Medical College *@
            <div class="col-md-6">
                <label class="form-label">
                    Attached to Medical College
                </label>

                <input type="text"  class="form-control" value="@(Model.Institution.AttachedToMedicalClg ? "Yes" : "No")" disabled />
            </div>


            @* Rural Institute *@
            <div class="col-md-6">
                <label class="form-label">
                    Rural Institute
                </label>

                <input type="text" class="form-control" value="@(Model.Institution.RuralInstitute ? "Yes" : "No")" disabled />
            </div>

            @* =====================================================
               GOVERNMENT AUTONOMOUS CERTIFICATE
               ===================================================== *@
            @if(Model.TypeOfInstitutionText == "Government/Autonomous")
            {
                
                <div class="col-md-6">

                    <label class="form-label">
                        Government Autonomous Certificate Number
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@(string.IsNullOrWhiteSpace(Model.Institution.GovAutonomousCertNumber)
                               ? "-"
                               : Model.Institution.GovAutonomousCertNumber)"
                           disabled />

                </div>


                <div class="col-md-6">

                    <label class="form-label">
                        Government Autonomous Certificate
                    </label>

                    @if (!string.IsNullOrWhiteSpace(
                        Model.Institution.GovAutonomousCertPath))
                    {
                        @await Html.PartialAsync(
                            "_DocumentViewerButton",
                            new DocumentViewerVm
                            {
                                Url = Url.Action(
                                    "ViewGovAutonomousCertificate",
                                    "VerificationDashboard",
                                    new
                                    {
                                        id = Model.Institution.InstitutionId
                                    })!,

                                Title = "Government Autonomous Certificate",

                                DocumentId = Model.GovAutonomousDocumentId,

                                FacultyId = Convert.ToInt32( Model.Institution.FacultyCode),

                                CollegeCode = Model.Institution.CollegeCode
                            })
                    }
                    else
                    {
                        <input type="text"
                               class="form-control"
                               value="-"
                               disabled />
                    }

                </div>
            }

        </div>


        @if (basicFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", basicFeedback)
        }
    </div>
</div>


<!-- Address Details -->
<div class="verification-card">
    <div class="verification-card-header">
        <h3 class="verification-card-title">
            <i class="bi bi-geo-alt"></i>

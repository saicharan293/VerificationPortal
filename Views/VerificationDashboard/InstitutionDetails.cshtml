@model VerificationPortal.Models.InstitutionDetailsVerificationVm

@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";
    var pageContext = Model.PageContext;
    var verification = Model.TabwiseVerification; 
    ViewData["Title"] = "Institution Details";
    ViewData["ActiveTab"] = pageContext.ActiveTab;
    ViewData["InstitutionName"] = pageContext.InstitutionName ?? "Unknown Institution";
    ViewData["CollegeCode"] = pageContext.CollegeCode ?? Model?.Institution?.CollegeCode ?? "";
    ViewData["FacultyCode"] = pageContext.FacultyId.ToString() ?? Model?.Institution?.FacultyCode ?? "";
    ViewData["ShowFeedbackSection"] = true;
    ViewData["CurrentVerifier"] = $"{pageContext.CurrentVerifier} - {pageContext.UserDesignation}";
    ViewData["PrevTabAction"] =
        string.IsNullOrWhiteSpace(pageContext.PrevTabAction)
            ? null
            : Url.Action(
                pageContext.PrevTabAction,
                "VerificationDashboard",
                new { collegeCode = pageContext.CollegeCode });
    ViewData["PrevTabLabel"] = pageContext.PrevTabLabel ?? "Previous : Trust Details";
    ViewData["NextTabAction"] =
        string.IsNullOrWhiteSpace(pageContext.NextTabAction)
            ? null
            : Url.Action(
                pageContext.NextTabAction,
                "VerificationDashboard",
                new { collegeCode = pageContext.CollegeCode });
    ViewData["NextTabLabel"] = pageContext.NextTabLabel ?? "Next : Trust Details";

     // ---------------------------------------------------------
    // TAB-WISE VERIFICATION
    // ---------------------------------------------------------

    ViewData["IsAdmin"] = verification.IsAdmin;
    ViewData["ExistingRemarks"] = verification.ExistingRemarks;
    ViewData["ExistingStatus"] = verification.ExistingStatus;
    ViewData["ExistingStatusClass"] = verification.ExistingStatusClass;
    ViewData["VerifiedBy"] = verification.VerifiedBy;
    ViewData["VerifiedDate"] = verification.VerifiedDate;
    ViewData["ShowFeedbackForm"] = verification.ShowFeedbackForm;
    ViewData["TabId"] = verification.TabId;
    ViewData["TabName"] = verification.TabName;
    ViewData["VerificationHistory"] = verification.VerificationHistory;
}


@section Scripts {
    <script src="~/js/verification-dashboard.js" asp-append-version="true"></script>
}

<!-- Note Box -->
<div class="note-box">
    <i class="bi bi-info-circle"></i>
    <div class="note-box-content">
        <h6>Verification Instructions</h6>
        <p>Please start verification from this <strong>Institution Details</strong> tab. Review all fields carefully, provide your remarks in the remarks field below, and select the verification status (Accept/Reject). Once completed, you can proceed to the next tab: <strong>Courses and Intake</strong>.</p>
    </div>
</div>

<!-- Institution Basic Information -->
@await Html.PartialAsync("~/Views/VerificationDashboard/Partials/InstitutionDetails/_BasicInformation.cshtml", Model)

<!-- Address Details -->
@await Html.PartialAsync("~/Views/VerificationDashboard/Partials/InstitutionDetails/_AddressDetails.cshtml", Model)


<!-- Contact Information -->
@await Html.PartialAsync("~/Views/VerificationDashboard/Partials/InstitutionDetails/_ContactInformation.cshtml", Model)


<!-- Institutional Details -->
@await Html.PartialAsync("~/Views/VerificationDashboard/Partials/InstitutionDetails/_InstitutionDetails.cshtml", Model)


<!-- Head of Institution -->
@await Html.PartialAsync("~/Views/VerificationDashboard/Partials/InstitutionDetails/_HeadOfInstitution.cshtml", Model)


<!-- Nodal Officer -->
@await Html.PartialAsync("~/Views/VerificationDashboard/Partials/InstitutionDetails/_NodalOfficer.cshtml", Model)


@* Principal Details (Preview) *@
@await Html.PartialAsync("~/Views/VerificationDashboard/Partials/InstitutionDetails/_PrincipalDetails.cshtml", Model)



@* Dean/Director Details (Preview) *@
@await Html.PartialAsync("~/Views/VerificationDashboard/Partials/InstitutionDetails/_DeanDirectorDetails.cshtml", Model)


@if (Model?.HasTrustDetails==true)
{    
    @* Trust Details (Preview) *@
    @await Html.PartialAsync("~/Views/VerificationDashboard/Partials/InstitutionDetails/_TrustDetails.cshtml", Model)

}

@if(Model?.Institution.FacultyCode == "2" && Model.HasAdministrativeAuthority == true)
{
    @* Administrative Details *@
    @await Html.PartialAsync("~/Views/VerificationDashboard/Partials/InstitutionDetails/_AdministrativeDetails.cshtml", Model)
    

}

@if(Model?.Institution?.FacultyCode == "2")
{
    @* Managing Other Health Science Colleges *@
    @await Html.PartialAsync("~/Views/VerificationDashboard/Partials/InstitutionDetails/_OtherHealthScienceColleges.cshtml", Model)
}

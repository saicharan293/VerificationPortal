@model VerificationPortal.Models.HospitalTieUpVm

@{
    var sectionFeedback = Model.SectionFeedback?.FirstOrDefault(x => x.SectionId == 79);
}

<div class="verification-card mt-4">
    

    <div class="verification-card-header">
        <div class="verification-card-title">
            <i class="bi bi-hospital me-2"></i>
            Hospital Tie-Up Details
        </div>
    </div>

    <div class="verification-card-body">

        @* Hospital Tie Up Status  *@
        <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0">
                <tbody>
                    <tr>
                        <th style="width: 35%">
                            Hospital Tie-up Available
                        </th>
                        <td>
                            @if(Model.HasHospitalTieUp == true)
                            {
                                <span class="badge bg-success">
                                    Yes
                                </span>
                            }
                            else if(Model.HasHospitalTieUp == false)
                            {
                                <span class="badge bg-danger">
                                    No
                                </span>
                            }
                            else
                            {
                                <span>
                                    Not Available
                                </span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>


        @* Hospital Tie Up details  *@

        @if(Model.HospitalTieUps != null && Model.HospitalTieUps.Any())
        {
            <div class="mt-4">
                <h6 class="fw-bold mb-3">
                    <i class="bi bi-list-ul me-2"></i>
                    Hospital Tie-Up Details
                </h6>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Tie-Up Type</th>
                                <th>Hospital Name</th>
                                <th>Hospital Address</th>
                                <th>Tie-Up Details</th>
                                <th>Supporting Document</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach(var tieUp in Model.HospitalTieUps)
                            {
                                <tr>
                                    <td>
                                        @(Model.HospitalTieUps.IndexOf(tieUp) + 1)
                                    </td>
                                    <td>
                                        @(!string.IsNullOrWhiteSpace(tieUp.TieUpType) ? tieUp.TieUpType : "-")
                                    </td>

                                    <td>
                                        @(!string.IsNullOrWhiteSpace(tieUp.HospitalName) ? tieUp.HospitalName : "-")
                                    </td>

                                    <td>
                                        @(!string.IsNullOrWhiteSpace(tieUp.HospitalAddress) ? tieUp.HospitalAddress : "-")
                                    </td>
                                    <td>
                                        @(!string.IsNullOrWhiteSpace(tieUp.TieUpDetails) ? tieUp.TieUpDetails : "-")
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(tieUp.SupportingDocumentPath))
                                        {
                                            @await Html.PartialAsync("_DocumentViewerButton", new DocumentViewerVm
                                            {
                                                Url = Url.Action("ViewAllDocs","VerificationDashboard", new
                                                {
                                                    collegeCode = Model.PageContext.CollegeCode,
                                                    docType = "tieup"
                                                })!,

                                                Title = "Hospital Tie up Document",
                                                FacultyId = Model.PageContext.FacultyCodeInt,
                                                CollegeCode = Model.PageContext.CollegeCode,
                                                DocumentId = tieUp.SupportingDocumentFileId,
                                                CanVerify = true
                                            })
                                        } else
                                        {
                                            <span>Not Available</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        } 
        else
        {
            <div class="alert alert-light border mt-4 mb-0">
                <i class="bi bi-info-circle me-2"></i>
                No Hospital Tie-Up Details Available
            </div>   
        }

        @if(sectionFeedback != null)
        {
            <div class="mt-4 pt-3 border-top">
                <h6 class="fw-bold mb-1">
                    <i class="bt bi-chat-left-text me-2"></i>
                    Section Feedback
                </h6>

                <small class="form-lbael d-block mb-3">
                    Verificaiton Feedback for the Hospital Tie-Up Details
                </small>
                @await Html.PartialAsync( "_SectionFeedback", sectionFeedback)
            </div>
        }
    </div>
</div>
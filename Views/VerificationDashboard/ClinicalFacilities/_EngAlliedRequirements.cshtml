@model VerificationPortal.Models.EngAlliedRequirementsPostVM

<div class="verification-card mt-4">
    @{
        var engAlliedFeedback = (ViewBag.SectionFeedback as List<VerificationPortal.Models.SectionFeedbackViewModel>)
                                    ?.FirstOrDefault(x => x.SectionId == 61);
    }

    <div class="verification-card-header">

        <h3 class="verification-card-title">
            <i class="bi bi-gear-wide-connected me-2"></i>
            Engineering & Allied Services
        </h3>

        <span class="badge bg-primary">
            @(Model?.Requirements?.Count ?? 0) Requirements
        </span>

    </div>

    <div class="verification-card-body">

        @if (Model == null ||
             Model.Requirements == null ||
             !Model.Requirements.Any())
        {
            <div class="alert alert-info mb-0">
                No Engineering & Allied Services requirements found.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>
                                #
                            </th>

                            <th>
                                Requirement
                            </th>

                            @* <th>
                                Section
                            </th> *@

                            <th>
                                Availability
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            var serialNo = 1;
                        }

                        @foreach (var requirement in Model.Requirements)
                        {
                            <tr>

                                <td>
                                    @serialNo
                                </td>

                                <td class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(
                                        requirement.RequirementName)
                                        ? "-"
                                        : requirement.RequirementName)
                                </td>

                                @* <td>
                                    @requirement.SectionCode
                                </td> *@

                                <td>

                                    @if (requirement.IsAvailable == true)
                                    {
                                        <span class="badge bg-success">
                                            Available
                                        </span>
                                    }
                                    else if (requirement.IsAvailable == false)
                                    {
                                        <span class="badge bg-danger">
                                            Not Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Not Provided
                                        </span>
                                    }

                                </td>

                            </tr>

                            serialNo++;
                        }

                    </tbody>

                </table>

            </div>
        }


        @if (engAlliedFeedback != null)
        {
            @await Html.PartialAsync("_SectionFeedback", engAlliedFeedback)
        }
    </div>

</div>
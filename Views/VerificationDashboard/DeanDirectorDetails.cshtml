@model VerificationPortal.Models.AffInstitutionsDetail
@{
    Layout = "~/Views/Shared/_VerificationDashboardLayout.cshtml";
    ViewData["Title"] = "Dean / Director Details - Verification Dashboard";
    ViewData["ActiveTab"] = "DeanDirectorDetails";
    ViewData["InstitutionName"] = Model?.NameOfInstitution ?? "Unknown Institution";
    ViewData["CollegeCode"] = Model?.CollegeCode ?? "";
    ViewData["FacultyName"] = Model?.FacultyCode ?? "";
    ViewData["VerificationStatus"] = Model?.IsDeoVerified == true ? "Verified" : Model?.IsDeoVerified == false ? "Rejected" : "Pending";
    ViewData["StatusBadgeClass"] = Model?.IsDeoVerified == true ? "verified" : Model?.IsDeoVerified == false ? "rejected" : "pending";
    ViewData["ShowFeedbackSection"] = true;
    ViewData["ShowFeedbackForm"] = true;
    ViewData["CurrentVerifier"] = User.Identity?.Name + " - " + ViewBag.UserDesignation;
    ViewData["NextTabAction"] = Url.Action("PrincipalDetails", "VerificationDashboard", new { collegeCode = Model.CollegeCode });
    ViewData["NextTabLabel"] = "Next: Principal Details";
    ViewData["PrevTabAction"] = Url.Action("TrustMemberDetails", "VerificationDashboard", new { collegeCode = Model.CollegeCode });
    ViewData["PrevTabLabel"] = "Previous: Trust Member Details";
}

@section Styles {
    <link rel="stylesheet" href="~/css/verification-dashboard.css" asp-append-version="true" />
}

@{
    ViewBag.ActiveTab = "DeanDirectorDetails";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <h1 class="page-title">
        <i class="bi bi-person-badge"></i>
        Dean / Director Details
    </h1>
    <p class="text-muted mb-0">Review and verify Dean/Director information for this institution</p>
</div>

<!-- Note Box -->
<div class="note-box mb-4">
    <i class="bi bi-info-circle"></i>
    <div class="note-box-content">
        <h6>Verification Instructions</h6>
        <p>Review the Dean/Director details below. Provide your remarks in the remarks field below, and select the verification status (Accept/Reject). Once completed, proceed to the next tab: <strong>Principal Details</strong>.</p>
    </div>
</div>

    <div class="verification-card mb-4">
        <div class="verification-card-header">
            <h3 class="verification-card-title">
                <i class="bi bi-person-badge"></i>
                Dean / Director Information
            </h3>
        </div>
        <div class="verification-card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Dean Name</label>
                    <input type="text" class="form-control" value="@Model.DeanName" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Dean Mobile Number</label>
                    <input type="text" class="form-control" value="@Model.DeanMobileNumber" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Dean Email ID</label>
                    <input type="email" class="form-control" value="@Model.DeanEmailId" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Director Name</label>
                    <input type="text" class="form-control" value="@Model.DeanName" disabled />
                    <div class="form-text">Same as Dean in this model</div>
                </div>
            </div>

            <div class="form-section mt-4">
                <h5 class="form-section-title"><i class="bi bi-person-lines-fill me-2"></i>Head of Institution Details</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Head of Institution Name</label>
                        <input type="text" class="form-control" value="@Model.HeadOfInstitution" disabled />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Head Mobile Number</label>
                        <input type="text" class="form-control" value="@Model.HeadOfInstitutionMobNo" disabled />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Head Email</label>
                        <input type="email" class="form-control" value="@Model.HeadOfInstitutionEmail" disabled />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Head Address</label>
                        <input type="text" class="form-control" value="@Model.HeadAddress" disabled />
                    </div>
                </div>
            </div>
        </div>
    </div>

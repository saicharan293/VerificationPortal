@model VerificationPortal.Models.TblCollegeMapping
@{
    ViewData["Title"] = "Edit College Mapping";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<section class="admin-page-header">
    <div class="container">
        <h1><i class="bi bi-pencil-square"></i> Edit College Mapping</h1>
    </div>
</section>

<section class="container my-4">
    <div class="admin-form-card">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="UserName" />
            <input type="hidden" asp-for="CreatedDate" />
            <input type="hidden" asp-for="CreatedBy" />

            <div class="user-info-box">
                <i class="bi bi-person-circle"></i>
                <div>
                    <strong>@Model.UserName</strong>
                    <small>@ViewBag.User?.DesignationDescription</small>
                </div>
                <span class="faculty-badge">@ViewBag.Faculty?.FacultyName</span>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3 mt-3">
                <div class="col-md-6">
                    <label asp-for="FacultyCode" class="form-label">Faculty</label>
                    <select asp-for="FacultyCode" class="form-select">
                        @foreach (var fac in (IEnumerable<VerificationPortal.Models.Faculty>)ViewBag.Faculties)
                        {
                            <option value="@fac.FacultyId">@fac.FacultyName</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label asp-for="FromLetter" class="form-label">From Letter *</label>
                    <input asp-for="FromLetter"
                           class="form-control text-uppercase"
                           maxlength="1" />
                </div>

                <div class="col-md-3">
                    <label asp-for="ToLetter" class="form-label">To Letter *</label>
                    <input asp-for="ToLetter"
                           class="form-control text-uppercase"
                           maxlength="1" />
                </div>

                <div class="col-md-3">
                    <label asp-for="CollegeFrom" class="form-label">From College Code *</label>
                    <input asp-for="CollegeFrom"
                           class="form-control text-uppercase"
                           maxlength="10" />
                </div>

                <div class="col-md-3">
                    <label asp-for="CollegeTo" class="form-label">To College Code *</label>
                    <input asp-for="CollegeTo"
                           class="form-control text-uppercase"
                           maxlength="10" />
                </div>

                <div class="col-12">
                    <div class="form-check form-switch">
                        <input type="checkbox"
                               name="IsActive"
                               value="true"
                               class="form-check-input"
                        @(Model.IsActive == true ? "checked" : "") />

                        <input type="hidden" name="IsActive" value="false" />
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> Save Changes
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</section>

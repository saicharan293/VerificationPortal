@model VerificationPortal.Models.CollegeMappingCreateViewModel
@{
    ViewData["Title"] = "Assign Colleges";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        /* Validation summary - hidden by default, shown via JS if needed */
        .validation-summary-hidden {
            display: none;
        }
    </style>
}

<section class="admin-page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1><i class="bi bi-plus-circle-fill"></i> Assign Colleges to User</h1>
                <p>Select a user, faculty, filter by college name range, and assign colleges</p>
            </div>
            <a asp-action="Index" class="btn btn-light btn-sm">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>
</section>

<section class="container my-4">
    <div class="admin-form-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary-hidden" id="validationSummary"></div>

            <div class="row g-3">
                <!-- Faculty Selection -->
                <div class="col-md-6">
                    <label asp-for="SelectedFacultyId" class="form-label">Faculty *</label>
                    <select asp-for="SelectedFacultyId" class="form-select" id="facultySelect">
                        <option value="0">-- Select Faculty --</option>
                        @foreach (var fac in Model.AvailableFaculties)
                        {
                            <option value="@fac.FacultyId">@fac.FacultyName</option>
                        }
                    </select>
                </div>

                <!-- User Selection -->
                <div class="col-md-6">
                    <label asp-for="SelectedUserId" class="form-label">User *</label>
                    <select asp-for="SelectedUserId" class="form-select" id="userSelect" disabled>
                        <option value="0">-- Select Faculty First --</option>
                    </select>
                    <small class="form-text text-muted">Users are filtered by selected faculty</small>
                </div>

                <!-- College Name Range Filters -->
                <div class="col-md-3">  
                    <label for="collegeFromSelect" class="form-label">College Name From *</label>
                    <select id="collegeFromSelect" class="form-select" name="FromLetter">
                        <option value="A">A</option>
                        <option value="B">B</option>
                        <option value="C">C</option>
                        <option value="D">D</option>
                        <option value="E">E</option>
                        <option value="F">F</option>
                        <option value="G">G</option>
                        <option value="H">H</option>
                        <option value="I">I</option>
                        <option value="J">J</option>
                        <option value="K">K</option>
                        <option value="L">L</option>
                        <option value="M">M</option>
                        <option value="N">N</option>
                        <option value="O">O</option>
                        <option value="P">P</option>
                        <option value="Q">Q</option>
                        <option value="R">R</option>
                        <option value="S">S</option>
                        <option value="T">T</option>
                        <option value="U">U</option>
                        <option value="V">V</option>
                        <option value="W">W</option>
                        <option value="X">X</option>
                        <option value="Y">Y</option>
                        <option value="Z">Z</option>
                    </select>
                    <small class="form-text text-muted">Starting letter (A-Z)</small>
                </div>

                <div class="col-md-3">
                    <label for="collegeToSelect" class="form-label">College Name To *</label>
                    <select id="collegeToSelect" class="form-select" name="ToLetter">
                        <!-- Options will be populated dynamically based on College From selection -->
                    </select>
                    <small class="form-text text-muted">Ending letter (must be same or after From)</small>
                </div>

                <div class="col-md-6 d-flex align-items-end">
                    <button type="button" id="applyFilterBtn" class="btn btn-sm btn-outline-primary w-100">
                        <i class="bi bi-funnel"></i> Apply Filter
                    </button>
                    <small class="form-text text-muted ms-2">Filter colleges by first letter range (optional)</small>
                </div>

                <!-- Colleges Selection -->
                <div class="col-12">
                    <label class="form-label">Colleges * (Hold Ctrl/Cmd to select multiple)</label>
                    <select asp-for="SelectedCollegeCodes" multiple class="form-select"
                            id="collegeSelect" size="10" disabled>
                        <option value="" disabled>-- Select Faculty & User First --</option>
                    </select>
                    <div class="mt-2">
                        <button type="button" class="btn btn-sm btn-outline-primary" id="selectAllBtn" disabled>
                            <i class="bi bi-check-all"></i> Select All
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="clearAllBtn" disabled>
                            <i class="bi bi-x-lg"></i> Clear All
                        </button>
                        <span class="ms-3 small text-muted">
                            <span id="selectedCount">0</span> college(s) selected
                        </span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> Assign Colleges
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script>
        const allUsers = @Html.Raw(Json.Serialize(Model.AvailableUsers.Select(u => new
            {
                id = u.Id,
                userId = u.UserId,
                name = u.UserName,
                designation = u.DesignationDescription,
                facultyId = u.Faculty
        })));

        // Generate alphabet options A-Z
        const alphabetOptions = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').map(letter =>
            `<option value="${letter}">${letter}</option>`).join('');

        // Initialize College To dropdown with all letters
        const collegeToSelect = document.getElementById('collegeToSelect');
        collegeToSelect.innerHTML = alphabetOptions;
        collegeToSelect.value = 'Z';

        // Update College To dropdown when College From changes
        document.getElementById('collegeFromSelect').addEventListener('change', function() {
            const fromLetter = this.value;
            const fromIndex = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.indexOf(fromLetter);

            // Generate options from selected letter to Z
            const toOptions = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
                .split('')
                .filter((letter, index) => index >= fromIndex)
                .map(letter => `<option value="${letter}">${letter}</option>`)
                .join('');

            collegeToSelect.innerHTML = toOptions;
            collegeToSelect.value = 'Z'; // Default to Z
        });

        document.getElementById('facultySelect').addEventListener('change', async function() {
            const facultyId = parseInt(this.value);
            const userSelect = document.getElementById('userSelect');
            const collegeSelect = document.getElementById('collegeSelect');
            const selectAllBtn = document.getElementById('selectAllBtn');
            const clearAllBtn = document.getElementById('clearAllBtn');
            const applyFilterBtn = document.getElementById('applyFilterBtn');

            // Filter users
            userSelect.innerHTML = '<option value="0">-- Select User --</option>';
            if (facultyId > 0) {
                const users = allUsers.filter(u => u.facultyId === facultyId);
                users.forEach(u => {
                    userSelect.innerHTML += `<option value="${u.id}">${u.name} - ${u.designation || 'N/A'}</option>`;
                });
                userSelect.disabled = false;
                applyFilterBtn.disabled = false;
            } else {
                userSelect.disabled = true;
                applyFilterBtn.disabled = true;
            }

            // Reset college select
            collegeSelect.innerHTML = '<option value="" disabled>-- Select Faculty & User First --</option>';
            collegeSelect.disabled = true;
            selectAllBtn.disabled = true;
            clearAllBtn.disabled = true;
            updateCount();
        });

        async function loadColleges() {
            const facultyId = parseInt(document.getElementById('facultySelect').value);
            const fromLetter = document.getElementById('collegeFromSelect').value;
            const toLetter = document.getElementById('collegeToSelect').value;

            if (facultyId <= 0) return;

            const collegeSelect = document.getElementById('collegeSelect');
            const selectAllBtn = document.getElementById('selectAllBtn');
            const clearAllBtn = document.getElementById('clearAllBtn');

            try {
                const url = `@Url.Action("GetCollegesByFaculty", "CollegeMapping")?facultyId=${facultyId}&fromLetter=${encodeURIComponent(fromLetter)}&toLetter=${encodeURIComponent(toLetter)}`;
                const response = await fetch(url);
                const colleges = await response.json();

                collegeSelect.innerHTML = '';
                colleges.forEach(c => {
                    const option = document.createElement('option');
                    option.value = c.code;
                    option.textContent = `${c.name} (${c.town || 'N/A'})`;
                    collegeSelect.appendChild(option);
                });

                collegeSelect.disabled = false;
                selectAllBtn.disabled = false;
                clearAllBtn.disabled = false;
                updateCount();
            } catch (error) {
                console.error('Error loading colleges:', error);
            }
        }

        document.getElementById('applyFilterBtn').addEventListener('click', loadColleges);

        // Also load colleges when user is selected
        document.getElementById('userSelect').addEventListener('change', function() {
            if (this.value !== '0') {
                loadColleges();
            }
        });

        // Allow Enter key in filter inputs to apply filter
        ['collegeFromSelect', 'collegeToSelect'].forEach(id => {
            document.getElementById(id).addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    loadColleges();
                }
            });
        });

        document.getElementById('selectAllBtn').addEventListener('click', function() {
            const select = document.getElementById('collegeSelect');
            for (let i = 0; i < select.options.length; i++) {
                select.options[i].selected = true;
            }
            updateCount();
        });

        document.getElementById('clearAllBtn').addEventListener('click', function() {
            const select = document.getElementById('collegeSelect');
            for (let i = 0; i < select.options.length; i++) {
                select.options[i].selected = false;
            }
            updateCount();
        });

        document.getElementById('collegeSelect').addEventListener('change', updateCount);

        function updateCount() {
            const select = document.getElementById('collegeSelect');
            const count = Array.from(select.selectedOptions).length;
            document.getElementById('selectedCount').textContent = count;
        }
    </script>
}
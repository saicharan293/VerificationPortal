@model VerificationPortal.Models.CollegeMappingCreateViewModel
@{
    ViewData["Title"] = "Assign Colleges";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        /* Validation summary - hidden by default, shown via JS if needed */
        .validation-summary-hidden {
            display: none;
        }
    </style>
}

<section class="admin-page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1><i class="bi bi-plus-circle-fill"></i> Assign Colleges to User</h1>
                <p>Select a user, faculty, filter by college name range, and assign colleges</p>
            </div>
            <a asp-action="Index" class="btn btn-light btn-sm">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>
</section>

<section class="container my-4">
    <div class="admin-form-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" id="validationSummary"></div>

            <div class="row g-3">
                <!-- Faculty Selection -->
                <div class="col-md-6">
                    <label asp-for="SelectedFacultyId" class="form-label">Faculty <span class="text-danger">*</span></label>
                    <select asp-for="SelectedFacultyId" class="form-select" id="facultySelect">
                        <option value="0">-- Select Faculty --</option>
                        @foreach (var fac in Model.AvailableFaculties)
                        {
                            <option value="@fac.FacultyId">@fac.FacultyName</option>
                        }
                    </select>
                    <span asp-validation-for ="SelectedFacultyId" class="text-danger"></span>
                </div>

                <!-- User Selection -->
                <div class="col-md-6">
                    <label asp-for="SelectedUserId" class="form-label">User <span class="text-danger">*</span></label>
                    <select asp-for="SelectedUserId" class="form-select" id="userSelect" disabled>
                        <option value="0">-- Select Faculty First --</option>
                    </select>
                    <span asp-validation-for="SelectedUserId" class="text-danger"></span>
                </div>
                <div id="collegeMappingConfig"
                     data-colleges-url="@Url.Action("GetCollegesByFacultyId", "CollegeMapping")">
                </div>

                <!-- College Name Range Filters -->
                <div class="col-md-3">
                    <label asp-for="FromLetter" class="form-label">College Name From <span class="text-danger">*</span></label>
                    <select asp-for="FromLetter" class="form-select" id="collegeFromSelect">
                        @foreach (var letter in "ABCDEFGHIJKLMNOPQRSTUVWXYZ")
                        {
                            <option value="@letter">@letter</option>
                        }
                    </select>
                    <small class="form-text text-muted">Starting letter (A-Z)</small>
                </div>

                <div class="col-md-3">
                    <label asp-for="ToLetter" class="form-label">College Name To <span class="text-danger">*</span></label>
                    <select asp-for="ToLetter" class="form-select" id="collegeToSelect">
                        @foreach (var letter in "ABCDEFGHIJKLMNOPQRSTUVWXYZ")
                        {
                            <option value="@letter">@letter</option>
                        }
                    </select>
                    <small class="form-text text-muted">Ending letter (must be same or after From)</small>
                </div>

                <div class="col-md-6 d-flex align-items-end">
                    <button type="button" id="applyFilterBtn" class="btn btn-sm btn-outline-primary w-100">
                        <i class="bi bi-funnel"></i> Apply Filter
                    </button>
                    <small class="form-text text-muted ms-2">Filter colleges by first letter range (optional)</small>
                </div>

                <!-- Colleges Selection -->
                <div class="col-12">
                    <label class="form-label">Colleges * (Hold Ctrl/Cmd to select multiple)</label>
                    <select asp-for="SelectedCollegeCodes" multiple class="form-select"
                            id="collegeSelect" size="10" disabled>
                        <option value="" disabled>-- Select Faculty & User First --</option>
                    </select>
                    <div class="mt-2">
                        <button type="button" class="btn btn-sm btn-outline-primary" id="selectAllBtn" disabled>
                            <i class="bi bi-check-all"></i> Select All
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="clearAllBtn" disabled>
                            <i class="bi bi-x-lg"></i> Clear All
                        </button>
                        <span class="ms-3 small text-muted">
                            <span id="selectedCount">0</span> college(s) selected
                        </span>
                    </div>
                </div>
            </div>

            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <label asp-for="VerificationLevel" class="form-label">Verification Level</label>
                    <select asp-for="VerificationLevel" class="form-select">
                        <option value="">-- Select Level --</option>
                        @for (int i = 1; i <= 10; i++)
                        {
                            <option value="@i" @(Model.VerificationLevel == i ? "selected" : "")>@i</option>
                        }
                    </select>
                    <span asp-validation-for="VerificationLevel" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="NextVerificationLevel" class="form-label">Add Next Verification Level</label>
                    <input type="number" asp-for="NextVerificationLevel" class="form-control" placeholder="Enter next level number" />
                    <span asp-validation-for="NextVerificationLevel" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> Assign Colleges
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script src="~/js/college-mapping.js" asp-append-version="true"></script>
    <script id="allUsersData" type="application/json">
        @Html.Raw(Json.Serialize(Model.AvailableUsers.Select(u => new
        {
            id = u.Id,
            userId = u.UserId,
            name = u.UserName,
            designation = u.DesignationDescription,
            facultyId = u.Faculty
        })))
    </script>
}
